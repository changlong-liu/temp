using Mangrove.ClosedSource.MetricsVectorization.Statistics;
using System.Runtime.Serialization;    public static class HistogramOperations
    {
        /// <summary>
        /// Given a <paramref name="histogram"/>, create a new histogram such that for each key K, the value V is the
        /// difference between squares of the sum of values for all the keys up to K and
        /// the sum of values for all the keys strictly less than K.
        /// </summary>
        /// <remarks>
        /// The motivation for this operation is described in the
        /// <a href="https://mangrove-docs.azurewebsites.net/rfc/11-percentiles-variance.html">RFC for percentile variance</a>. 
        /// </remarks>
        public static ScopeMap<T, long?> SumOfSquaresDifferences<T>(ScopeMap<T, int?> histogram)
            where T : struct
        {
            if (histogram != null && histogram.Values.Any(val => val != null))
            {
                var newHistogram = new Dictionary<T, long?>();
                var sortedKeys = histogram.Keys.OrderBy(k => k);
                long prevSum = 0;

                foreach (var key in sortedKeys)
                {
                    var value = histogram[key];
                    if (value != null)
                    {
                        newHistogram[key] = value * value + 2 * value * prevSum;
                        prevSum += (long)value;
                    }
                    else
                    {
                        newHistogram[key] = value;
                    }
                }

                return new ScopeMap<T, long?>(newHistogram);
            }
            return null;
        }

        /// <summary>
        /// Given a <paramref name="histogram"/>, multiply all non-null values by the
        /// total sum of the values in the <paramref name="histogram"/>.
        /// </summary>
        /// <remarks>
        /// The motivation for this operation is described in the
        /// <a href="https://mangrove-docs.azurewebsites.net/rfc/11-percentiles-variance.html">RFC for percentile variance</a>. 
        /// </remarks>
        public static ScopeMap<T, long?> MultiplyBySumOfValues<T>(ScopeMap<T, int?> histogram)
            where T : struct
        {
            if (histogram != null && histogram.Values.Any(val => val != null))
            {
                var multiplier = GetSumOfValues(histogram);
                var newKeyValuePairs = histogram.Select(kv => new KeyValuePair<T,long?>(kv.Key, kv.Value * multiplier));

                return new ScopeMap<T, long?>(newKeyValuePairs);
            }
            return null;
        }

        /// <summary>
        /// Computes a specified percentile for a histogram.
        /// </summary>
        /// <remarks>
        /// <![CDATA[
        /// We use the following definition of a percentile: it's the smallest value in the list 
        /// such that no more than P percent of the data is strictly less than the value 
        /// and at least P percent of the data is less than or equal to that value.
        /// 
        /// A histogram is given by a ScopeMap<int,int?> object, with 
        /// keys representing bins and values representing counts. 
        /// The requested percentile value should be between 0 and 100.
        /// ]]>
        /// </remarks>
        public static T? GetPercentile<T>(ScopeMap<T, int?> histogram, double? percentile)
            where T : struct
        {
            if (percentile > 1)
            {
                percentile = percentile / 100;
            }

            return GetPercentileInternal(histogram, percentile);
        }

        public static T? GetPercentileWithBoundary<T>(ScopeMap<T, int?> histogram, double? percentile)
            where T : struct
        {
            percentile = ApplyBoundary(percentile);

            return GetPercentileInternal(histogram, percentile);
        }

        private static T? GetPercentileInternal<T>(ScopeMap<T, int?> histogram, double? percentile)
            where T : struct
        {
            if (histogram != null && histogram.Values.Any(val => val != null))
            {
                var sortedKeys = histogram.Keys.OrderBy(k => k);

                if (percentile <= 0)
                {
                    return sortedKeys.First(key => histogram[key] != null);
                }
                else if (percentile >= 1)
                {
                    return sortedKeys.Last(key => histogram[key] != null);
                }
                else
                {
                    var total = (long)histogram.Values.Select(v => (long?)v).Sum();

                    //this definition is used in Hypercube, so we use it as well for parity
                    var goal = Math.Ceiling((percentile ?? 0) * total + 1e-8);
                    long sum = 0;

                    foreach (var key in sortedKeys)
                    {
                        if (histogram[key] == null)
                        {
                            continue;
                        }

                        sum += (long)histogram[key];

                        if (sum >= goal)
                        {
                            return key;
                        }
                    }
                }
            }

            return null;
        }

        private static double? ApplyBoundary(double? percentile)
        {
            if (!percentile.HasValue)
            {
                return percentile;
            }

            var value = percentile.Value;

            if (value < 0)
            {
                return 0;
            }

            if (value > 1)
            {
                return 1;
            }

            return value;
        }

        /// <summary>
        /// Computes the sum of all the values in the <paramref name="histogram"/>. 
        /// </summary>
        /// <remarks>
        /// If all the values in the <paramref name="histogram"/> are null, returns 0.
        /// This is to be in agreement with .Sum() method in LINQ.
        /// </remarks>
        public static long GetSumOfValues<T>(ScopeMap<T, int?> histogram)
            where T : struct
        {
            if (histogram != null && histogram.Values.Any(val => val != null))
            {
                return histogram.Values.Select(v => (long?)v).Sum() ?? 0;
            }
            return 0;
        }

        /// <summary>
        /// Computes the sum of all the values in the <paramref name="histogram"/> for the keys
        /// less than or equal to <paramref name="value"/>. 
        /// </summary>
        /// <remarks>
        /// If all the values in the <paramref name="histogram"/> are null
        /// or if the <paramref name="value"/> is null, returns 0.
        /// </remarks>
        public static long GetSumOfValuesUpTo(ScopeMap<int, int?> histogram, long? value)
        {
            if (histogram != null && value != null && histogram.Values.Any(val => val != null))
            {
                return histogram.Where(kv => kv.Key <= value).Select(kv => (long?)kv.Value).Sum() ?? 0;
            }
            return 0;
        }

        /// <summary>
        /// Computes the sum of all the values in the <paramref name="histogram"/> for the keys
        /// less than or equal to <paramref name="value"/>. 
        /// </summary>
        /// <remarks>
        /// If all the values in the <paramref name="histogram"/> are null
        /// or if the <paramref name="value"/> is null, returns 0.
        /// </remarks>
        public static long GetSumOfValuesUpTo(ScopeMap<int, long?> histogram, long? value)
        {
            if (histogram != null && value != null && histogram.Values.Any(val => val != null))
            {
                return histogram.Where(kv => kv.Key <= value).Select(kv => (long?)kv.Value).Sum() ?? 0;
            }
            return 0;
        }

        public static string PrintHistogram<T>(ScopeMap<T, int?> histogram)
        {
            if (histogram != null && histogram.Values.Any(val => val != null))
            {
                return string.Join(", ", histogram.OrderBy(kv => kv.Key).Select(kv => kv.Key.ToString() + " : " + kv.Value));
            }
            return "";
        }
    }
