    /// <summary>
    /// Some native Mangrove operations have no "safe" C# equivalents, i.e. inline
    /// C# code which returns null instead of throwing an exception when bad input
    /// is provided. This class is a wrapper for any safe implementations, e.g.
    /// DateTime parsing.
    /// </summary>
    /// <remarks>
    /// By https://stackoverflow.com/a/11643364 and https://stackoverflow.com/a/51364906 ,
    /// an "if / else" statement, ternary operator, and null coalesce all have the same
    /// performance. So which one to use will be chosen based on ease of readability.
    /// </remarks>
    public static class MangroveInlineOperations
    {
        public static double? AbsoluteValue(double? d)
        {
            return d == null ? (double?)null : Math.Abs((double)d);
        }

        public static double? SquareRoot(double? d)
        {
            return d == null ? (double?)null : Math.Sqrt((double)d);
        }

        public static DateTime? StringToDatetime(string date, string format)
        {
            DateTime result;
            if (DateTime.TryParseExact(date, format, null, DateTimeStyles.AllowWhiteSpaces, out result))
            {
                return result;
            }

            return null;
        }

        public static DateTime StringToNonNullableDatetime(string date, string format)
        {
            return DateTime.ParseExact(date, format, null, DateTimeStyles.AllowWhiteSpaces);
        }

        public static DateTime? ParseDatetime(string date)
        {
            DateTime dateTime;
            DateTimeOffset dateTimeOffset = DateTimeOffset.MinValue;
            if (DateTimeOffset.TryParse(date, out dateTimeOffset))
            {
                return dateTimeOffset.DateTime;
            }
            else if (DateTime.TryParse(date, null, DateTimeStyles.AssumeUniversal | DateTimeStyles.AllowWhiteSpaces, out dateTime))
            {
                return dateTime;
            }

            return null;
        }

        public static DateTime ParseNonNullableDatetime(string date)
        {
            DateTime dateTime;
            DateTimeOffset dateTimeOffset = DateTimeOffset.MinValue;
            if (DateTimeOffset.TryParse(date, out dateTimeOffset))
            {
                dateTime = dateTimeOffset.DateTime;
            }
            else
            {
                dateTime = DateTimeOffset.Parse(date, null, DateTimeStyles.AssumeUniversal | DateTimeStyles.AllowWhiteSpaces).DateTime;
            }

            return dateTime;
        }

        public static double? Ceiling(double? d)
        {
            return d == null ? (double?)null : Math.Ceiling((double)d);
        }

        /// <summary>
        /// Need this separate method for non-nullable type
        /// Because the caller may cast null to non-nullable type
        /// e.g. int i = (int)ParseNonNullableType<int>("null");
        /// </summary>
        /// <typeparam name="T">Types that to convert from the string value</typeparam>
        /// <param name="value">string value to parse</param>
        /// <returns>Parsed value</returns>
        public static T ParseNonNullableType<T>(string value)
        {
            return (T)TypeDescriptor.GetConverter(typeof(T)).ConvertFrom(value);
        }

        public static Nullable<T> ParseNullableType<T>(string value)
            where T : struct
        {
            try
            {
                return ParseNonNullableType<T>(value);
            }
            catch
            {
                return null;
            }
        }
    }
    /// <summary>
    /// Unpivot a rowset from "wide" to "long" by creating 1 row per metric per incoming row.
    /// Assumptions: all dimension columns appear in the rowset, and 'FLIGHT' is a dimension.
    /// </summary>
    /// <remarks>
    /// Specification of xCard data loader input format:
    /// https://microsoft.sharepoint.com/:w:/t/AnalysisandExperimentation/EfRFejIVAsZAv1iXQUT6DJQBO55ScGan2oLQIm0jLhxEZQ?e=gVJLkI .
    ///
    /// Assume a rowset like
    ///
    /// <code>
    /// FLIGHT,..., dimD, metric1, metric1_StdDev, metric1_N, metric2, metric2_StdDev, metric2_N, ...
    /// </code>
    ///
    /// This transforms to a new rowset with is consumable by the xCard data loader.
    /// Each triad of mean/var/N for a metric is converted to a collection of rows, one for
    /// each combination of segment name + segment value across the segment groups. This code is
    /// heavily inspired by the implementations of AddHeaderReducerV2 and
    /// MetricsUnPivotProcessorV2 in the repository:
    /// https://dev.azure.com/experimentation/Analysis%20and%20Experimentation/_git/AnE.ExP.ScorecardPipeline .
    /// </remarks>
    public class UnpivotMetrics : Reducer
    {
        /// <summary>
        /// xCard cannot support only one segment level: it must have a
        /// primary and secondary segment. We will use this to "pad" the segments
        /// if they are missing, e.g. no segments at all, or just primary segment.
        /// </summary>
        public const int MIN_REQUIRED_SEGMENT_DEPTH = 2;
        private const string NONE = "**NONE**";

        public const string DUMMY_METADATA = "#{\"ForayVersion\":\"MangroveDummyVersion\",\"MetricSetVersion\":\"MangroveMetricSet\",\"ForayCompilerVersion\":\"MangroveCompiler\",\"ForayOutputVersion\":\"2.0\"}";

        public const string SEGMENT_NAME = "Segment_Name_";
        public const string SEGMENT_TYPE = "Segment_Type_";
        public const string SEGMENT_VALUE = "Segment_Value_";

        private const string AVERAGE = "Avg";
        private const string COUNT = "SampleSize";
        private const string DATA_TYPE = "DataType";
        private const string DIMENSION_SET = "DimensionSet";
        private const string FLIGHT = "Flight";
        private const string FLIGHT_UPPER = "FLIGHT";
        private const string METRIC = "Metric";
        private const string NUMBERLINE = "Numberline";
        private const string STANDARD_DEVIATION = "StdDev";
        private const string STANDARD_SEGMENT = "Standard";
        private const string USER_DEFINED_TYPE = "UserDefinedType";
        private const string VALID_FOR_SEGMENT = "ValidForSegment";

        private readonly IReadOnlyList<IReadOnlyList<string>> _segmentGroups;
        private readonly IReadOnlyDictionary<string, string> _metricNameToLevel;

        private readonly string _avgSuffix;
        private readonly string _varianceSuffix;
        private readonly string _nSuffix;

        /// <summary>
        /// A unique delimiter string, copied from the StaticParser. It is used
        /// by the compiler to rename multi-level metrics. We have copied it over
        /// instead of adding a dependency on the Parsing project to avoid
        /// issues with the targeted frameworks.
        /// </summary>
        public static string MAGIC_DELIMITER = "_f80ea57d_1c53_436b_ae74_d3f8d88ae6e8_";

        private static string[] Delimiters = new string[] { MAGIC_DELIMITER };

        /// <summary>
        /// This is an ugly hack required by xCard which has hard-coded assumption that
        /// the lowest aggregation level has dimension "FLIGHT" (for no real conceptual reason).
        /// Unfortunately, <see cref="UnpivotMetrics"/> does not have the information about
        /// the ordering of levels. As a result, we are making another hard-coding that
        /// lowest level of aggregation = "IG". This is true for all metric sets produced by MDL Core.
        /// </summary>
        private static Func<string, string> AdjustDimensionName = s => s == "IG" ? "FLIGHT" : s;

        public UnpivotMetrics(string segmentGroups,
            string metricsDimensionSets,
            char outerSeparator = ';',
            char innerSeparator = ':',
            string avgSuffix = "",
            string varianceSuffix = "_StdDev",
            string nSuffix = "_N")
        {
            var segmentGroupsList = segmentGroups.Split(outerSeparator)
                .Select(s => s.Split(innerSeparator))
                .ToList();

            // Validate input.
            if (segmentGroupsList.All(NotFlightSegmentGroup))
            {
                throw new ArgumentException("Cannot run the UnpivotMetrics processor unless it has a segment group consisting of FLIGHT only.");
            }

            _segmentGroups = segmentGroupsList
                .Where(NotFlightSegmentGroup)
                .ToList();

            _metricNameToLevel = metricsDimensionSets.Split(outerSeparator)
                .Select(s => s.Split(innerSeparator))
                .ToDictionary(arr => arr[0], arr => AdjustDimensionName(arr[1]));

            _avgSuffix = avgSuffix;
            _varianceSuffix = varianceSuffix;
            _nSuffix = nSuffix;
        }

        public override Schema Produces(string[] _, string[] __, Schema ___)
        {
            var schema = new Schema();

            AddColumn(schema, FLIGHT);
            AddColumn(schema, NUMBERLINE);
            AddColumn(schema, DIMENSION_SET);

            var segmentDepth = Math.Max(_segmentGroups.Count, MIN_REQUIRED_SEGMENT_DEPTH);
            for (var i = 0; i < segmentDepth; ++i)
            {
                AddColumn(schema, SEGMENT_TYPE + (i + 1));
                AddColumn(schema, SEGMENT_NAME + (i + 1));
                AddColumn(schema, SEGMENT_VALUE + (i + 1));
            }

            AddColumn(schema, METRIC);
            AddColumn(schema, DATA_TYPE);
            AddColumn(schema, VALID_FOR_SEGMENT);
            AddColumn(schema, AVERAGE);
            AddColumn(schema, COUNT);
            AddColumn(schema, STANDARD_DEVIATION);
            AddColumn(schema, USER_DEFINED_TYPE);

            return schema;
        }

        public override IEnumerable<Row> Reduce(RowSet input, Row outputRow, string[] _)
        {
            // Specify some version numbers.
            outputRow.Reset();
            outputRow[0].UnsafeSet(DUMMY_METADATA);
            yield return outputRow;

            // Explicitly add schema header.
            outputRow.Reset();
            for (var i = 0; i < outputRow.Schema.Count; ++i)
            {
                outputRow[i].UnsafeSet(outputRow.Schema[i].Name);
            }
            yield return outputRow;

            foreach (var row in input.Rows)
            {
                foreach (var kvp in _metricNameToLevel)
                {
                    outputRow.Reset();
                    for (var i = 0; i < _segmentGroups.Count; ++i)
                    {
                        outputRow[SEGMENT_TYPE + (i + 1)].Set(STANDARD_SEGMENT);

                        //decide which segment to pick
                        var segmentNameToValue = _segmentGroups[i]
                            .ToDictionary(name => name, name => row[name].String);
                        if (segmentNameToValue.Values.All(v => v == NONE))
                        {
                            outputRow[SEGMENT_NAME + (i + 1)].Set(NONE);
                            outputRow[SEGMENT_VALUE + (i + 1)].Set(NONE);
                        }
                        else
                        {
                            var segmentNames = segmentNameToValue
                                .Where(kv => kv.Value != NONE)
                                .Select(kv => kv.Key);
                            if (segmentNames.Count() != 1)
                            {
                                throw new NotSupportedException("xCard assumes that there is a unique non-aggregated segment values within each segment group.");
                            }
                            var segmentName = segmentNames.Single();

                            outputRow[SEGMENT_NAME + (i + 1)].Set(segmentName);
                            row[segmentName].CopyTo(outputRow[SEGMENT_VALUE + (i + 1)]);
                        }
                    }
                    for (int i = _segmentGroups.Count + 1; i <= MIN_REQUIRED_SEGMENT_DEPTH; i++)
                    {
                        outputRow[SEGMENT_VALUE + i].Set(NONE);
                        outputRow[SEGMENT_NAME + i].Set(NONE);
                        outputRow[SEGMENT_TYPE + i].Set(STANDARD_SEGMENT); // not really used by xCard
                    }

                    string avgName = "";
                    string varName = "";
                    string nName = "";
                    string metricName = "";
                    GetStatisticsNames(kvp.Key, out metricName, out avgName, out varName, out nName);
                    row[FLIGHT_UPPER].CopyTo(outputRow[FLIGHT]);
                    outputRow[NUMBERLINE].Set("NotUsedByAllocationId");
                    outputRow[DIMENSION_SET].Set(kvp.Value);
                    outputRow[METRIC].Set(metricName);
                    outputRow[DATA_TYPE].Set(typeof(double).ToString());
                    outputRow[VALID_FOR_SEGMENT].Set(1);
                    outputRow[AVERAGE].Set(Format(ZeroIfNaNOrInfinity(row[avgName].Double)));
                    outputRow[COUNT].Set(row[nName].Double);
                    outputRow[STANDARD_DEVIATION].Set(Format(ZeroIfNaNOrInfinity(row[varName].Double)));

                    yield return outputRow;
                }
            }
        }

        private ColumnInfo AddColumn(Schema schema, string name)
        {
            var result = new ColumnInfo(name, ColumnDataType.String);
            schema.Add(result);
            return result;
        }

        private void GetStatisticsNames(string baseName, out string metricName, out string avgName, out string varName, out string nName)
        {
            avgName = baseName + _avgSuffix;
            varName = baseName + _varianceSuffix;
            nName = baseName + _nSuffix;

            metricName = baseName
                .Split(Delimiters, StringSplitOptions.None)
                .First();
        }

        private static string Format(double d)
        {
            // Needed because C# cannot parse a double.MaxValue when has been naively
            // "to-stringed". See https://stackoverflow.com/q/766918 for some context.
            return d.ToString("R");
        }

        private static bool NotFlightSegmentGroup(string[] segments)
        {
            return segments.Length != 1 || segments[0] != FLIGHT_UPPER;
        }

        /// <summary>
        /// This is needed due to xCard not supporting <see cref="double.NaN"/>
        /// or <see cref="double.NegativeInfinity"/> or <see cref="double.PositiveInfinity"/>
        /// values. By convention, they get replaced with 0. See, for example
        /// https://experimentation.visualstudio.com/DefaultCollection/Analysis%20and%20Experimentation/_git/AnE.ExP.ScorecardPipeline?path=%2Fprivate%2FForay%2FForay.MetricsVectorization%2FStatistics%2FStatsLib.cs.
        ///
        /// TODO: This is a potential trustworhiness issue, since it can mask data issues
        /// as well as adds confusion with the actual value of 0. This behavior to be reconsidered.
        /// </summary>
        private static double ZeroIfNaNOrInfinity(double x)
        {
            return double.IsNaN(x)
                || double.IsInfinity(x) ? 0 : x;
        }
    }

    /// <summary>
    /// The AddHeaderReducer is used to generate the header row in a scope output file, as a workaround
    /// to the problem that scope outputter can't generate the header row when running in cluster.
    /// This reducer injects a row containing the column names to the output .txt file
    /// </summary>
    public class AddHeaderReducerV2 : ScopeRuntime.Reducer
    {
        private IDictionary<string, string> _columnMap;
        public const string AddHeaderReducerName = "AddHeaderReducerV2";

        // A JSON string for the ForayScriptMetadata object added 
        // to the output. 
        private string ForayScriptMetadataString;

        // Prefix string to add to any comments added in the output
        private const string CommentPrefix = "#";

        public const string MapColumnOption = "-mapcolumn";
        public const string ForayMetaDataStringOption = "-forayscript_metadata";

        #region Constructor
        public AddHeaderReducerV2()
        {
            _columnMap = new Dictionary<string, string>();
        }
        #endregion

        public override Schema GetOutputSchemaAtCompileTime(string[] requestedColumns, string[] args,
                                                            Schema upstreamSchema)
        {
            Schema newSchema = new Schema();
            this.ParseArgs(args);
            // get rid of the 1st column (a const), make all other columns of string type

            for (int i = 0; i < upstreamSchema.Count; ++i)
            {
                newSchema.Add(new ColumnInfo(upstreamSchema[i].Name, ColumnDataType.String));
            }

            return newSchema;
        }

        public override IEnumerable<Row> Reduce(RowSet input, Row outputRow, string[] args)
        {
            // Parsing args at runtime. 
            // Since compile time parse did not throw exception, this shouldn't either
            this.ParseArgs(args);
            // generate Foray version string
            outputRow.Reset();
            outputRow[0].UnsafeSet(ForayScriptMetadataString);
            for (int i = 1; i < outputRow.Schema.Count; ++i)
            {
                outputRow[i].UnsafeSet("");
            }
            yield return outputRow;

            // The AddHeaderReducer adds Headers for the columns. 
            // The first yields in the function return the header rows, 
            // after which the data is returned as is row by row

            // generate the header row
            outputRow.Reset();
            for (int i = 0; i < outputRow.Schema.Count; ++i)
            {
                var outputColumnName = outputRow.Schema[i].Name;
                var headerColumnName = _columnMap.ContainsKey(outputColumnName) ? _columnMap[outputColumnName] : outputColumnName;
                outputRow[i].UnsafeSet(headerColumnName);
            }
            yield return outputRow;

            foreach (Row row in input.Rows)
            {
                outputRow.Reset();
                for (int i = 0; i < row.Count; ++i)
                {
                    outputRow[i].UnsafeSet(row[i].String);
                }
                yield return outputRow;
            }
        }

        #region Private methods
        /// <summary>
        /// Parse the parameters passed into the process.
        /// </summary>
        /// <param name="args">Array of parameters.</param>
        /// 
        private void ParseArgs(string[] args)
        {
            int argsLength = args != null ? args.Length : 0;
            for (int i = 0; i < argsLength; ++i)
            {
                switch (args[i].ToLower())
                {
                    case MapColumnOption:
                        if (i + 2 < argsLength)
                        {
                            var source = args[++i].Trim();
                            var target = args[++i].Trim();
                            _columnMap.Add(source, target);
                        }
                        else
                        {
                            throw new Exception(MapColumnOption + " needs 2 argument");
                        }
                        break;
                    case ForayMetaDataStringOption:
                        if (i + 1 < argsLength && !args[i + 1].StartsWith("-"))
                        {
                            // Remove any new lines from the args otherwise the output will have
                            // multiple rows for the script metadata and that will break things.
                            ForayScriptMetadataString = CommentPrefix + args[++i].Replace('\n', ' ').Replace('\r', ' ');
                        }
                        else
                        {
                            throw new Exception(ForayMetaDataStringOption + " needs an argument");
                        }
                        break;
                    default:
                        throw new Exception("unknown parameter: " + args[i]);
                }
            }
        }
        #endregion

    }
    /// <summary>
    /// Partition by RAWMUID and FLIGHT dimensions
    /// </summary>
    /// <remarks>
    /// The reason this reducer is named DoNothingReducer is that it does not transform the data in the scope rows
    /// </remarks>>
    public class DoNothingReducer : ScopeRuntime.Reducer
    {
        public override bool AllowColumnPruning { get { return true; } }
        public override bool IsRecursive { get { return true; } }
        public override bool RunSingleThreaded { get { return false; } }

        public override Schema GetOutputSchemaAtCompileTime(string[] requestedColumns, string[] args,
                                                            Schema upstreamSchema)
        {
            return upstreamSchema.CloneWithSource();
        }

        public override IEnumerable<Row> Reduce(RowSet input, Row outputRow, string[] args)
        {
            foreach (Row row in input.Rows)
            {
                outputRow = row.Clone();
                yield return outputRow;
            }
        }
    }
    public class HistogramFinalizeProcessor : ScopeRuntime.Processor
    {
        public override bool AllowColumnPruning { get { return false; } }
        public override bool RunSingleThreaded { get { return true; } }
        public override bool RowLevelProcessor { get { return true; } }

        //private const string MetricsColumnName = SystemSettings.CompactedMetricsBagColumnName;
        private const string MetricsColumnName = "Metrics"; // TODO: using the configuration to correct the compacted metrics bag column name
        private IMetricsDefinitionsWrapper MetricsDefinitionsWrapper { get { return MetricsVectorizationActivator.GetMetricsDefinitionsWrapperObject(); } }

        public override Schema Produces(string[] requestedColumns, string[] args, Schema input)
        {
            return input.CloneWithSource();
        }

        private static ConcurrentBag<MetricBag> _flightMetricBagPool = new ConcurrentBag<MetricBag>();


        public override IEnumerable<Row> Process(RowSet input, Row outputRow, string[] args)
        {
            var inputSchema = input.Schema;
            int metricsColIndex = inputSchema[MetricsColumnName];

            foreach (var inputRow in input.Rows)
            {
                outputRow.Reset();
                for (int i = 0; i < inputSchema.Count; ++i)
                {
                    if (i != metricsColIndex)
                    {
                        // Copy over the non-Metric columns.
                        inputRow[i].CopyTo(outputRow[i]);
                    }
                    else
                    {
                        MetricBag aggBag;
                        if (!_flightMetricBagPool.TryTake(out aggBag))
                        {
                            //aggBag = new MetricBag(MetricsDefinitionsWrapper, SystemSettings.FLIGHT);
                            aggBag = new MetricBag(MetricsDefinitionsWrapper, "FLIGHT"); //TODO: using the configuration to correct the FLIGHT name
                        }

                        aggBag.Deserialize(inputRow[i].Binary);
                        aggBag.FinalizeHistogram();
                        outputRow[i].Set(aggBag.Serialize());
                        _flightMetricBagPool.Add(aggBag);
                    }
                }
                yield return outputRow;
            }
        }
    }
    public class MVAggregateProcessor : Processor
    {

        private const string MetricsColumn = "Metrics"; // TODO: using configuration for the CompactedMEtricsBagColumnName

        public override bool AllowColumnPruning { get { return true; } }
        public override bool RunSingleThreaded { get { return true; } }
        public override bool RowLevelProcessor { get { return false; } }

        public readonly IMetricsDefinitionsWrapper MetricsDefinitionWrapper;

        // Store the SegmentName/Values in a hash set, with an integer to represent them
        // Makes it faster to compare and store segment name combinations
        private StringStore SegmentValuesStore = new StringStore();
        private StringStore SegmentNamesStore = new StringStore();

        // The number of segment levels for this job, is provided as in input arg to MVAggregateProcessor.
        private int MaxSegmentLevels;

        // Queue to store metric bags for each rollup dimension, so that we don't have to keep reallocating objects
        // over and over again. 
        // Note that the this processor is run in a single thread and hence a queue works, otherwise, use
        // ConcurrentQueue
        private Dictionary<string, Queue<MetricBag>> MetricBagPool = new Dictionary<string, Queue<MetricBag>>();

        // We store all objects required for intermediate dimensions as Lists(instead of dictionaries) to save space and perf
        // This dictionary stores the rollup dimension name => index in the List for object corresponding to the 
        // rollup dimension
        private readonly Dictionary<string, int> NonBaseRollupDimensionIndex;

        // stores a map between source dimension and list of target dimensions to aggregate to.
        private readonly Dictionary<string, HashSet<string>> AggregationRollupMapString;

        //Ordered list of rollup dimensions, (note: partially ordered dimensions are arbitrarily ordered in this list). 
        private readonly List<string> OrderedRollupDimensions;

        // We only support one output dimension for now. This can be generalized later to 
        // be a tuple of strings(objects). 
        private readonly string OutputDimension;

        // The dimension just below OutputDimension is considered the ExperimentUnit dimension
        // for this processor.
        private readonly string ExperimentUnitDimension;

        private MetricBag GetMetricBag(string rollupDimension)
        {
            MetricBag rv;
            Queue<MetricBag> queueForDimension;
            if (!MetricBagPool.TryGetValue(rollupDimension, out queueForDimension))
            {
                queueForDimension = new Queue<MetricBag>();
                MetricBagPool[rollupDimension] = queueForDimension;
            }

            if (queueForDimension.Count == 0)
            {
                rv = new MetricBag(MetricsDefinitionWrapper, rollupDimension);
            }
            else
            {
                rv = queueForDimension.Dequeue();
                rv.Reset();
            }
            return rv;
        }

        private void RecycleMetricBag(MetricBag bag)
        {
            Queue<MetricBag> queueForDimension;
            if (!MetricBagPool.TryGetValue(bag.RollupDimension, out queueForDimension))
            {
                queueForDimension = new Queue<MetricBag>();
                MetricBagPool[bag.RollupDimension] = queueForDimension;
            }
            queueForDimension.Enqueue(bag);
        }

        public MVAggregateProcessor()
        {
            MetricsDefinitionWrapper = MetricsVectorizationActivator.GetMetricsDefinitionsWrapperObject();
            OrderedRollupDimensions = MetricsDefinitionWrapper.GetOrderedRollupDimensionsList();
            NonBaseRollupDimensionIndex = new Dictionary<string, int>();
            AggregationRollupMapString = new Dictionary<string, HashSet<string>>();
            var rollupDimensionsCount = OrderedRollupDimensions.Count;
            if (rollupDimensionsCount < 2)
            {
                // throw new Exception($"{nameof(MVAggregateProcessor)} called with less than two rollup dimensions. There's nothing to aggregate!");
                throw new Exception("MVAggregateProcessor called with less than two rollup dimensions. There's nothing to aggregate!");
            }


            OutputDimension = OrderedRollupDimensions[rollupDimensionsCount - 1]; // Last value in the list is considered the output dimension
            ExperimentUnitDimension = OrderedRollupDimensions[rollupDimensionsCount - 2];

            for (int i = 1; i < rollupDimensionsCount; i++)
            {
                NonBaseRollupDimensionIndex[OrderedRollupDimensions[i]] = i - 1;
            }

            foreach (var rollupPair in MetricsDefinitionWrapper.GetSourceTargetAggregationLevelPairs())
            {
                var sourceDimension = rollupPair.Key;
                var targetDimension = rollupPair.Value;
                HashSet<string> targetRollupSet;
                if (AggregationRollupMapString.TryGetValue(sourceDimension, out targetRollupSet))
                {
                    targetRollupSet.Add(targetDimension);
                }
                else
                {
                    AggregationRollupMapString[sourceDimension] = new HashSet<string> { targetDimension };
                }

                if (!NonBaseRollupDimensionIndex.ContainsKey(targetDimension))
                {
                    throw new Exception(String.Format("Foray internal error: {0} is missing from the OrderedRollupDimensions list.", targetDimension));
                }
            }
        }

        private void Parse(string[] args, Schema inputSchema)
        {
            if (args.Length != 1)
            {
                throw new Exception("Foray internal error: MVAggregateProcessor should be called with one argument: Max Segmentlevels");
            }

            if (!int.TryParse(args[0], out MaxSegmentLevels))
            {
                throw new ArgumentException("Foray internal error: MaxSegmentLevels passed to MVAggregateProcessor is not an integer");
            }

            //Check that the input schema has all but the first orderedRollupDimension (we don't  need IG)
            var missingDimensions = new List<string>();
            foreach (var dim in OrderedRollupDimensions.Skip(1))
            {
                if (!inputSchema.Contains(dim))
                {
                    missingDimensions.Add(dim);
                }
            }

            if (missingDimensions.Count() != 0)
            {
                //throw new Exception($"Foray internal error: Rollup dimension(s) {string.Join(", ", missingDimensions)} not found in the list of dimension columns passed to {nameof(MVAggregateProcessor)}");
                throw new Exception(String.Format("Foray internal error: Rollup dimension(s) {0} not found in the list of dimension columns passed to {1}", string.Join(", ", missingDimensions), "MVAggregateProcessor"));
            }
        }

        public override Schema Produces(string[] columns, string[] args, Schema input)
        {
            var schema = new Schema();
            Parse(args, input);

            // Output schema of MVAggregateProcessor should only contain flight and segment values
            // and the aggregated flight bag ("metrics" column)
            schema.Add(new ColumnInfo(OutputDimension, ColumnDataType.String));
            for (int i = 1; i <= MaxSegmentLevels; i++)
            {
                //schema.Add(new ColumnInfo(SystemSettings.GetSegmentNameColumn(i), ColumnDataType.String));
                //schema.Add(new ColumnInfo(SystemSettings.GetSegmentValueColumn(i), ColumnDataType.String));
                schema.Add(new ColumnInfo("Segment_Name_" + i.ToString(), ColumnDataType.String));
                schema.Add(new ColumnInfo("Segment_Value_" + i.ToString(), ColumnDataType.String)); // TODO: using the configuration for the GetSegmentNameColumn and GetSegmentValueColumn
            }
            schema.Add(new ColumnInfo(MetricsColumn, ColumnDataType.Binary));
            return schema;
        }

        Row ToOutputRow(Row outputRow, KeyValuePair<AggregateOutputKey, byte[]> result)
        {
            outputRow.Reset();
            var dimensions = result.Key;

            outputRow[OutputDimension].Set(dimensions.OutputDimension);
            for (int i = 0; i < dimensions.SegmentInfo.Length; i++)
            {
                //outputRow[SystemSettings.GetSegmentNameColumn(i + 1)].Set(dimensions.SegmentInfo[i].SegmentName);
                //outputRow[SystemSettings.GetSegmentValueColumn(i + 1)].Set(dimensions.SegmentInfo[i].SegmentValue);
                outputRow["Segment_Name_" + (i + 1).ToString()].Set(dimensions.SegmentInfo[i].SegmentName);
                outputRow["Segment_Value_" + (i + 1).ToString()].Set(dimensions.SegmentInfo[i].SegmentValue); // TODO: using the configuration for the GetSegmentNameColumn and GetSegmentValueColumn

            }
            outputRow[MetricsColumn].Set(result.Value);
            return outputRow;
        }

        private BaseLevelRow BuildBaseLevelRow(Row row)
        {
            var rollupDimValues = new List<string>();
            var baseLevelDimension = OrderedRollupDimensions[0];
            MetricBag mBag = GetMetricBag(baseLevelDimension);

            // We know that the BaseLevel Metricbag has just one AggregationBag with source and destination dimensions as base.
            var inputAggregationBag = mBag.sourceAggregationBags[0];
            inputAggregationBag.Deserialize(row[MetricsColumn].Binary);

            foreach (var intRollupDim in OrderedRollupDimensions.Skip(1))
            {
                // Key is the intermediate rollup dimension, value is the index of objects for this rollup dim.
                rollupDimValues.Add(row[intRollupDim].String);
            }

            return new BaseLevelRow
            {
                RollupDimensionValues = rollupDimValues,
                BaseLevelMetricBag = mBag
            };
        }

        private List<OptimizedSegmentsKey> ComputeSegmentCombinations(List<KeyValuePair<int, SegmentNameValuePair>> segmentValuesForRollup)
        {
            var segmentByLevel = new Dictionary<int, List<Tuple<int, int>>>();
            int maxLevel = 0;
            foreach (var segmentData in segmentValuesForRollup)
            {
                var segmentLevel = segmentData.Key;
                var segmentName = segmentData.Value.SegmentName;
                var segmentValue = segmentData.Value.SegmentValue;
                List<Tuple<int, int>> segmentNameValuesForLevel;
                if (!segmentByLevel.TryGetValue(segmentLevel, out segmentNameValuesForLevel))
                {
                    segmentNameValuesForLevel = new List<Tuple<int, int>>();
                    segmentByLevel[segmentLevel] = segmentNameValuesForLevel;
                }

                var segmentNameInt = SegmentNamesStore.GetIndexInStore(segmentName);
                var segmentValueInt = SegmentValuesStore.GetIndexInStore(segmentValue);

                segmentNameValuesForLevel.Add(new Tuple<int, int>(segmentNameInt, segmentValueInt));

                if (segmentLevel > maxLevel)
                {
                    maxLevel = segmentLevel;
                }
            }

            // Generate list of all possible combinations for the segment. 
            var combinations = new List<OptimizedSegmentsKey>();

            if (maxLevel == 0)
            {
                combinations.Add(new OptimizedSegmentsKey(maxLevel));
                return combinations;
            }

            // Add **NONE** **NONE** for any missing levels. 
            //var noneSegmentName = SegmentNamesStore.GetIndexInStore(SystemSettings.SEGMENT_NAME_NONE_VALUE);
            //var noneSegmentValue = SegmentValuesStore.GetIndexInStore(SystemSettings.SEGMENT_VALUE_NONE_VALUE);
            var noneSegmentName = SegmentNamesStore.GetIndexInStore("**NONE**");
            var noneSegmentValue = SegmentValuesStore.GetIndexInStore("**NONE**"); //TODO: using the cofiguration to correct the **NONE** value

            List<int> levelIdx = new List<int>();
            for (int i = 1; i <= maxLevel; i++)
            {
                if (!segmentByLevel.ContainsKey(i))
                {
                    segmentByLevel[i] = new List<Tuple<int, int>> { new Tuple<int, int>(noneSegmentName, noneSegmentValue) };
                }
                levelIdx.Add(0);
            }

            // levelIdx stores the index of the next segment to process for each level
            // The code below generates the cartesian product across multiple segment levels. 
            // On every iteration of the loop, it increments the index of the highest segment level. 
            // If the index overflows the number of segments at that level, it is reset to 0 and 
            // the index of the next highest level is incremented. 
            // e.g. for two segment levels and 2 first level segments and 2 second level segments:
            // Iteration 0: Level 1 index  = 0, Level 2 Index = 0
            // Iteration 1: Level 1 index  = 0, Level 2 Index = 1
            // Iteration 2: Level 1 index  = 1, Level 2 Index = 0
            // Iteration 3: Level 1 index  = 1, Level 2 Index = 1
            // Note there can be different number of segments per level.
            var exitLoop = false;
            while (!exitLoop)
            {
                var newCombination = new OptimizedSegmentsKey(maxLevel);
                for (int i = 0; i < maxLevel; i++)
                {
                    var level = i + 1; // level goes from 1 -> maxLevel, but i goes from 0 -> maxLevel-1
                    if (segmentByLevel[level].Count <= levelIdx[i])
                    {
                        throw new Exception("Foray internal error: Out of range index when expanding segments");
                    }
                    var name_value = segmentByLevel[level][levelIdx[i]];
                    newCombination.SegmentNames[i] = name_value.Item1;
                    newCombination.SegmentValues[i] = name_value.Item2;
                }
                combinations.Add(newCombination);

                // Advance indices
                for (int j = levelIdx.Count - 1; j >= 0; j--)
                {
                    var level = j + 1;
                    var numOfSegments = segmentByLevel[level].Count;
                    if (levelIdx[j] < numOfSegments - 1)
                    {
                        levelIdx[j]++;
                        break;
                    }
                    else if (j == 0)
                    {
                        exitLoop = true;
                        break;
                    }
                    else
                    {
                        // Reset index on overflow and move to the next lower level segment
                        levelIdx[j] = 0;
                    }
                }
            }
            return combinations;
        }

        private void UpdateOutputBag(Dictionary<AggregateOutputKey, MetricBag> outputBagStore, AggregateOutputKey key, AggregationBag outputAggregationBag)
        {
            MetricBag existingEntry;
            if (outputBagStore.TryGetValue(key, out existingEntry))
            //if (outputBagStore.TryGetValue(key, out MetricBag existingEntry))
            {
                existingEntry.AddAggregationBag(outputAggregationBag);
            }
            else
            {
                var newBag = GetMetricBag(OutputDimension);
                newBag.AddAggregationBag(outputAggregationBag);
                outputBagStore[key] = newBag;
            }
        }

        private void ExpUnitLevelAggregate(Dictionary<AggregateOutputKey, MetricBag> outputBagStore, IEnumerable<BaseLevelRow> rows)
        {
            // If there are no rows for this user, return early.
            if (rows == null)
            {
                return;
            }
            var rowEnumerator = rows.GetEnumerator();
            if (!rowEnumerator.MoveNext())
            {
                return;
            }

            var rollupMetricBags = new Dictionary<string, Dictionary<OptimizedSegmentsKey, MetricBag>>();
            var lastRollupDimValues = new Dictionary<string, string>();


            var currentRow = rowEnumerator.Current;
            foreach (var dimension in NonBaseRollupDimensionIndex.Keys)
            {
                rollupMetricBags[dimension] = new Dictionary<OptimizedSegmentsKey, MetricBag>();
                var idx = NonBaseRollupDimensionIndex[dimension];
                lastRollupDimValues[dimension] = currentRow.RollupDimensionValues[idx];
            }

            // Figure out the histogram bucket id based on current RAWMUID
            string outputDimValue = currentRow.RollupDimensionValues[NonBaseRollupDimensionIndex[OutputDimension]];
            var userLevelSegmentValues = new Dictionary<OptimizedSegmentsKey, List<KeyValuePair<int, SegmentNameValuePair>>>();

            do
            {
                currentRow = rowEnumerator.Current;
                foreach (var rollupDim in NonBaseRollupDimensionIndex.Keys)
                {
                    var idx = NonBaseRollupDimensionIndex[rollupDim];       // Index of the rollupdimension in the list
                    var value = lastRollupDimValues[rollupDim];             // Last value seen for this rollup dimension

                    if (value != currentRow.RollupDimensionValues[idx])
                    // If the value has changed, compute the metrics for that dimension, and reset bags for next dimension value. 
                    // (long term TODO: add segment computation support for intermediate levels here.)
                    {
                        if (AggregationRollupMapString.ContainsKey(rollupDim) && AggregationRollupMapString[rollupDim].Any()) // See which higher dimensions need these metrics
                        {
                            foreach (var destRollup in AggregationRollupMapString[rollupDim]) // List of all dimensions to rollup to
                            {
                                foreach (var segmentComb in rollupMetricBags[rollupDim].Keys)
                                {
                                    if (!rollupMetricBags[rollupDim][segmentComb].PassesFilter())
                                    {
                                        continue; // If the filter for this segment combination is not true,
                                                  // Do not aggregate this bag to the higher level.
                                    }
                                    if (rollupDim.Equals(ExperimentUnitDimension))
                                    {
                                        // if this is user level aggregation get the segment list of this base level segment combination
                                        userLevelSegmentValues[segmentComb] = rollupMetricBags[rollupDim][segmentComb].GetSegmentList().ToList();
                                    }
                                    if (!rollupMetricBags[destRollup].ContainsKey(segmentComb))
                                    {
                                        rollupMetricBags[destRollup][segmentComb] = GetMetricBag(destRollup);
                                    }
                                    var destinationMetricBag = rollupMetricBags[destRollup][segmentComb];
                                    var sourceMetricBag = rollupMetricBags[rollupDim][segmentComb];

                                    var nextLevelAggBag = sourceMetricBag.Reduce(destRollup);
                                    destinationMetricBag.AddAggregationBag(nextLevelAggBag);
                                }
                            }

                            // Cleanup the rollupMetricBag list for the current dimension. All the current values have been
                            // used and aggregated to the higher level
                            foreach (var segmentComb in rollupMetricBags[rollupDim].Keys)
                            {
                                RecycleMetricBag(rollupMetricBags[rollupDim][segmentComb]);
                            }
                            rollupMetricBags[rollupDim].Clear();
                        }
                    }
                }

                var baseLevelMetricBag = currentRow.BaseLevelMetricBag;
                if (baseLevelMetricBag == null)
                {
                    break; // the null MetricBag signifies end of a user data. 
                }

                var segmentCombinations = ComputeSegmentCombinations(baseLevelMetricBag.GetSegmentList().OrderBy(kv => kv.Key).ToList());

                // add the current row base level metrics to higher rollup metric bags (wherever applicable)
                var baseLevelDimension = OrderedRollupDimensions[0];
                foreach (var targetRollup in AggregationRollupMapString[baseLevelDimension]) // Add the base level metric bag to any higher dimensions it needs to be aggregated to.
                {
                    var baseTargetAggregationBag = baseLevelMetricBag.Reduce(targetRollup);
                    foreach (var segmentComb in segmentCombinations) // Add a separate entry for each segment combination possible.
                    {
                        if (!rollupMetricBags[targetRollup].ContainsKey(segmentComb))
                        {
                            rollupMetricBags[targetRollup][segmentComb] = GetMetricBag(targetRollup);
                        }
                        rollupMetricBags[targetRollup][segmentComb].AddAggregationBag(baseTargetAggregationBag);
                    }
                }

                //Add the metricBag back to the concurrent bag pool so that it can be reused. 
                RecycleMetricBag(baseLevelMetricBag);

                // Done with processing of this row, so move over the current rollup dimension values to the next. 
                foreach (var rollupDim in NonBaseRollupDimensionIndex.Keys)
                {
                    var idx = NonBaseRollupDimensionIndex[rollupDim];
                    lastRollupDimValues[rollupDim] = currentRow.RollupDimensionValues[idx];
                }

                if (outputDimValue == null)
                {
                    outputDimValue = currentRow.RollupDimensionValues[NonBaseRollupDimensionIndex[OutputDimension]];
                }
            } while (rowEnumerator.MoveNext());

            // Done with computing all aggregations for a user
            // Now for each of the user level segments, expand any **NONE** entries with the user level segment values
            var outputRollupIdx = NonBaseRollupDimensionIndex[OutputDimension];
            foreach (var segmentComb in rollupMetricBags[OutputDimension].Keys)
            {
                if (!userLevelSegmentValues.ContainsKey(segmentComb))
                {
                    continue;   // If this segment was filtered out, don't need to output anything
                }

                var flightMetricBag = rollupMetricBags[OutputDimension][segmentComb];

                // find if there are any none none entries to expand for this segment combination.
                var noneLevels = new HashSet<int>();
                //var noneSegmentName = SegmentNamesStore.GetIndexInStore(SystemSettings.SEGMENT_NAME_NONE_VALUE);
                //var noneSegmentValue = SegmentValuesStore.GetIndexInStore(SystemSettings.SEGMENT_VALUE_NONE_VALUE);
                var noneSegmentName = SegmentNamesStore.GetIndexInStore("**NONE**");
                var noneSegmentValue = SegmentValuesStore.GetIndexInStore("**NONE**"); //TODO: using configuration for SEGMENT_NAME_NONE_VALUE and SEGMENT_VALUE_NONE_VALUE
                for (int i = 0; i < segmentComb.SegmentNames.Length; i++)
                {
                    if (segmentComb.SegmentNames[i] == noneSegmentName && segmentComb.SegmentValues[i] == noneSegmentValue)
                    {
                        noneLevels.Add(i + 1); // level starts from 1, i from 0
                    }
                }

                var userLevelSegments = userLevelSegmentValues[segmentComb].Where(segEntry => noneLevels.Contains(segEntry.Key)).ToList();
                if (userLevelSegments.Any())
                {
                    var userLevelSegmentCombinations = ComputeSegmentCombinations(userLevelSegments);
                    foreach (var userSegmentCombination in userLevelSegmentCombinations)
                    {
                        var segmentKeyClone = new OptimizedSegmentsKey(Math.Max(userSegmentCombination.SegmentNames.Length, segmentComb.SegmentNames.Length));
                        Array.Copy(segmentComb.SegmentNames, segmentKeyClone.SegmentNames, segmentComb.SegmentNames.Length);
                        Array.Copy(segmentComb.SegmentValues, segmentKeyClone.SegmentValues, segmentComb.SegmentValues.Length);

                        // combine the base and user level segments
                        for (int i = 0; i < segmentKeyClone.SegmentNames.Length; i++)
                        {
                            if ((i >= segmentComb.SegmentNames.Length) // short circuit array overflow
                                ||
                                (segmentComb.SegmentNames[i] == noneSegmentName // if this an aggregate segment, replace with the user level values
                                    && segmentComb.SegmentValues[i] == noneSegmentValue
                                    && i < userSegmentCombination.SegmentNames.Length))
                            {
                                segmentKeyClone.SegmentNames[i] = userSegmentCombination.SegmentNames[i];
                                segmentKeyClone.SegmentValues[i] = userSegmentCombination.SegmentValues[i];
                            }
                        }
                        var key = GetAggregationOutputKeyFromSegmentInfo(outputDimValue, segmentKeyClone);
                        foreach (var sourceAggregationBag in flightMetricBag.sourceAggregationBags)
                        {
                            UpdateOutputBag(outputBagStore, key, sourceAggregationBag);
                        }
                    }
                }
                else
                {
                    var key = GetAggregationOutputKeyFromSegmentInfo(outputDimValue, segmentComb);
                    foreach (var sourceAggregationBag in flightMetricBag.sourceAggregationBags)
                    {
                        UpdateOutputBag(outputBagStore, key, sourceAggregationBag);
                    }
                }
            }

            foreach (var dimEntries in rollupMetricBags)
            {
                foreach (var seg in dimEntries.Value)
                {
                    RecycleMetricBag(seg.Value);
                }
            }
        }

        // Generates a AggregateOutputKey using the outputDimension and the segments combination. 
        // The segmentCombination stores integers for the segment names and values. This expands them
        // back to the string values.
        private AggregateOutputKey GetAggregationOutputKeyFromSegmentInfo(string outputDimension, OptimizedSegmentsKey segmentCombination)
        {
            var segmentNameValuePairs = new List<SegmentNameValuePair>();
            // Expected to have at least 2 segments levels in the output. When they don't, we inject **NONE** for the segment values and names.

            //var numSegmentLevels = Math.Max(2, segmentCombination.SegmentNames.Length);
            var numSegmentLevels = segmentCombination.SegmentNames.Length;

            for (int i = 0; i < numSegmentLevels; i++)
            {
                if (i < segmentCombination.SegmentNames.Length)
                {
                    var segmentName = SegmentNamesStore.GetValueAtIndex(segmentCombination.SegmentNames[i]);
                    var segmentValue = SegmentValuesStore.GetValueAtIndex(segmentCombination.SegmentValues[i]);
                    segmentNameValuePairs.Add(new SegmentNameValuePair { SegmentName = segmentName, SegmentValue = segmentValue });
                }
                else
                {
                    segmentNameValuePairs.Add(
                        new SegmentNameValuePair
                        {
                            /*                            SegmentName = SystemSettings.SEGMENT_NAME_NONE_VALUE,
                                                        SegmentValue = SystemSettings.SEGMENT_VALUE_NONE_VALUE*/
                            SegmentName = "**NONE**",
                            SegmentValue = "**NONE**" //TODO: using configuration for SEGMENT_NAME_NONE_VALUE and SEGMENT_VALUE_NONE_VALUE
                        });
                }
            }
            return new AggregateOutputKey(outputDimension, segmentNameValuePairs);
        }

        private IEnumerable<Row> AggregateForAllExpUnits(Row outputRow, IEnumerable<IList<Row>> expUnits)
        {
            var outputBagStore = new Dictionary<AggregateOutputKey, MetricBag>();
            var expUnitDimension = OrderedRollupDimensions.Last(dim => !dim.Equals(OutputDimension));
            var baseDimension = OrderedRollupDimensions[0];
            var nonBaseRollupDimensionsCount = OrderedRollupDimensions.Count - 1;
            var endSentinel = new BaseLevelRow { BaseLevelMetricBag = null, RollupDimensionValues = new List<string>() };
            for (int i = 0; i < nonBaseRollupDimensionsCount; i++)
            {
                endSentinel.RollupDimensionValues.Add(null);
            }

            foreach (var expUnit in expUnits)
            {
                var userRows = expUnit.Select(row =>
                {
                    var imprRow = BuildBaseLevelRow(row);
                    row.Reset();
                    return imprRow;
                });

                var userRowsWithEndMarker = userRows.Concat(new BaseLevelRow[] { endSentinel });

                ExpUnitLevelAggregate(outputBagStore, userRowsWithEndMarker);
            }

            foreach (var outputAggregateKeyEntry in outputBagStore)
            {
                yield return ToOutputRow(
                    outputRow,
                    new KeyValuePair<AggregateOutputKey, byte[]>(
                        outputAggregateKeyEntry.Key,
                        outputAggregateKeyEntry.Value.Serialize()));
            }
        }

        public IEnumerable<IList<Row>> PartitionByExpUnit(RowSet inputs)
        {
            int experimentUnitOrdinal = inputs.Schema[ExperimentUnitDimension];
            int flightOrdinal = inputs.Schema[OutputDimension]; // Even for the same scorecard flights are not unique per user

            List<Row> rowsForEachUnit = new List<Row>();
            var enumerator = inputs.Rows.GetEnumerator();
            if (!enumerator.MoveNext())
            {
                yield break;
            }

            var currentRow = enumerator.Current;
            string lastExpUnit = currentRow[experimentUnitOrdinal].String;
            string lastFlight = currentRow[flightOrdinal].String;

            do
            {
                currentRow = enumerator.Current;
                if ((lastExpUnit != currentRow[experimentUnitOrdinal].String)
                    || (lastFlight != currentRow[flightOrdinal].String))
                {
                    yield return rowsForEachUnit;
                    rowsForEachUnit = new List<Row>();
                    lastExpUnit = currentRow[experimentUnitOrdinal].String;
                    lastFlight = currentRow[flightOrdinal].String;
                }

                Row clonedRow = currentRow.Clone();
                rowsForEachUnit.Add(clonedRow);
            } while (enumerator.MoveNext());
            yield return rowsForEachUnit;
        }

        public override IEnumerable<Row> Process(RowSet input, Row output, string[] args)
        {
            Parse(args, input.Schema);
            return AggregateForAllExpUnits(output, PartitionByExpUnit(input));
        }
    }
    public class MVAggregateReducer : ScopeRuntime.Reducer
    {
        public override bool IsRecursive { get { return true; } }
        public override bool AllowColumnPruning { get { return false; } }
        public override bool RunSingleThreaded { get { return true; } }

        // private const string MetricsColumnName = SystemSettings.CompactedMetricsBagColumnName;
        private const string MetricsColumnName = "Metrics"; // TODO: using configuration for teh CompactedMetricsBagColumn


        private readonly IMetricsDefinitionsWrapper MetricsDefinitionsWrapper;

        private readonly string OutputRollupDimension;

        public MVAggregateReducer()
        {
            MetricsDefinitionsWrapper = MetricsVectorizationActivator.GetMetricsDefinitionsWrapperObject();
            OutputRollupDimension = MetricsDefinitionsWrapper.GetOrderedRollupDimensionsList().Last();
        }

        public override Schema Produces(string[] requestedColumns, string[] args, Schema input)
        {
            var schema = new Schema();
            schema = input.CloneWithSource();
            return schema;
        }

        private static Queue<MetricBag> FlightMetricBagPool = new Queue<MetricBag>();

        private MetricBag DeserializeBag(byte[] bin)
        {
            MetricBag bag;
            if (FlightMetricBagPool.Count == 0)
            {
                bag = new MetricBag(MetricsDefinitionsWrapper, OutputRollupDimension);
            }
            else
            {
                bag = FlightMetricBagPool.Dequeue();
            }

            bag.Deserialize(bin);

            return bag;
        }


        public override IEnumerable<Row> Reduce(RowSet input, Row outputRow, string[] args)
        {
            MetricBag resultBag = null;
            var rowcount = 0;
            foreach (var row in input.Rows)
            {
                MetricBag inputBag = null;
                rowcount++;
                if (rowcount == 1)
                {
                    if (FlightMetricBagPool.Count == 0)
                    {
                        resultBag = new MetricBag(MetricsDefinitionsWrapper, OutputRollupDimension);
                    }
                    else
                    {
                        resultBag = FlightMetricBagPool.Dequeue();
                    }
                    outputRow = row.Clone();
                    resultBag.Deserialize(row[MetricsColumnName].Binary);
                }
                else
                {
                    inputBag = DeserializeBag(row[MetricsColumnName].Binary);
                    resultBag.AddBag(inputBag);
                    FlightMetricBagPool.Enqueue(inputBag);
                }
            }

            if (resultBag != null)
            {
                outputRow[MetricsColumnName].Set(resultBag.Serialize());
            }
            FlightMetricBagPool.Enqueue(resultBag);
            yield return outputRow;
        }
    }
    /// <summary>
    /// The metrics compact processor adds 
    /// </summary>
    public class MVCompactionProcessor : Processor
    {
        public override bool AllowColumnPruning { get { return true; } }

        public override bool RowLevelProcessor { get { return true; } }

        public override bool RunSingleThreaded { get { return false; } }

        private readonly IMetricsDefinitionsWrapper MetricsDefinitionWrapper;

        private readonly List<string> OrderedRollupDimensions;

        //private const string MetricsColumnName = SystemSettings.CompactedMetricsBagColumnName;

        private const string MetricsColumnName = "Metrics"; // TODO: using configuration for teh CompactedMetricsBagColumn

        public MVCompactionProcessor()
        {
            MetricsDefinitionWrapper = MetricsVectorizationActivator.GetMetricsDefinitionsWrapperObject();
            OrderedRollupDimensions = MetricsDefinitionWrapper.GetOrderedRollupDimensionsList();
        }

        public override Schema Produces(string[] requestedColumns, string[] args, Schema inputSchema)
        {
            // Generate the metric bag mapping so that any exceptions due to missing columns would 
            // be caught during compile time.
            var baseLevelDimension = OrderedRollupDimensions.First();
            var aggregationBag = new BaseLevelAggregationBag(MetricsDefinitionWrapper, baseLevelDimension, baseLevelDimension);
            aggregationBag.UpdateMetricArrayIdxToRowIdxMapping(inputSchema);

            var outputSchema = new Schema();
            foreach (var col in OrderedRollupDimensions.Skip(1)) // Skip the base level column IG as we don't need it.
            {
                if (!inputSchema.Contains(col))
                {
                    //throw new Exception($"Rollup dimension column {col} not present in the input schema for {nameof(MVCompactionProcessor)}");
                    throw new Exception(String.Format("Rollup dimension column {0} not present in the input schema for {1}", col, "MVCompactionProcessor"));
                }
                int inputIndex = inputSchema[col];
                var inputColInfo = inputSchema[inputIndex];
                var outputColInfo = inputColInfo.Clone();
                outputColInfo.Source = inputColInfo;
                outputSchema.Add(outputColInfo);
            }

            var MetricsColumn = new ColumnInfo(MetricsColumnName, ColumnDataType.Binary);

            // Add dependency info
            // Get a list of all columns from the input that are begin used.
            var requiredInputColumns = MetricsDefinitionWrapper.GetRequiredScopeInputColumns();
            foreach (var inputMetricCol in requiredInputColumns)
            {
                if (!inputSchema.Contains(inputMetricCol))
                {
                    //throw new Exception($"Input to {nameof(MVCompactionProcessor)} does not contain the required column: {inputMetricCol}.");
                    throw new Exception(String.Format("Input to {0} does not contain the required column: {1}.", "MVCompactionProcessor", inputMetricCol));
                }
                MetricsColumn.AddDependency(inputSchema[inputSchema[inputMetricCol]]);
            }

            outputSchema.Add(MetricsColumn);
            return outputSchema;
        }

        public override IEnumerable<Row> Process(RowSet input, Row outputRow, string[] args)
        {
            var inputSchema = input.Schema;
            var baseLevelDimension = OrderedRollupDimensions.First();
            var aggregationBag = new BaseLevelAggregationBag(MetricsDefinitionWrapper, baseLevelDimension, baseLevelDimension);
            aggregationBag.UpdateMetricArrayIdxToRowIdxMapping(inputSchema);

            var outputSchema = outputRow.Schema;
            int[] mapping = new int[outputSchema.Count];

            for (var i = 0; i < outputSchema.Count; i++)
            {
                var outCol = outputSchema[i];
                if (outCol.Name == MetricsColumnName)
                {
                    mapping[i] = -1;
                }
                else
                {
                    if (!inputSchema.Contains(outCol.Name))
                    {
                        //throw new Exception($"Dimension column {outCol.Name} not present in input schema");
                        throw new Exception(String.Format("Dimension column {0} not present in input schema", outCol.Name));
                    }
                    mapping[i] = inputSchema[outCol.Name];
                }
            }

            foreach (var inputRow in input.Rows)
            {
                aggregationBag.PopulateMetricArraysFromRow(inputRow);
                outputRow[MetricsColumnName].Set(aggregationBag.Serialize());
                for (int i = 0; i < outputSchema.Count; ++i)
                {
                    var inputIndex = mapping[i];
                    if (inputIndex != -1)
                    {
                        inputRow[inputIndex].CopyTo(outputRow[i]);
                    }
                }
                yield return outputRow;
            }
        }
    }
    public class MVHistogramDecompactor : Processor
    {
        public const int REQUIRED_SEGMENT_LEVELS = 2;
        private const string NONE = "**NONE**";

        private const string FLIGHT = "Flight";

        public const string SEGMENT_NAME = "Segment_Name_";
        public const string SEGMENT_TYPE = "Segment_Type_";
        public const string SEGMENT_VALUE = "Segment_Value_";

        private const string DIMENSION_SET = "DimensionSet";
        public const string PERCENTILE_FAMILY = "PercentileFamily";
        public const string TYPE = "Type";
        public const string HAS_ANALYSISUNITS = "HasAnalysisUnits";
        public const string METRICS_COLUMN = "Metrics";

        public const string INTERMEDIATESTATS = "IntermediateStats";

        private const string METRIC = "Metric";
        private const string STANDARD_SEGMENT = "Standard";

        private int MaxSegmentLevels;
        private string FlightColumn;

        private readonly string _nSuffix;
        private readonly string _histogramSuffix;

        private readonly char _outerSeparator;
        private readonly char _innerSeparator;

        private IReadOnlyDictionary<string, string> MetricNameToLevel = new Dictionary<string, string>();

        private static Func<string, string> AdjustDimensionName = s => s == "IG" ? "FLIGHT" : s;

        /// <summary>
        /// A unique delimiter string, copied from the StaticParser. It is used
        /// by the compiler to rename multi-level metrics. We have copied it over
        /// instead of adding a dependency on the Parsing project to avoid
        /// issues with the targeted frameworks.
        /// </summary>
        public static string MAGIC_DELIMITER = "_f80ea57d_1c53_436b_ae74_d3f8d88ae6e8_";
        private static string[] Delimiters = new string[] { MAGIC_DELIMITER };

        public MVHistogramDecompactor()
        {
            _nSuffix = "_N";
            _outerSeparator = ';';
            _innerSeparator = ':';
        }

        public MVHistogramDecompactor(
            int maxSegmentLevels,
            string metricsDimensionSets,
            string flightColumn,
            char outerSeparator = ';',
            char innerSeparator = ':',
            string nSuffix = "_N",
            string histogramSuffix = "_Histogram")
        {
            MaxSegmentLevels = maxSegmentLevels;
            FlightColumn = flightColumn;

            MetricNameToLevel = metricsDimensionSets.Split(outerSeparator)
                    .Select(s => s.Split(innerSeparator))
                    .ToDictionary(arr => arr[0], arr => AdjustDimensionName(arr[1]));

            _nSuffix = nSuffix;
            _histogramSuffix = histogramSuffix;

            _outerSeparator = outerSeparator;
            _innerSeparator = innerSeparator;
        }

        public override Schema Produces(string[] _, string[] args, Schema ___)
        {
            var schema = new Schema();

            AddColumn(schema, DIMENSION_SET);
            AddColumn(schema, FLIGHT);

            var segmentDepth = Math.Max(MaxSegmentLevels, REQUIRED_SEGMENT_LEVELS);
            for (var i = 1; i <= segmentDepth; i++)
            {
                AddColumn(schema, SEGMENT_TYPE + i);
                AddColumn(schema, SEGMENT_NAME + i);
                AddColumn(schema, SEGMENT_VALUE + i);
            }

            AddColumn(schema, TYPE);
            AddColumn(schema, PERCENTILE_FAMILY);

            AddColumn(schema, HAS_ANALYSISUNITS);
            AddColumn(schema, METRICS_COLUMN);
            AddColumn(schema, INTERMEDIATESTATS);

            return schema;
        }

        public override IEnumerable<Row> Process(RowSet input, Row outputRow, string[] args)
        {
            var inputSchema = input.Schema;
            var MetricsDefinitionWrapper = MetricsVectorizationActivator.GetMetricsDefinitionsWrapperObject();

            MetricBag bag = new MetricBag(MetricsDefinitionWrapper, FlightColumn);

            foreach (var inputRow in input.Rows)
            {
                bag.Deserialize(inputRow[METRICS_COLUMN].Binary);
                var expressionNameToValue = MetricsDefinitionWrapper.GetOutputHistograms(bag);

                if (expressionNameToValue == null || expressionNameToValue.Count() == 0)
                {
                    continue;
                }

                // Flight
                inputRow[FlightColumn].CopyTo(outputRow[FLIGHT]);
                // Segment
                for (int i = 1; i <= MaxSegmentLevels; i++)
                {
                    inputRow[SEGMENT_VALUE + i].CopyTo(outputRow[SEGMENT_VALUE + i]);
                    inputRow[SEGMENT_NAME + i].CopyTo(outputRow[SEGMENT_NAME + i]);
                    outputRow[SEGMENT_TYPE + i].Set(STANDARD_SEGMENT); // not really used by xCard
                }

                for (int i = MaxSegmentLevels + 1; i <= REQUIRED_SEGMENT_LEVELS; i++)
                {
                    outputRow[SEGMENT_VALUE + i].Set(NONE);
                    outputRow[SEGMENT_NAME + i].Set(NONE);
                    outputRow[SEGMENT_TYPE + i].Set(STANDARD_SEGMENT); // not really used by xCard
                }

                foreach (var kvp in MetricNameToLevel)
                {
                    string histogramName = "";
                    string metricName = "";

                    GetStatisticsNames(kvp.Key, out metricName, out histogramName);

                    // Metrics IntermediateStats 
                    if (!expressionNameToValue.ContainsKey(histogramName))
                    {
                        continue;
                    }

                    outputRow[PERCENTILE_FAMILY].Set(metricName);
                    outputRow[DIMENSION_SET].Set(kvp.Value);
                    outputRow[TYPE].Set(kvp.Value == "RAWMUID" ? "RU" : "SubRU");

                    var histogramJsons = expressionNameToValue[histogramName].Split(new char[] { '\t' }, 3);

                    // HasAnalysisUnits 
                    var analysisUnit = long.Parse(histogramJsons[0]);
                    outputRow[HAS_ANALYSISUNITS].Set(analysisUnit > 0 ? true : false);

                    outputRow[METRICS_COLUMN].Set(histogramJsons[1]);
                    outputRow[INTERMEDIATESTATS].Set(histogramJsons[2]);

                    yield return outputRow;
                }
            }
        }

        private void GetStatisticsNames(string baseName, out string metricName, out string histogramName)
        {
            histogramName = baseName + _histogramSuffix;

            metricName = baseName
                    .Split(Delimiters, StringSplitOptions.None)
                    .First();
        }

        private ColumnInfo AddColumn(Schema schema, string name)
        {
            var result = new ColumnInfo(name, ColumnDataType.String);
            schema.Add(result);
            return result;
        }
    }

public class MVMetricsDecompactor : Processor
{
    public override bool AllowColumnPruning { get { return true; } }

    public override bool RowLevelProcessor { get { return true; } }

    public override bool RunSingleThreaded { get { return false; } }

    /// <summary>
    /// xCard cannot support only one segment level: it must have a
    /// primary and secondary segment. We will use this to "pad" the segments
    /// if they are missing, e.g. no segments at all, or just primary segment.
    /// </summary>
    public const int REQUIRED_SEGMENT_LEVELS = 2;
    private const string NONE = "**NONE**";

    public const string SEGMENT_NAME = "Segment_Name_";
    public const string SEGMENT_TYPE = "Segment_Type_";
    public const string SEGMENT_VALUE = "Segment_Value_";

    public const string METRICS_COLUMN = "Metrics";
    private const string AVERAGE = "Avg";
    private const string COUNT = "SampleSize";
    private const string DATA_TYPE = "DataType";
    private const string DIMENSION_SET = "DimensionSet";
    private const string FLIGHT = "Flight";
    private const string METRIC = "Metric";
    private const string NUMBERLINE = "Numberline";
    private const string STANDARD_DEVIATION = "StdDev";
    private const string STANDARD_SEGMENT = "Standard";
    private const string USER_DEFINED_TYPE = "UserDefinedType";
    private const string VALID_FOR_SEGMENT = "ValidForSegment";

    private readonly string _avgSuffix;
    private readonly string _varianceSuffix;
    private readonly string _nSuffix;
    private readonly string _udtSuffix;
    private readonly char _outerSeparator;
    private readonly char _innerSeparator;

    private int MaxSegmentLevels;
    private string FlightColumn;
    private IReadOnlyDictionary<string, string> MetricNameToLevel = new Dictionary<string, string>();

    /// <summary>
    /// This is an ugly hack required by xCard which has hard-coded assumption that
    /// the lowest aggregation level has dimension "FLIGHT" (for no real conceptual reason).
    /// Unfortunately, <see cref="MVMetricsDecompactor"/> does not have the information about
    /// the ordering of levels. As a result, we are making another hard-coding that
    /// lowest level of aggregation = "IG". This is true for all metric sets produced by MDL Core.
    /// </summary>
    private static Func<string, string> AdjustDimensionName = s => s == "IG" ? "FLIGHT" : s;

    /// <summary>
    /// A unique delimiter string, copied from the StaticParser. It is used
    /// by the compiler to rename multi-level metrics. We have copied it over
    /// instead of adding a dependency on the Parsing project to avoid
    /// issues with the targeted frameworks.
    /// </summary>
    public static string MAGIC_DELIMITER = "_f80ea57d_1c53_436b_ae74_d3f8d88ae6e8_";
    private static string[] Delimiters = new string[] { MAGIC_DELIMITER };

    public MVMetricsDecompactor()
    {
        _avgSuffix = "";
        _varianceSuffix = "_StdDev";
        _nSuffix = "_N";
        _udtSuffix = "_Udt";
        _outerSeparator = ';';
        _innerSeparator = ':';
    }

    public MVMetricsDecompactor(
        int maxSegmentLevels,
        string metricsDimensionSets,
        string flightColumn,
        char outerSeparator = ';',
        char innerSeparator = ':',
        string avgSuffix = "",
        string varianceSuffix = "_StdDev",
        string nSuffix = "_N",
        string udtSuffix = "_Udt")
    {
        MaxSegmentLevels = maxSegmentLevels;
        FlightColumn = flightColumn;

        MetricNameToLevel = metricsDimensionSets.Split(outerSeparator)
                .Select(s => s.Split(innerSeparator))
                .ToDictionary(arr => arr[0], arr => AdjustDimensionName(arr[1]));

        _avgSuffix = avgSuffix;
        _varianceSuffix = varianceSuffix;
        _nSuffix = nSuffix;
        _udtSuffix = udtSuffix;
        _outerSeparator = outerSeparator;
        _innerSeparator = innerSeparator;
    }

    public override Schema Produces(string[] _, string[] args, Schema ___)
    {
        var schema = new Schema();

        AddColumn(schema, NUMBERLINE);
        AddColumn(schema, DIMENSION_SET);
        AddColumn(schema, FLIGHT);

        var segmentDepth = Math.Max(MaxSegmentLevels, REQUIRED_SEGMENT_LEVELS);
        for (var i = 1; i <= segmentDepth; i++)
        {
            AddColumn(schema, SEGMENT_TYPE + i);
            AddColumn(schema, SEGMENT_NAME + i);
            AddColumn(schema, SEGMENT_VALUE + i);
        }

        AddColumn(schema, METRIC);
        AddColumn(schema, DATA_TYPE);
        AddColumn(schema, VALID_FOR_SEGMENT);
        AddColumn(schema, AVERAGE);
        AddColumn(schema, COUNT);
        AddColumn(schema, STANDARD_DEVIATION);
        AddColumn(schema, USER_DEFINED_TYPE);

        return schema;
    }

    public override IEnumerable<Row> Process(RowSet input, Row outputRow, string[] args)
    {
        var inputSchema = input.Schema;
        var MetricsDefinitionWrapper = MetricsVectorizationActivator.GetMetricsDefinitionsWrapperObject();

        MetricBag bag = new MetricBag(MetricsDefinitionWrapper, FlightColumn); 

        foreach (var inputRow in input.Rows)
        {
            outputRow[NUMBERLINE].Set("NotUsedByAllocationId"); // not really used by xCard
            outputRow[VALID_FOR_SEGMENT].Set(1); // not really used by xCard
            inputRow[FlightColumn].CopyTo(outputRow[FLIGHT]);

            for (int i = 1; i <= MaxSegmentLevels; i++)
            {
                inputRow[SEGMENT_VALUE + i].CopyTo(outputRow[SEGMENT_VALUE + i]);
                inputRow[SEGMENT_NAME + i].CopyTo(outputRow[SEGMENT_NAME + i]);
                outputRow[SEGMENT_TYPE + i].Set(STANDARD_SEGMENT); // not really used by xCard
            }

            for (int i = MaxSegmentLevels + 1; i <= REQUIRED_SEGMENT_LEVELS; i++)
            {
                outputRow[SEGMENT_VALUE + i].Set(NONE);
                outputRow[SEGMENT_NAME + i].Set(NONE);
                outputRow[SEGMENT_TYPE + i].Set(STANDARD_SEGMENT); // not really used by xCard
            }

            bag.Deserialize(inputRow[METRICS_COLUMN].Binary);
            var expressionNameToValue = MetricsDefinitionWrapper.GetOutputMetrics(bag);

            foreach (var kvp in MetricNameToLevel)
            {
                string avgName = "";
                string varName = "";
                string nName = "";
                string udtName = "";
                string metricName = "";
                GetStatisticsNames(kvp.Key, out metricName, out avgName, out varName, out nName, out udtName);

                // Check if it is vr metric
                var isVrMetric = metricName.StartsWith("VR_");

                outputRow[METRIC].Set(metricName);
                // Set avg to 0 for vr metric.
                outputRow[AVERAGE].Set(AdjustDoubleValue(isVrMetric ? string.Empty : expressionNameToValue[avgName]));

                if (!expressionNameToValue.ContainsKey(nName))
                {
                    var errorMessage = "Key metric not found:" + nName + ", metricName:" + metricName + ", MetricNameToLevelKey:" + kvp.Key + ", expressionCount:" + expressionNameToValue.Count;
                    throw new Exception(errorMessage);
                }

                outputRow[COUNT].Set(expressionNameToValue[nName]);
                // Set stddev to 0 for vr metric.
                outputRow[STANDARD_DEVIATION].Set(AdjustDoubleValue(
                    isVrMetric ?
                    string.Empty :
                    // Set stddev to 0 for non-vr metric if the count is 1
                    // Product Backlog Item 108643: Return stddev=0 for non-vr metric when count is 1
                    (expressionNameToValue[nName] == "1" ?
                        string.Empty :
                        expressionNameToValue[varName])));
                // Output udt if it exists, no matter the metric is vr or not.
                outputRow[USER_DEFINED_TYPE].Set(expressionNameToValue.ContainsKey(udtName) ? expressionNameToValue[udtName] : string.Empty);
                outputRow[DIMENSION_SET].Set(kvp.Value);

                // need to confirm this is OK, but it's the same as Scope native
                outputRow[DATA_TYPE].Set(typeof(double).ToString());

                yield return outputRow;
            }
        }
    }
    private ColumnInfo AddColumn(Schema schema, string name)
    {
        var result = new ColumnInfo(name, ColumnDataType.String);
        schema.Add(result);
        return result;
    }

    private void GetStatisticsNames(string baseName, out string metricName, out string avgName, out string varName, out string nName, out string udtName)
    {
        avgName = baseName + _avgSuffix;
        varName = baseName + _varianceSuffix;
        nName = baseName + _nSuffix;
        udtName = baseName + _udtSuffix;

        metricName = baseName
                .Split(Delimiters, StringSplitOptions.None)
                .First();
    }
    
    private string AdjustDoubleValue(string s)
    {
        if (string.IsNullOrEmpty(s))
        {
            return ((double)0).ToString("R");
        }

        double x;
        if (double.TryParse(s, out x))
        {
            return ZeroIfNaNOrInfinity(x).ToString("R");
        }
        return s;
    }

    /// <summary>
    /// This is needed due to xCard not supporting <see cref="double.NaN"/>
    /// or <see cref="double.NegativeInfinity"/> or <see cref="double.PositiveInfinity"/>
    /// values. By convention, they get replaced with 0. See, for example,
    /// https://experimentation.visualstudio.com/DefaultCollection/Analysis%20and%20Experimentation/_git/AnE.ExP.ScorecardPipeline?path=%2Fprivate%2FForay%2FForay.MetricsVectorization%2FStatistics%2FStatsLib.cs.
    ///
    /// TODO: This is a potential trustworhiness issue, since it can mask data issues
    /// as well as adds confusion with the actual value of 0. This behavior to be reconsidered.
    /// </summary>
    private static double ZeroIfNaNOrInfinity(double x)
    {
        return double.IsNaN(x)
            || double.IsInfinity(x) ? 0 : x;
    }
}
    public class MVRetroAASchemaAdjuster : Processor
    {
        private const string legacyPrimarySegmentColumn = "AA_MKT";
        private const string newPrimarySegmentColumn = "AA_Segment_Value_1";
        private const string legacyFlightColumn = "AA_FLIGHT";
        private const string newFlightColumn = "AA_Flight";

        // Map which stores pairs of old and new foray output column names. 
        // It store column names both ways so that it can work with any input output combination
        private static readonly Dictionary<string, string> legacyForayOutputColumnMap;

        static MVRetroAASchemaAdjuster()
        {
            legacyForayOutputColumnMap = new Dictionary<string, string>
            {
                { legacyPrimarySegmentColumn, newPrimarySegmentColumn },
                { newPrimarySegmentColumn, legacyPrimarySegmentColumn },
                { legacyFlightColumn, newFlightColumn },
                { newFlightColumn, legacyFlightColumn}
            };
        }

        /// <summary>
        /// Processor.Produces(): generate outputRow schema.
        /// </summary>
        /// <param name="requestedColumns"></param>
        /// <param name="args">only one or two arguments are expected. 
        ///     The first argument format should be columnName1:columnType1,columnName2:columnType2
        ///     The second argument is optional. It is a json string which contains the mapping between flight values in AB and AA.
        /// </param>
        /// <param name="inputSchema"></param>
        /// <returns></returns>
        public override Schema Produces(string[] requestedColumns, string[] args, Schema inputSchema)
        {
            Schema outputSchema;
            Schema adjustedSchema;

            if (args.Length == 1 || args.Length == 2)
            {
                adjustedSchema = new Schema(args[0]);
            }
            else
            {
                throw new ArgumentException(string.Format("Expected only ONE or TWO schema argement: arguments - {0}", string.Join(",", args)));
            }

            outputSchema = new Schema();
            if (requestedColumns.Length == 1 && requestedColumns[0] == "*")
            {
                // "SELECT *", then the fullSchema should contain the requestedColumns
                requestedColumns = adjustedSchema.Columns.Select(c => c.Name).ToArray();
            }

            if (requestedColumns.Length != adjustedSchema.Count)
            {
                throw new ArgumentException(
                    string.Format("Requested columns don't match the input arguments: requestedColumn - {0}, inputArg - {1}",
                    string.Join(",", requestedColumns),
                    string.Join(",", args)));
            }

            foreach (string columnName in requestedColumns)
            {
                int indexInFullSchema = adjustedSchema.IndexOf(columnName);
                if (indexInFullSchema >= 0)
                {
                    outputSchema.Add(adjustedSchema[indexInFullSchema]);
                }
                else
                {
                    throw new ArgumentException(string.Format("Column name {0} doesn't exist in adjusted schema", columnName));
                }
            }

            return outputSchema;
        }

        /// <summary>
        /// Processor.Process: generate data.
        /// </summary>
        /// <param name="input"></param>
        /// <param name="outputRow"></param>
        /// <param name="args">
        ///     args[0]: the output schema
        ///     args[1]: the flight value mapping in json format, example: {"flight1":"flight1:allicationid"}
        /// </param>
        /// <returns></returns>
        public override IEnumerable<Row> Process(RowSet input, Row outputRow, string[] args)
        {
            if (args.Length != 1 && args.Length != 2)
            {
                throw new ArgumentException(string.Format("Unexpected schema argements' count: arguments - {0}", string.Join(",", args)));
            }

            HashSet<String> missingColumns = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            HashSet<string> mappedColumns = new HashSet<string>();

            Dictionary<string, string> flightValueMapping = new Dictionary<string, string>();
            if (args.Length == 2)
            {
                try
                {
                    // ToDo: for support batching, need to parse flight and allocationid mapping from json string
                    flightValueMapping = new Dictionary<string, string>();
                }
                catch
                {
                    flightValueMapping = new Dictionary<string, string>();
                }
            }

            foreach (var col in outputRow.Schema.Columns)
            {
                if (!input.Schema.Contains(col.Name))
                {
                    if (/* check that this is not one of columns which was renamed */
                        legacyForayOutputColumnMap.ContainsKey(col.Name) &&
                        input.Schema.Contains(legacyForayOutputColumnMap[col.Name]))
                    {
                        mappedColumns.Add(col.Name);
                    }
                    else
                    {
                        missingColumns.Add(col.Name);
                    }
                }
            }

            foreach (var row in input.Rows)
            {
                foreach (var column in outputRow.Schema.Columns)
                {
                    if (missingColumns.Contains(column.Name))
                    {
                        // we need to fill in the default value if the column doesn't exist in the input rows.
                        // this is a hack. For all AA colums used for VR analysis, we all assumed it is nullable type. 
                        outputRow[column.Name].SetNull();
                    }
                    else if (mappedColumns.Contains(column.Name))
                    {
                        row[legacyForayOutputColumnMap[column.Name]].CopyTo(outputRow[column.Name]);
                    }
                    else
                    {
                        row[column.Name].CopyTo(outputRow[column.Name]);
                    }

                    if (string.Equals(column.Name, newFlightColumn) || string.Equals(column.Name, legacyFlightColumn))
                    {
                        if (flightValueMapping.ContainsKey(outputRow[column.Name].String))
                        {
                            outputRow[column.Name].Set(flightValueMapping[outputRow[column.Name].String]);
                        }
                    }
                }

                yield return outputRow;
            }
        }
    }

                #ENDCS
                