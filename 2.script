SUM(PercentageOfTurnsThatTriggeredDataverse_Denominator) AS PercentageOfTurnsThatTriggeredDataverse_Denominator,
SUM(QCNT_Numerator) AS QCNT_Numerator,
SUM(QCNT_Denominator) AS QCNT_Denominator,
MIN(MinQueryDate_Numerator) AS MinQueryDate_Numerator,
COUNTIF(MinQueryDate_Numerator != null) AS MinQueryDate_Denominator,
MAX(MaxQueryDate_Numerator) AS MaxQueryDate_Numerator,
COUNTIF(MaxQueryDate_Numerator != null) AS MaxQueryDate_Denominator,
MIN(MinQueryTime_Numerator) AS MinQueryTime_Numerator,
COUNTIF(MinQueryTime_Numerator != null) AS MinQueryTime_Denominator,
MAX(MaxQueryTime_Numerator) AS MaxQueryTime_Numerator,
COUNTIF(MaxQueryTime_Numerator != null) AS MaxQueryTime_Denominator,
SUM(ToolExecutionDetailsContainsAtLeast_One_python_tool_Numerator) AS ToolExecutionDetailsContainsAtLeast_One_python_tool_Numerator,
SUM(ToolExecutionDetailsContainsAtLeast_One_python_tool_Denominator) AS ToolExecutionDetailsContainsAtLeast_One_python_tool_Denominator,
SUM(Avg_InputTokensCount_REASONING_MODEL_Numerator) AS Avg_InputTokensCount_REASONING_MODEL_Numerator,
SUM(Avg_InputTokensCount_REASONING_MODEL_Denominator) AS Avg_InputTokensCount_REASONING_MODEL_Denominator,
SUM(Avg_UncachedTokensCount_REASONING_MODEL_Numerator) AS Avg_UncachedTokensCount_REASONING_MODEL_Numerator,
SUM(Avg_UncachedTokensCount_REASONING_MODEL_Denominator) AS Avg_UncachedTokensCount_REASONING_MODEL_Denominator,
SUM(Avg_OutputTokensCount_REASONING_MODEL_Numerator) AS Avg_OutputTokensCount_REASONING_MODEL_Numerator,
SUM(Avg_OutputTokensCount_REASONING_MODEL_Denominator) AS Avg_OutputTokensCount_REASONING_MODEL_Denominator,
SUM(Avg_CachedTokensCount_REASONING_MODEL_Numerator) AS Avg_CachedTokensCount_REASONING_MODEL_Numerator,
SUM(Avg_CachedTokensCount_REASONING_MODEL_Denominator) AS Avg_CachedTokensCount_REASONING_MODEL_Denominator,
