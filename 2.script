SUM(Avg_InputTokensCount_REASONING_MODEL_INSTANT_Denominator) AS Avg_InputTokensCount_REASONING_MODEL_INSTANT_Denominator,
SUM(Avg_UncachedTokensCount_REASONING_MODEL_INSTANT_Numerator) AS Avg_UncachedTokensCount_REASONING_MODEL_INSTANT_Numerator,
SUM(Avg_UncachedTokensCount_REASONING_MODEL_INSTANT_Denominator) AS Avg_UncachedTokensCount_REASONING_MODEL_INSTANT_Denominator,
