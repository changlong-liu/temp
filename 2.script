IF(Math.Abs(QCNT_Denominator) > 1e-100, Convert.ToDouble(QCNT_Numerator) / QCNT_Denominator, 0.0) AS AVG_QCNT,
IF(Math.Abs(QCNT_Denominator) > 1e-100, Math.Sqrt(QCNT_Denominator) * VarianceHelper.DeltaMethodStdDev((long)QCNT_Count, QCNT_Numerator, QCNT_Denominator, QCNT_SqNumerator, QCNT_SqDenominator, QCNT_Product), 0.0) AS STDDEV_QCNT,
VarianceHelper.DeltaMethodStdDevIntermediateResult((long)QCNT_Count, QCNT_Numerator, QCNT_Denominator, QCNT_SqNumerator, QCNT_SqDenominator, QCNT_Product) AS UDT_QCNT,
QCNT_Denominator AS COUNT_QCNT,
IF(Math.Abs(MinQueryDate_Denominator) > 1e-100, MinQueryDate_Numerator, (string)null) AS AVG_MinQueryDate,
0.0 AS STDDEV_MinQueryDate,
