// Create actual means and variances. <NativeAggregationTableCreateExpressionsProvider>
[LOWDISTINCTNESS(FLIGHT,Segment_Name_1,Segment_Type_1,Segment_Value_1,Segment_Name_2,Segment_Type_2,Segment_Value_2)]
ConversationLevelTableOutput__Native__0_unpivot_createmetrics = SELECT
