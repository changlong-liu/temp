	CoMet_high_level_intent_RequestId: string?,
	CoMet_high_level_intent_AadTenantId: string?,
	CoMet_high_level_intent_Oid: string?,
	CoMet_high_level_intent_OfficeRegion: string?,
	CoMet_high_level_intent_DatasetCategory: string?,
	CoMet_high_level_intent_metrics: string?,
	CoMet_intent_parse_RequestTime: DateTime?,
	CoMet_intent_parse_RequestId: string?,
	CoMet_intent_parse_AadTenantId: string?,
	CoMet_intent_parse_Oid: string?,
	CoMet_intent_parse_OfficeRegion: string?,
	CoMet_intent_parse_DatasetCategory: string?,
	CoMet_intent_parse_metrics: string?,
                        __date
                    FROM SPARSE STREAMSET @"abfss://filesystem@substrateadlsg2neuprod.dfs.core.windows.net/local/Aggregated/Datasets/Public/CopilotScore/"
                    PATTERN "Daily/%Y/%m/%d/CopilotScoreDataset_" + "EU" + "_NonEUDBTenant_%Y-%m-%d.ss"
                    RANGE __date = [@ScoreDataStartTime, @ScoreDataEndTime]
                    USING Extractors.SStream();
                    
    ScoreDataDaily =
        SELECT
            *.Except(__date),
            __date.ToString("yyyy-MM-dd") AS ScoreDayTime
        FROM ScoreDataDaily;
    
        ScoreData = SELECT * FROM ScoreDataDaily;
    
    ScoreData =
        SELECT
            *.ExceptIfExists(
                chatsat_ux_score,
                chatsat_response_quality_score,
                chatsat_ux_confidence,
                chatsat_response_quality_confidence
            ),
            (chatsat_ux_score != null ? chatsat_ux_score : chatsat_response_quality_score) AS chatsat_response_quality_score,
            (chatsat_ux_confidence != null ? chatsat_ux_confidence : chatsat_response_quality_confidence) AS chatsat_response_quality_confidence
        FROM ScoreData;

    // Adhoc logic, will remove in the future
    ScoreData =
        SELECT
            *,
            (string)""  AS DWD_FACT_ResponseActionList,
            (string)""  AS DWD_FACT_SystemActionList
        FROM ScoreData;

    // Adhoc logic, will remove in the future
    ScoreData =
        SELECT
            *,
            Utility.ExtractValueFromJson<double?>(SSRMetrics, "chatsat_session_inferred_score") AS chatsat_session_inferred_score,
            Utility.ExtractValueFromJson<int?>(SSRMetrics, "chatsat_session_inferred_success") AS chatsat_session_inferred_success,
            Utility.ExtractValueFromJson<int?>(SSRMetrics, "chatsat_session_inferred_failure") AS chatsat_session_inferred_failure,
            Utility.ExtractValueFromJson<string>(SSRMetrics, "chatsat_ssr_insights") AS chatsat_session_insights,
            Utility.ExtractValueFromJson<string>(SSRMetrics, "data_source") AS chatsat_session_data_source
        FROM ScoreData;

    ScoreData =
        SELECT *.ExceptIfExists(EyesOffScoreShadow_AadTenantId,EyesOffScoreShadow_AppName,EyesOffScoreShadow_AppScenario,EyesOffScoreShadow_ConversationId,EyesOffScoreShadow_DatasetCategory,EyesOffScoreShadow_ExperienceType,EyesOffScoreShadow_JobDate,EyesOffScoreShadow_Language,EyesOffScoreShadow_Region,EyesOffScoreShadow_RequestTime,EyesOffScoreShadow_Ring,EyesOffScoreShadow_TurnId,EyesOffScoreShadow_UserPUID,EyesOffScoreShadow_ObjectId,EyesOffScoreShadow_ParentRequestId,EyesOffScoreShadow_TrafficType,EyesOffScoreShadow_CorrelationId,EyesOffScoreShadow_ExperimentName,EyesOffScoreShadow_TurnLevelCorrelationId,EyesOffScoreShadow_CorrelationId_Base,EyesOffScoreShadow_OfficeRegion,EyesOffScoreShadow_JobHour,EyesOffScoreShadow_ShadowMetricsPerFlights, EyesOffScoreShadow_ShadowDebugMetricsPerFlights, SSRMetrics)
            .Rename(REGEX("^(?!CoMet_)(.*)$") AS "ScoreWithSlicerData_${1}"),
            EyesOffScoreShadow_AadTenantId,
            EyesOffScoreShadow_AppName,
            EyesOffScoreShadow_AppScenario,
            EyesOffScoreShadow_ConversationId,
            EyesOffScoreShadow_DatasetCategory,
            EyesOffScoreShadow_ExperienceType,
            EyesOffScoreShadow_JobDate,
            EyesOffScoreShadow_Language,
            EyesOffScoreShadow_Region,
            EyesOffScoreShadow_RequestTime,
            EyesOffScoreShadow_Ring,
            EyesOffScoreShadow_TurnId,
            EyesOffScoreShadow_UserPUID,
            EyesOffScoreShadow_ObjectId,
            EyesOffScoreShadow_ParentRequestId,
            EyesOffScoreShadow_TrafficType,
            EyesOffScoreShadow_CorrelationId,
            EyesOffScoreShadow_ExperimentName,
            EyesOffScoreShadow_TurnLevelCorrelationId,
            EyesOffScoreShadow_CorrelationId_Base,
            EyesOffScoreShadow_OfficeRegion,
            EyesOffScoreShadow_JobHour,
            EyesOffScoreShadow_ShadowMetricsPerFlights,
            EyesOffScoreShadow_ShadowDebugMetricsPerFlights,
            (!string.IsNullOrEmpty(RequestId)
                ? RequestId.ToLowerInvariant().Replace("-", "")
                : string.Empty) AS ScoreWithSlicerData_NormalizedRequestId
        FROM ScoreData;

        ScoreDataToJoin =
        SELECT *
        FROM ScoreData
        WHERE !string.IsNullOrEmpty(ScoreWithSlicerData_NormalizedRequestId);

    ScoreDataNotToJoin =
        SELECT *
        FROM ScoreData
        WHERE string.IsNullOrEmpty(ScoreWithSlicerData_NormalizedRequestId);

    // Join key: RequestId
    
    
    FusionData =
        SELECT
            A.*,
            B.*
        FROM UsageData AS A
        LEFT JOIN ScoreDataToJoin AS B
            ON A.NormalizedRequestId == B.ScoreWithSlicerData_NormalizedRequestId;

    
    // Add IsOnlyScoreData column
    FusionData =
        SELECT
            *,
            IF(
                ScoreWithSlicerData_NormalizedRequestId != NULL 
                AND NormalizedRequestId == NULL, 
                true, 
                false
            ) AS IsOnlyScoreData
        FROM FusionData;
      #ELSE
     RAISE ERROR ("Invalid parameter combination: 'ScoreLeftJoinUsage' or 'ScoreRightJoinUsage' join for ScoreDataJoinType is only supported when ConsumptionMode does not include 'onlyedps'. Please adjust parameters accordingly.");
  #ENDIF




// Apply filter







    FusionData = SELECT *.ExceptIfExists(CorrelationId, NormalizedCorrelationId, RequestId)
                 FROM FusionData;

    FusionData = SELECT *.RenameIfExists(	UsageDataSet_RequestTime AS RequestTime,
	UsageDataSet_DeployRing AS DeployRing,
