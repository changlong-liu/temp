	UsageDataSet_SSSRestrictedSearchMode AS SSSRestrictedSearchMode,
	UsageDataSet_SydneyFirstChunkFinalResponse AS SydneyFirstChunkFinalResponse,
	UsageDataSet_ToolExecutionFlow AS ToolExecutionFlow,
	UsageDataSet_TurnNumberInConversation AS TurnNumberInConversation,
	UsageDataSet_UsedEntityAnnotations AS UsedEntityAnnotations,
	UsageDataSet_WebEnabledStatus AS WebEnabledStatus,
	UsageDataSet_TriggeredSource AS TriggeredSource,
	UsageDataSet_ResponseActionList AS ResponseActionList,
	UsageDataSet_SystemActionList AS SystemActionList,
	UsageDataSet_ClientEventCount AS ClientEventCount,
	UsageDataSet_ClientFlights AS ClientFlights,
	UsageDataSet_NudgeTriggered AS NudgeTriggered,
	UsageDataSet_PluginCitations AS PluginCitations,
	UsageDataSet_DeclaritiveCopilotExtendedData AS DeclaritiveCopilotExtendedData,
	UsageDataSet_CopilotProduct  AS CopilotProduct ,
	UsageDataSet_LanguageMismatchType AS LanguageMismatchType,
	UsageDataSet_SuggestionResults AS SuggestionResults,
	UsageDataSet_NumSuggestedResponses AS NumSuggestedResponses,
	UsageDataSet_ChatFirstTokenRenderedModel AS ChatFirstTokenRenderedModel,
	UsageDataSet_ChatFirstTokenRenderedCoalesce AS ChatFirstTokenRenderedCoalesce,
	UsageDataSet_ChatLastTokenRenderedCoalesce AS ChatLastTokenRenderedCoalesce,
	UsageDataSet_SydneyFirstTokenRenderedModel AS SydneyFirstTokenRenderedModel,
	UsageDataSet_MessageId AS MessageId,
	UsageDataSet_SydneyFirstServiceResponse AS SydneyFirstServiceResponse,
	UsageDataSet_SydneyLastChunkFinalResponse AS SydneyLastChunkFinalResponse,
	UsageDataSet_SearchWebLatency AS SearchWebLatency,
	UsageDataSet_LLMSydneyLatency AS LLMSydneyLatency)
                 FROM FusionData;

    FusionData = SELECT *.ExceptIfExists(UsageDataSet_RequestTime, M365ChatView_RequestTime, UsageDataSet_DeployRing, M365ChatView_DeployRing, UsageDataSet_RequestId, M365ChatView_RequestId, UsageDataSet_Locale, M365ChatView_Locale, UsageDataSet_ExperienceType, M365ChatView_ExperienceType, UsageDataSet_CiqInsertedEntityTypes, M365ChatView_CiqInsertedEntityTypes, UsageDataSet_AppName, M365ChatView_AppName, UsageDataSet_Product, M365ChatView_Product, UsageDataSet_IsEchoTraffic, M365ChatView_IsEchoTraffic, UsageDataSet_SourceBranch, M365ChatView_SourceBranch, UsageDataSet_ClientPlatform, M365ChatView_ClientPlatform, UsageDataSet_AppFlavor, M365ChatView_AppFlavor, UsageDataSet_SydneyAvailability, M365ChatView_SydneyAvailability, UsageDataSet_QuerySubmitProperties, M365ChatView_QuerySubmitProperties, UsageDataSet_Region, M365ChatView_Region, UsageDataSet_AadTenantId, M365ChatView_AadTenantId, UsageDataSet_CosmicPartition, M365ChatView_CosmicPartition, UsageDataSet_Oid, M365ChatView_Oid, UsageDataSet_CorrelationId, M365ChatView_CorrelationId, UsageDataSet_ConversationId, M365ChatView_ConversationId, UsageDataSet_CitationCount, M365ChatView_CitationCount, UsageDataSet_ChatFirstServiceResponse, M365ChatView_ChatFirstServiceResponse, UsageDataSet_ChatFirstChunkFinalResponse, M365ChatView_ChatFirstChunkFinalResponse, UsageDataSet_ChatLastChunkFinalResponse, M365ChatView_ChatLastChunkFinalResponse, UsageDataSet_NormalizedCorrelationId, M365ChatView_NormalizedCorrelationId, UsageDataSet_CopilotExtensionIds, M365ChatView_CopilotExtensionIds, UsageDataSet_CopilotExtensionState, M365ChatView_CopilotExtensionState, UsageDataSet_ConnectorCitations, M365ChatView_ConnectorCitations, UsageDataSet_PluginInvocations, M365ChatView_PluginInvocations, UsageDataSet_ClientAppName, M365ChatView_ClientAppName, UsageDataSet_Scenario, M365ChatView_Scenario, UsageDataSet_ReferenceCitations, M365ChatView_ReferenceCitations, UsageDataSet_ClientRegion, M365ChatView_ClientRegion, UsageDataSet_EchoExperiment, M365ChatView_EchoExperiment, UsageDataSet_IsDisengaged, M365ChatView_IsDisengaged, UsageDataSet_OrchestratorIterationCount, M365ChatView_OrchestratorIterationCount, UsageDataSet_UtteranceLength, M365ChatView_UtteranceLength, UsageDataSet_IsTestTraffic, M365ChatView_IsTestTraffic, UsageDataSet_SSSFlights, M365ChatView_SSSFlights, UsageDataSet_SydneyFlights, M365ChatView_SydneyFlights, UsageDataSet_IsSearchTriggered, M365ChatView_IsSearchTriggered, UsageDataSet_LLMAPITokensCountList, M365ChatView_LLMAPITokensCountList, UsageDataSet_Market, M365ChatView_Market, UsageDataSet_NoApologyDetectedState, M365ChatView_NoApologyDetectedState, UsageDataSet_SecondsToNextTurn, M365ChatView_SecondsToNextTurn, UsageDataSet_ServerSessionId, M365ChatView_ServerSessionId, UsageDataSet_SessionDurationInSeconds, M365ChatView_SessionDurationInSeconds, UsageDataSet_SessionTotalTurnCount, M365ChatView_SessionTotalTurnCount, UsageDataSet_SessionTurnSequenceNumber, M365ChatView_SessionTurnSequenceNumber, UsageDataSet_SSSEmptyResultRequests, M365ChatView_SSSEmptyResultRequests, UsageDataSet_SSSEmptyResultSuccessfulRequests, M365ChatView_SSSEmptyResultSuccessfulRequests, UsageDataSet_SSSQueryAPILatency, M365ChatView_SSSQueryAPILatency, UsageDataSet_SSSTotalIterations, M365ChatView_SSSTotalIterations, UsageDataSet_SSSTotalRequests, M365ChatView_SSSTotalRequests, UsageDataSet_SSSTotalResultsCount, M365ChatView_SSSTotalResultsCount, UsageDataSet_SSSTotalSuccessfulRequests, M365ChatView_SSSTotalSuccessfulRequests, UsageDataSet_StartTimeOfNextSession, M365ChatView_StartTimeOfNextSession, UsageDataSet_SSSReducedResultsMessages, M365ChatView_SSSReducedResultsMessages, UsageDataSet_SSSRestrictedSearchMode, M365ChatView_SSSRestrictedSearchMode, UsageDataSet_SydneyFirstChunkFinalResponse, M365ChatView_SydneyFirstChunkFinalResponse, UsageDataSet_ToolExecutionFlow, M365ChatView_ToolExecutionFlow, UsageDataSet_TurnNumberInConversation, M365ChatView_TurnNumberInConversation, UsageDataSet_UsedEntityAnnotations, M365ChatView_UsedEntityAnnotations, UsageDataSet_WebEnabledStatus, M365ChatView_WebEnabledStatus, UsageDataSet_TriggeredSource, M365ChatView_TriggeredSource, UsageDataSet_ResponseActionList, M365ChatView_ResponseActionList, UsageDataSet_SystemActionList, M365ChatView_SystemActionList, UsageDataSet_ClientEventCount, M365ChatView_ClientEventCount, UsageDataSet_ClientFlights, M365ChatView_ClientFlights, UsageDataSet_NudgeTriggered, M365ChatView_NudgeTriggered, UsageDataSet_PluginCitations, M365ChatView_PluginCitations, UsageDataSet_DeclaritiveCopilotExtendedData, M365ChatView_DeclaritiveCopilotExtendedData, UsageDataSet_CopilotProduct , M365ChatView_CopilotProduct , UsageDataSet_LanguageMismatchType, M365ChatView_LanguageMismatchType, UsageDataSet_SuggestionResults, M365ChatView_SuggestionResults, UsageDataSet_NumSuggestedResponses, M365ChatView_NumSuggestedResponses, UsageDataSet_ChatFirstTokenRenderedModel, M365ChatView_ChatFirstTokenRenderedModel, UsageDataSet_ChatFirstTokenRenderedCoalesce, M365ChatView_ChatFirstTokenRenderedCoalesce, UsageDataSet_ChatLastTokenRenderedCoalesce, M365ChatView_ChatLastTokenRenderedCoalesce, UsageDataSet_SydneyFirstTokenRenderedModel, M365ChatView_SydneyFirstTokenRenderedModel, UsageDataSet_MessageId, M365ChatView_MessageId, UsageDataSet_SydneyFirstServiceResponse, M365ChatView_SydneyFirstServiceResponse, UsageDataSet_SydneyLastChunkFinalResponse, M365ChatView_SydneyLastChunkFinalResponse, UsageDataSet_SearchWebLatency, M365ChatView_SearchWebLatency, UsageDataSet_LLMSydneyLatency, M365ChatView_LLMSydneyLatency)
