
 
 
VIEW CopilotDataFusionView RETURN ROWSET PARAMS (

	StartDateTime string,
	EndDateTime string,
	Region string DEFAULT = "RoW",
	AppName string DEFAULT = "*",
	Product string DEFAULT = "*",
	Scenario string DEFAULT = "*",
	ClientAppName string DEFAULT = "*",
	ClientPlatform string DEFAULT = "*",
	DeployRing string DEFAULT = "WW",
	FeedbackDataJoinType string DEFAULT = "FeedbackDataNotIncluded",
	FeedbackCUDJoinKey string DEFAULT = "MessageIdMessageId",
	FeedbackSubmissionStartDateTime string DEFAULT = "",
	FeedbackSubmissionEndDateTime string DEFAULT = "",
	ScoreDataJoinType string DEFAULT = "None",
	ScoreDataLoadingMode string DEFAULT = "UserBased",
	CustomInput string DEFAULT = "",
	CustomView string DEFAULT = "",
	JoinType string DEFAULT = "OnlyUsage",
	IsSawUsedForEU bool DEFAULT = true,
	ContainsServerFlightsInfo bool DEFAULT = true,
	IsFullSchema bool DEFAULT = false,
	ConsumeHourly bool DEFAULT = false,
	ConsumptionMode string DEFAULT = "Daily"
 
)
BEGIN  

REFERENCE "CopilotDataFusionView.dll";
USING CopilotDataFusionView;


#DECLARE IsHourlyMode bool = Convert.ToBoolean("false");
#DECLARE CopilotUsageViewConsumptionModeStr string ="daily,includeserversessionid,includefeedback";
#DECLARE dataStartTime DateTime = DateTime.SpecifyKind(DateTime.Parse("2026-08-19T00:00:00",CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind), DateTimeKind.Utc);
#DECLARE dataEndTime DateTime;

            #SET dataEndTime = DateTime.SpecifyKind(DateTime.Parse("2026-08-25 23:59:58", CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind), DateTimeKind.Utc).AddMilliseconds(-1);
    
#DECLARE RootFolderPath String = @"/shares/exchange.storage.prod/";
#SET RootFolderPath = "abfss://filesystem@substrateadlsg2neuprod.dfs.core.windows.net/";



UsageDataSetView = VIEW "abfss://filesystem@substrateadlsg2neuprod.dfs.core.windows.net/local/MSAI/CopilotUsage/View/CopilotUsageView.view"
                    PARAMS
                    (
                        StartDateTime = @dataStartTime,
                        EndDateTime = @dataEndTime,
                        ConsumeHourly = @IsHourlyMode,
                        ConsumptionMode = @CopilotUsageViewConsumptionModeStr,
                        IsEuropeRegion = true
                    );

UsageDataSetView =
    SELECT
        *.ExceptIfExists( CiqInsertedEntityTypes, NoApologyDetectedState, CopilotExtensionIds, SecondsToNextTurn, ServerSessionId, SessionDurationInSeconds, SessionTotalTurnCount, SessionTurnSequenceNumber, StartTimeOfNextSession, SSSReducedResultsMessages, UsedEntityAnnotations, WebEnabled, TriggeredSource, ToolExecutionFlow, LLMAPITokensCountList, ConnectorCitations, PluginCitations, PluginExecutions,  ResponseActionList, SystemActionList, ReferenceCitations, DeployRing, CosmicPartition, Region, NormalizedCorrelationId, QuerySubmitProperties, CitationCount, SSSFlights, SydneyFlights, SSSRestrictedSearchMode, NudgeTriggered, SuggestionResults),
        EnvironmentContext != null && EnvironmentContext.Count !=0 && EnvironmentContext.ContainsField("DeployRing") ? EnvironmentContext.DeployRing : (string)null AS DeployRing,
        EnvironmentContext != null && EnvironmentContext.Count !=0 && EnvironmentContext.ContainsField("CosmicPartition") ? EnvironmentContext.CosmicPartition : (string)null AS CosmicPartition,
        EnvironmentContext != null && EnvironmentContext.Count !=0 && EnvironmentContext.ContainsField("Region") ? EnvironmentContext.Region : (string)null AS Region,
        (!string.IsNullOrEmpty(CorrelationId) ? CorrelationId.ToLowerInvariant().Replace("-", "") : (string)null) AS NormalizedCorrelationId,
        Utility.GetQuerySubmitProperties(ResponseActionList) AS QuerySubmitProperties,
        Utility.GetCitationsCount(ReferenceCitations) AS CitationCount,
        String.Join(";", CiqInsertedEntityTypes.Where(x => !string.IsNullOrEmpty(x))) AS CiqInsertedEntityTypes,
        Utility.GetLLMAPITokensCountList(LLMRequests) AS LLMAPITokensCountList,
        NoApologyDetectedState == null? string.Empty : NoApologyDetectedState == true ? "Pass" : "Error" AS NoApologyDetectedState,
        Utility.GetRestrictedSearchMode(SSSRequests) AS SSSRestrictedSearchMode,
        CustomJsonConverter.JsonSerialize(ResponseActionList) AS ResponseActionList,
        CustomJsonConverter.JsonSerialize(SystemActionList) AS SystemActionList,
        Utility.ConvertArrayToString(ToolExecutionFlow) AS ToolExecutionFlow,
        CustomJsonConverter.JsonSerialize(ReferenceCitations) AS ReferenceCitations,
        (string)null AS AppFlavor,
        Utility.GetFirstCopilotExtensionId(CopilotExtensionIds) AS CopilotExtensionIds,
        CopilotExtensionIds AS CUDCopilotExtensionIds,
        CustomJsonConverter.JsonSerialize(PluginExecutions) AS PluginInvocations,
        Utility.GetTriggeredSource(SSSRequests, BingRequests) AS TriggeredSource,
        (double?)null AS SecondsToNextTurn,
        (string)null AS ServerSessionId,
        (double?)null AS SessionDurationInSeconds,
        (int?)null AS SessionTotalTurnCount,
        (int?)null AS SessionTurnSequenceNumber,
        (DateTime?)null AS StartTimeOfNextSession,
        Utility.GetSSSReducedResultsMessages(SSSRequests) AS SSSReducedResultsMessages,
        CustomJsonConverter.JsonSerialize(UsedEntityAnnotations) AS UsedEntityAnnotations,
        NudgeTriggered.HasValue ? NudgeTriggered.Value.ToString() : null AS NudgeTriggered,
        Utility.GeneratePluginCitationsToString(ReferenceCitations, SourceBranch) AS PluginCitations,
        Utility.GenerateConnectorCitationsToString(ReferenceCitations, SourceBranch) AS ConnectorCitations,
        Utility.GetFirstAgentExtendedDataToString(AgentExtendedData) AS DeclaritiveCopilotExtendedData,
        CustomJsonConverter.JsonSerialize(SuggestionResults) AS SuggestionResults,
        SuggestionResults != null ? SuggestionResults.Count : 0 AS NumSuggestedResponses,
        Flights != null && Flights.Count !=0 && Flights.ContainsField("SSSFlights") ? Flights.SSSFlights : (string)null AS SSSFlights,
        Flights != null && Flights.Count !=0 && Flights.ContainsField("SydneyFlights") ? Flights.SydneyFlights : (string)null AS SydneyFlights,
        Flights != null && Flights.Count !=0 && Flights.ContainsField("ClientFlights") ? Flights.ClientFlights : (string)null AS ClientFlights,
        Flights != null && Flights.Count !=0 && Flights.ContainsField("ShadowTriggerFlights") ? Flights.ShadowTriggerFlights : (string)null AS ShadowTriggerFlights,
        Flights != null && Flights.Count !=0 && Flights.ContainsField("ShadowOverrideFlights") ? Flights.ShadowOverrideFlights : (string)null AS ShadowOverrideFlights
    FROM UsageDataSetView;
        
UsageDataSetView =  SELECT *.RenameIfExists(RequestTime AS UsageDataSet_RequestTime, DeployRing AS UsageDataSet_DeployRing, RequestId AS UsageDataSet_RequestId, Locale AS UsageDataSet_Locale, ExperienceType AS UsageDataSet_ExperienceType, CiqInsertedEntityTypes AS UsageDataSet_CiqInsertedEntityTypes, AppName AS UsageDataSet_AppName, Product AS UsageDataSet_Product, IsEchoTraffic AS UsageDataSet_IsEchoTraffic, SourceBranch AS UsageDataSet_SourceBranch, ClientPlatform AS UsageDataSet_ClientPlatform, AppFlavor AS UsageDataSet_AppFlavor, SydneyAvailability AS UsageDataSet_SydneyAvailability, QuerySubmitProperties AS UsageDataSet_QuerySubmitProperties, Region AS UsageDataSet_Region, AadTenantId AS UsageDataSet_AadTenantId, CosmicPartition AS UsageDataSet_CosmicPartition, Oid AS UsageDataSet_Oid, CorrelationId AS UsageDataSet_CorrelationId, ConversationId AS UsageDataSet_ConversationId, CitationCount AS UsageDataSet_CitationCount, ChatFirstServiceResponse AS UsageDataSet_ChatFirstServiceResponse, ChatFirstChunkFinalResponse AS UsageDataSet_ChatFirstChunkFinalResponse, ChatLastChunkFinalResponse AS UsageDataSet_ChatLastChunkFinalResponse, NormalizedCorrelationId AS UsageDataSet_NormalizedCorrelationId, CopilotExtensionIds AS UsageDataSet_CopilotExtensionIds, CopilotExtensionState AS UsageDataSet_CopilotExtensionState, ConnectorCitations AS UsageDataSet_ConnectorCitations, PluginInvocations AS UsageDataSet_PluginInvocations, ClientAppName AS UsageDataSet_ClientAppName, Scenario AS UsageDataSet_Scenario, ReferenceCitations AS UsageDataSet_ReferenceCitations, ClientRegion AS UsageDataSet_ClientRegion, EchoExperiment AS UsageDataSet_EchoExperiment, IsDisengaged AS UsageDataSet_IsDisengaged, OrchestratorIterationCount AS UsageDataSet_OrchestratorIterationCount, UtteranceLength AS UsageDataSet_UtteranceLength, IsTestTraffic AS UsageDataSet_IsTestTraffic, SSSFlights AS UsageDataSet_SSSFlights, SydneyFlights AS UsageDataSet_SydneyFlights, IsSearchTriggered AS UsageDataSet_IsSearchTriggered, LLMAPITokensCountList AS UsageDataSet_LLMAPITokensCountList, Market AS UsageDataSet_Market, NoApologyDetectedState AS UsageDataSet_NoApologyDetectedState, SecondsToNextTurn AS UsageDataSet_SecondsToNextTurn, ServerSessionId AS UsageDataSet_ServerSessionId, SessionDurationInSeconds AS UsageDataSet_SessionDurationInSeconds, SessionTotalTurnCount AS UsageDataSet_SessionTotalTurnCount, SessionTurnSequenceNumber AS UsageDataSet_SessionTurnSequenceNumber, SSSEmptyResultRequests AS UsageDataSet_SSSEmptyResultRequests, SSSEmptyResultSuccessfulRequests AS UsageDataSet_SSSEmptyResultSuccessfulRequests, SSSQueryAPILatency AS UsageDataSet_SSSQueryAPILatency, SSSTotalIterations AS UsageDataSet_SSSTotalIterations, SSSTotalRequests AS UsageDataSet_SSSTotalRequests, SSSTotalResultsCount AS UsageDataSet_SSSTotalResultsCount, SSSTotalSuccessfulRequests AS UsageDataSet_SSSTotalSuccessfulRequests, StartTimeOfNextSession AS UsageDataSet_StartTimeOfNextSession, SSSReducedResultsMessages AS UsageDataSet_SSSReducedResultsMessages, SSSRestrictedSearchMode AS UsageDataSet_SSSRestrictedSearchMode, SydneyFirstChunkFinalResponse AS UsageDataSet_SydneyFirstChunkFinalResponse, ToolExecutionFlow AS UsageDataSet_ToolExecutionFlow, TurnNumberInConversation AS UsageDataSet_TurnNumberInConversation, UsedEntityAnnotations AS UsageDataSet_UsedEntityAnnotations, WebEnabledStatus AS UsageDataSet_WebEnabledStatus, TriggeredSource AS UsageDataSet_TriggeredSource, ResponseActionList AS UsageDataSet_ResponseActionList, SystemActionList AS UsageDataSet_SystemActionList, ClientEventCount AS UsageDataSet_ClientEventCount, ClientFlights AS UsageDataSet_ClientFlights, NudgeTriggered AS UsageDataSet_NudgeTriggered, PluginCitations AS UsageDataSet_PluginCitations, DeclaritiveCopilotExtendedData AS UsageDataSet_DeclaritiveCopilotExtendedData, CopilotProduct  AS UsageDataSet_CopilotProduct , LanguageMismatchType AS UsageDataSet_LanguageMismatchType, SuggestionResults AS UsageDataSet_SuggestionResults, NumSuggestedResponses AS UsageDataSet_NumSuggestedResponses, ChatFirstTokenRenderedModel AS UsageDataSet_ChatFirstTokenRenderedModel, ChatFirstTokenRenderedCoalesce AS UsageDataSet_ChatFirstTokenRenderedCoalesce, ChatLastTokenRenderedCoalesce AS UsageDataSet_ChatLastTokenRenderedCoalesce, SydneyFirstTokenRenderedModel AS UsageDataSet_SydneyFirstTokenRenderedModel, MessageId AS UsageDataSet_MessageId, SydneyFirstServiceResponse AS UsageDataSet_SydneyFirstServiceResponse, SydneyLastChunkFinalResponse AS UsageDataSet_SydneyLastChunkFinalResponse, SearchWebLatency AS UsageDataSet_SearchWebLatency, LLMSydneyLatency AS UsageDataSet_LLMSydneyLatency)
                    FROM UsageDataSetView;

UsageDataSetView =  SELECT *.RenameIfExists(ChatFirstTokenRendered AS UsageDataSet_ChatFirstChunkFinalResponse) FROM UsageDataSetView;


// Define UsageData

UsageData = SELECT * FROM UsageDataSetView;

// Set CorrelationId, NormalizedCorrelationId, RequestId, NormalizedRequestId
UsageData =
    SELECT
        *,
        UsageDataSet_NormalizedCorrelationId AS NormalizedCorrelationId,
        UsageDataSet_CorrelationId AS CorrelationId,
        UsageDataSet_RequestId AS RequestId
    FROM UsageData;

UsageData =
    SELECT
        *,
        (!string.IsNullOrEmpty(RequestId) ? RequestId.ToLowerInvariant().Replace("-", "") : string.Empty) AS NormalizedRequestId
    FROM UsageData;


#DECLARE ConsumptionModeValues = new ARRAY<string>{"hourly,edpsonly", "hourlyfast,edpsonly", "daily,edpsonly"};

    
  #IF(@CopilotUsageViewConsumptionModeStr NOT IN @ConsumptionModeValues)
    #DECLARE ScoreDataStartTime String = @dataStartTime.ToString("yyyy-MM-dd");
    #DECLARE ScoreDataEndTime String = @dataEndTime.ToString("yyyy-MM-dd");

    #DECLARE ScoreDataStartTimeHourly String = @dataStartTime.ToString("yyyy-MM-ddTHH:mm:ss");
    #DECLARE ScoreDataEndTimeHourly String = @dataEndTime.ToString("yyyy-MM-ddTHH:mm:ss");
    
    
                                        ScoreDataDaily = 
                    EXTRACT 
