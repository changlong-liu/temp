	UsageDataSet_UtteranceLength AS UtteranceLength,
	UsageDataSet_IsTestTraffic AS IsTestTraffic,
	UsageDataSet_SSSFlights AS SSSFlights,
	UsageDataSet_SydneyFlights AS SydneyFlights,
	UsageDataSet_IsSearchTriggered AS IsSearchTriggered,
	UsageDataSet_LLMAPITokensCountList AS LLMAPITokensCountList,
	UsageDataSet_Market AS Market,
