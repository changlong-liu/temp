#IF (@Region.Contains("EU"))
    #DECLARE RegionPrefix string = "abfss://filesystem@substrateadlsg2neuprod.dfs.core.windows.net";
#ELSE
    #DECLARE RegionPrefix string = "/shares/exchange.storage.prod";
#ENDIF

 #DECLARE DataSharedPath string = "/local/Projects/DataInsight/DataInsightShare";

REFERENCE @RegionPrefix + @DataSharedPath + "/Microsoft.Bond.dll";
REFERENCE @RegionPrefix + @DataSharedPath + "/Microsoft.Bond.Interfaces.dll";
REFERENCE @RegionPrefix + @DataSharedPath + "/Microsoft.Live.Json.dll";
REFERENCE @RegionPrefix + @DataSharedPath + "/Bond.Attributes.dll";
REFERENCE @RegionPrefix + @DataSharedPath + "/SOTELS.DataInsight.VariantConfig.dll";

#IF (@DataSource != "VariantConfig")
    #ERROR ("The DataSource of 'FlightVariantConfigView' is (VariantConfig). If you want to use the (OWAClientSession) as the datasource, please call the View: 'FlightAssignmentView'");
#ENDIF

#IF (NOT @UsePUIDForConsumerData)
    #ERROR("'UsePUIDForConsumerData' is deprecated as ANID data is not supported anymore");
#ENDIF

