CREATE VIEW FlightVariantConfigView
SCHEMA
(
    UserId : string,
    UserType : string,
    UserIdSpace : string,
    OMSTenantId : string,
    Flights : System.Collections.Generic.List<SOTELS.DataInsight.VariantConfig.DataTypes.Flight>,
    DataSource : string,
    Office365Category : string
)
PARAMS
(
    StartTime string,
    EndTime string,
    Office365Instance string DEFAULT = "worldwide",
    DataSource string DEFAULT = "VariantConfig",
    FlightList string DEFAULT = "",
    UsePUIDForConsumerData bool DEFAULT = true,
    Category string DEFAULT = "Commercial,Consumer",
    AppId string DEFAULT = "",
    AppIdsCaseSensitivity bool DEFAULT = true,
    Region string DEFAULT = "ROW"
)
USING SOTELS.DataInsight.VariantConfig.FlightVC.OfficeFlightVariantConfigResolver(
"ViewName", "FlightVariantConfigView");

//------------------------references--------------------------



