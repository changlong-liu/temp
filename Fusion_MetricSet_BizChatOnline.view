    SSS_Moments_RunAsync_MomentsProvider_MomentsService_Iter1:int?,
    SSS_Moments_RunAsync_MomentsProvider_MomentsService_Iter2:int?,
    UserPerceivedLoadTime:int?,
    InputPaint:int?,
    MetaOsLoad:int?,
    SessionsPaint:int?,
    ZqPaint:int?,
    LuClassification : string,
    ChatMode : string,
    RealTimeConnection_DurationInMs : int?,
    RealTimeConnection_SetupLatencyInMs : int?,
    RealTimeConnection_Status : string,
    ExtensionExecutionFlow_ExtensionNames : string,
    ExtensionExecutionFlow_ExtensionOutcomes : string,
    ExtensionExecutionFlow_Timestamps : string,
    ClientInformation_DeviceOS: string,
    ClientInformation_DeviceType: string,
    UserIdPUID : string,
    EndpointL1 : string,
    EndpointL2 : string,
