    Shadow_SydneyLLMFirstTokenLatency_NullFlag,
    Shadow_SydneyLLMFirstTokenPreFirstTokenResponseModel,
    Shadow_SydneyLLMFirstTokenPreFirstTokenResponseModel_NullFlag,
    Shadow_SydneyLLMFirstTokenPreFirstTokenResponse,
    Shadow_SydneyLLMFirstTokenPreFirstTokenResponse_NullFlag,
    Shadow_LLMCriticalPathFirstTokenResponse,
    Shadow_LLMCriticalPathFirstTokenResponse_NullFlag,
    Shadow_SydneyLLMCriticalPathPreFirstTokenResponseModel,
    Shadow_SydneyLLMCriticalPathPreFirstTokenResponseModel_NullFlag,
    Shadow_LLMInputToken,
    Shadow_LLMInputToken_NullFlag,
    Shadow_LLMInputTokenInvokingFunction,
    Shadow_LLMInputTokenInvokingFunction_NullFlag,
