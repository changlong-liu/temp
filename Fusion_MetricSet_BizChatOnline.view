    MeteringCheckResponse: string,
    ClientLatency: string,
    ChatPlusPages: string,
    ClientInformation: string,
    LLMRequests: string,
    BingRequests : string,
    ProductInformation: string,
    AgentExtendedData: string,
    ToolExecutionDetails: string,
    RaiPoliciesConfiguration: string,
    SafetyRouterTriggered: bool?,
    ScorecardSessionId: string,
    FromCode: string,
    FileExtensions: string,
    IntentSegmentation: string,
    R9Latency : string,
    IsAgentRuntime : bool?,
    AgentRuntime : string,
    PluginInvocations: string,
    Tone : string,
    RealtimeTurnResult : string,
    FeedbackThumbsClicks : string,
    ClientPreferences: string,
    RealtimeTurnPlaybackInterruption: string,
    OfficeCopilot: string,
    RAIClassifiersTriggered: string,
    AgentExtendedDataArray: string,
    Apis: string,
    IsDegradedResponse : bool?,
    DataverseRequests : string,
    SpawnedTaskIds: string,
    VisualInsightsData: string,
    DatasetCategory: string,
    BackgroundTaskData: string,
    TaskId: string,
    LLMGroundingEntities: string,
    ImageSourceBreakdown : string,
    EditableBlockGenerated : string,
    MessageStreamingMetricsExecutionEvent : string,
    SkillsInfo : string,
    ShoppingBerryForwardedProductCount : int?,
    CuaPluginInfo : string,
    LLMRequestsArray : ARRAY<STRUCT<Timestamp: DateTime?, Id:string, LLMModel: string, HttpStatus:string, Latency: double?, TokensCount: STRUCT<CallTag:string, InputTokenType:string, InputTokensCount:long?, OutputTokensCount:long?, CachedTokensCount:long?, ReasoningTokensCount:long?>, LLMModelName: string, ModelClassification: string, SwitcherModelOutput: string, ResolvedModelName: string, LowValueContentMetrics: STRUCT<lowValueContentCharLength:long?, toolsCharLength:long?, totalCharLength:long?, ImagePlaceholderRule:STRUCT<occurrenceCount:long?, totalCharLengthDetected:long?>, DuplicateText:STRUCT<occurrenceCount:long?, totalCharLengthDetected:long?>, SharingHistoryNoise:STRUCT<occurrenceCount:long?, totalCharLengthDetected:long?>, LargeOpaqueUid:STRUCT<occurrenceCount:long?, totalCharLengthDetected:long?>, AllZeroGuid:STRUCT<occurrenceCount:long?, totalCharLengthDetected:long?>, ExcessivePunctuation:STRUCT<occurrenceCount:long?, totalCharLengthDetected:long?>, ExcessiveWhitespace:STRUCT<occurrenceCount:long?, totalCharLengthDetected:long?>>, CacheabilityMetrics: STRUCT<OverallCharSize:long?, StaticPromptCharSize:long?, ToolDefinitionSize:long?, ToolGuidanceSize:long?, InnerMonologueSize:long?>, HttpStatusCode: int?, LlmScenarioId: string, LlmApiType: string, PromptSections: ARRAY<STRUCT<Role:string, Name:string, LengthInChars:int?, SectionKind:string>> >>,

    // CUD Reflection Metrics
    ReflectionMetrics : Microsoft.SCOPE.Types.ScopeMap<string, string>,
    ssr_inferred_score : double?,
    ssr_inferred_success : bool?,
    ssr_inferred_failure : bool?,
    ssr_inferred_insights : System.Collections.Generic.Dictionary<string, string>,

    // VIP identity flags (populated when @ExtraOptions contains "JoinVIPUsersAndTenants")
    IsVIPUser : bool?,
    IsVIPTenant : bool?,

    FromHistory_TurnLevelResponseActionsString: string,
    FromHistory_FeedbackActionList: string,
    FromHistory_TurnCount: int?,

    // Group flights, appended to end after stripping allocation ids
    SydFlights: string,
    sssFlights: string,
    ClientFlights : string,

    // Shadow A/B Specific Columns
    Shadow_E2ENRR : double?,
    Shadow_Availability : double?,
    Shadow_ChatFCFR : int?,
    Shadow_LLMReason : int?,
    Shadow_LLMReasonResponse : int?,
    Shadow_LLMReasonUserQuery : int?,
    Shadow_LLMResponse_FirstToken : int?,
    Shadow_SydneyFCFR : int?,
    Shadow_ChatLCFR : int?,
    Shadow_sssQueryAPI : int?,
    Shadow_SydneyFCFR_NullFlag : int,
    Shadow_ChatFCFR_NullFlag : int,
    Shadow_LLMReason_NullFlag : int,
    Shadow_LLMReasonResponse_NullFlag : int,
    Shadow_LLMReasonUserQuery_NullFlag : int,
    Shadow_LLMResponse_FirstToken_NullFlag : int,
    Shadow_ChatLCFR_NullFlag : int,
    Shadow_sssQueryAPI_NullFlag : int,
    Shadow_SydneyLLMFirstTokenLatency : int?,
    Shadow_SydneyLLMFirstTokenLatency_NullFlag : int,
    Shadow_SydneyLLMFirstTokenPreFirstTokenResponseModel : int?,
    Shadow_SydneyLLMFirstTokenPreFirstTokenResponseModel_NullFlag : int,
    Shadow_SydneyLLMFirstTokenPreFirstTokenResponse : int?,
    Shadow_SydneyLLMFirstTokenPreFirstTokenResponse_NullFlag : int,
    Shadow_LLMCriticalPathFirstTokenResponse : int?,
    Shadow_LLMCriticalPathFirstTokenResponse_NullFlag : int,
    Shadow_SydneyLLMCriticalPathPreFirstTokenResponseModel : int?,
    Shadow_SydneyLLMCriticalPathPreFirstTokenResponseModel_NullFlag : int,
    Shadow_LLMInputToken : int?,
    Shadow_LLMInputToken_NullFlag : int,
    Shadow_LLMInputTokenInvokingFunction : int?,
    Shadow_LLMInputTokenInvokingFunction_NullFlag : int,
    Shadow_LLMInputTokenResponding : int?,
    Shadow_LLMInputTokenResponding_NullFlag : int,
    Shadow_LLMInputTokenInvokingFunction_Responding : int?,
    Shadow_LLMInputTokenInvokingFunction_Responding_NullFlag : int,
    Shadow_IsValidPair : bool,
    // Intersected T/C Flight
    Flight : string
)
PARAMS
(
    StartDateTime string,
    EndDateTime string DEFAULT = "",
    TreatmentAssignmentDataSource string DEFAULT = "odinvariantconfigv2",
    Flights string,
    PropagateFlightToAllTurns bool DEFAULT = false, // Defaults to false, except if TreatmentAssignmentDataSource is metaosflight
    DateTimeFilter bool DEFAULT = true, // Defaults to false, except if TreatmentAssignmentDataSource is metaosflight
    TrafficFiltersDeployRing string DEFAULT = "", // e.g. "WW,SDFV2"
    TrafficFiltersCosmicPartition string DEFAULT = "",
    ManagementGroup string DEFAULT = "",
    Region string DEFAULT = "ROW",  // "ROW" or "EU"
    EchoExperimentName string DEFAULT = "",
    SourceName string DEFAULT = "", //semicolon separated, e.g. "m365chat;teamshub"
    TakeAllIterations bool DEFAULT = false,
    CustomInput string DEFAULT = "",
    JoinType string DEFAULT = "onlyusage",
    StripAllocationIds bool DEFAULT = true,
    IncludeFeedback bool DEFAULT = false,
    IncludeScores bool DEFAULT = false,
    IncludeFastScores bool DEFAULT = false,
    IncludeCatalystTraffic bool DEFAULT = false,
    UseFusionV2 bool DEFAULT = true,
    // Adding new echo override parameter
    IsEchoExperiment bool DEFAULT = false,
    FilterPassiveUsers bool DEFAULT = true,
    MetaOSFilter bool DEFAULT = false,
    ScenarioListFilter string DEFAULT = "*",
    Variant3SFlightOverride bool DEFAULT = false,
    JoinToIDEAsTelemetry bool DEFAULT = false,
    IdeasTelemetrySource string DEFAULT = "All",
    ConsumptionMode string DEFAULT = "Daily",  // Hourly | HourlyFast
    CustomView string DEFAULT = "CUD:PROD",
    IncludeFromHistoryTurns bool DEFAULT = false,
    CopilotProductFilter string DEFAULT = "", // "BizChat-Work|BizChat-Web"
    Environment string DEFAULT = "WW", // WW | GCC
    TenantBased bool DEFAULT = false, // Whether to load score data in tenant-based mode
    ScenarioFilter string DEFAULT = "", // pipe-separated scenario prefixes, e.g. "outlookmobile|unionocm"
    MobileFilter string DEFAULT = "false", // Filter to mobile clients only (iOS, Android), string for ExP managementGroup overrides
    ExtraOptions string DEFAULT = "" // String-based extra options for flags that are easy to extend
)
AS
BEGIN

REFERENCE "BizChatOnlineMetricSetView.dll";
USING BizChatOnlineMetricSetView;

#DECLARE JSONPath = @"/shares/exchange.storage.prod/local/MSAI/CopilotDataFusionViewV2/Newtonsoft.Json.dll";
#IF (@Region.ToLower() == "eu")
    #SET JSONPath = "abfs://filesystem@substrateadlsg2neuprod.dfs.core.windows.net/local/MSAI/CopilotDataFusionViewV2/Newtonsoft.Json.dll";
#ENDIF
REFERENCE @JSONPath;

#SET @@ManagedOperatorChain = true;
    
#IF(@EndDateTime == "")
    #SET EndDateTime = DateTime.SpecifyKind(DateTime.Parse(@StartDateTime),DateTimeKind.Utc).AddDays(1).ToString("yyyy-MM-dd HH:mm:ss");
#ENDIF

// Remove one millisecond to make the date range boundary is non-inclusive on new date.
#SET EndDateTime = DateTime.Parse(@EndDateTime).AddMilliseconds(-1).ToString("yyyy-MM-dd HH:mm:ss");

#IF(@TrafficFiltersCosmicPartition == "{TrafficFilters.Partition}")
    #SET TrafficFiltersCosmicPartition = "";
#ENDIF
#IF(@TrafficFiltersDeployRing == "{TrafficFilters.DeployRing}" || @TrafficFiltersDeployRing == "{TrafficFilters.deploymentring}")
    #SET TrafficFiltersDeployRing = "";
#ENDIF

#IF(@Variant3SFlightOverride)
    #SET ManagementGroup = "3svariantconfig";
#ENDIF

// not iterpolated - set to ""
#IF(!string.IsNullOrEmpty(@ScenarioFilter) && @ScenarioFilter == "{BizChatDataSourceParameterOverrides.ScenarioFilter}")
    #SET ScenarioFilter = "";
#ENDIF

#IF(!string.IsNullOrEmpty(@MobileFilter) && @MobileFilter == "{BizChatDataSourceParameterOverrides.MobileFilter}")
    #SET MobileFilter = "false";
#ENDIF

// SET MANAGEMENT GROUP SPECIFIC PARAMETERS - default to SydneyFlights
#IF(!string.IsNullOrEmpty(@ManagementGroup) && @ManagementGroup != "{ApplicableDataSourceParameterOverrides.ManagementGroup}" && @ManagementGroup != "{BizChatDataSourceParameterOverrides.ManagementGroup}")
    #IF(@ManagementGroup == "o365substratenorthstarsearch" || @ManagementGroup == "3svariantconfig")
        #SET TreatmentAssignmentDataSource = "3sflight";
    #ENDIF
    #IF(@ManagementGroup.ToLower().Contains("client") || @ManagementGroup.ToLower().Contains("mobile"))
        #SET TreatmentAssignmentDataSource = "clientflight";
    #ENDIF
    #IF(@ManagementGroup == "ideas") // set by exp config
        #SET TreatmentAssignmentDataSource = "ideas";
    #ENDIF
#ENDIF

#IF(@JoinToIDEAsTelemetry)
    // datasource boolean override
    SET TreatmentAssignmentDataSource = "ideas";
#ENDIF

#IF(string.IsNullOrEmpty(@IdeasTelemetrySource) || @IdeasTelemetrySource == "{BizChatDataSourceParameterOverrides.IDEAsTelemetrySource}")
    // default to all if not set properly
    #SET IdeasTelemetrySource = "All";
#ENDIF

// SET FLIGHT STRIP ALLOCATION IDS to false by default
#SET StripAllocationIds = false;

// Strip allocation ids from default 3s or echo experiments
#IF((@ManagementGroup == "o365substratenorthstarsearch" && @Variant3SFlightOverride != true) || @IsEchoExperiment)
    #SET StripAllocationIds = true;
#ENDIF

#IF(@StripAllocationIds)
    // set allocation id map
    #DECLARE FlightAllocationMap MAP<string, string> = MAP.Create(@Flights.ToUpper().Split('|').ToDictionary(x => x.Split(':')[0], x => x));
    
    // strip allocation id from 3s flight params
    #SET Flights = string.Join("|", @Flights.ToUpper().Split('|').Select(x => x.Split(':')[0]));
#ENDIF

// Read in FusionV2 RoW/EU Module
#DECLARE CopilotDataFusionViewPath string = "/shares/exchange.storage.prod/local/MSAI/CopilotDataFusionViewV2/CopilotDataFusionModuleRoW.module";
    
#IF (@Region.ToLower() == "eu")
    #SET CopilotDataFusionViewPath = "abfs://filesystem@substrateadlsg2neuprod.dfs.core.windows.net/local/MSAI/CopilotDataFusionViewV2/CopilotDataFusionModuleEU.module";
#ENDIF

MODULE @CopilotDataFusionViewPath AS CDFModule;

data =
    CDFModule.CopilotDataFusionView
    (
        StartDateTime  = @StartDateTime,
        EndDateTime = @EndDateTime,
        Region = @Region,
        AppName = "*",
        Product = "*",
        Scenario = "*",
        ClientAppName = "*",
        ClientPlatform = "*",
        #IF(!string.IsNullOrEmpty(@CustomInput))
        CustomInput = @CustomInput,
        #ENDIF
        FeedbackDataJoinType = "FeedbackDataNotIncluded",
        #IF(@IncludeScores||@IncludeFastScores)
        ScoreDataJoinType = "ScoreRightJoinUsage",
        #IF(@TenantBased) // TODO: Make this default after testing
        ScoreDataLoadingMode="TenantBased",
        #ENDIF
        #ENDIF
        ConsumptionMode = @ConsumptionMode,
        CustomView = @CustomView,
        #IF(@Environment == "GCC")
        DeployRing = @Environment,
        #ENDIF
        JoinType = "onlyusage"
    );

data = SELECT 
    RequestTime.Value AS TIMESTAMP, 
    DeployRing AS DeployRing,
    Region AS Region,
    // TraceId,
    CorrelationId AS CorrelationId,
    TurnLevelCorrelationId AS TurnLevelCorrelationId,
    ChatMode == "Realtime" ? TurnLevelCorrelationId : CorrelationId AS TurnId,
    // MessageId AS MessageId,
    ClientAppName AS Origin, 
    RequestId AS BotRequestId,
    ConversationId AS BotConversationId,
    TurnNumberInConversation.HasValue ? TurnNumberInConversation.Value : 0 AS TotalNumUserMessages, 
    // Source,
    Market AS Market,
    Locale AS Locale,
    // bug workaround for when includeScore returns NumSuggestedResponses as int?
    ((int ?)NumSuggestedResponses) ?? 0 AS NumSuggestedResponses,
    // Offense,
    CosmicPartition AS CosmicPartition,
    AadTenantId AS TenantId,
