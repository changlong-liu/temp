    Shadow_LLMInputTokenResponding_NullFlag,
    Shadow_LLMInputTokenInvokingFunction_Responding,
    Shadow_LLMInputTokenInvokingFunction_Responding_NullFlag,
    Shadow_IsValidPair
    FROM data;
        
#ELSE
    // This is online A/B scorecard so set Shadow columns to null
    data = SELECT * FROM data WHERE !string.IsNullOrEmpty(Flight);

    // Append flights to end
    data = SELECT *.Except(SydFlights, sssFlights, ClientFlights),
                SydFlights,
                sssFlights,
                ClientFlights;
    
    data = SELECT *,
                    (double?)null AS Shadow_E2ENRR,
                    (double?)null AS Shadow_Availability,
                    (int?)null AS Shadow_ChatFCFR,
                    (int?)null AS Shadow_LLMReason,
                    (int?)null AS Shadow_LLMReasonResponse,
                    (int?)null AS Shadow_LLMReasonUserQuery,
                    (int?)null AS Shadow_LLMResponse_FirstToken,
                    (int?)null AS Shadow_SydneyFCFR,
                    (int?)null AS Shadow_ChatLCFR,
                    (int?)null AS Shadow_sssQueryAPI,
                    (int)0 AS Shadow_SydneyFCFR_NullFlag,
                    (int)0 AS Shadow_ChatFCFR_NullFlag,
                    (int)0 AS Shadow_LLMReason_NullFlag,
                    (int)0 AS Shadow_LLMReasonResponse_NullFlag,
                    (int)0 AS Shadow_LLMReasonUserQuery_NullFlag,
                    (int)0 AS Shadow_LLMResponse_FirstToken_NullFlag,
                    (int)0 AS Shadow_ChatLCFR_NullFlag,
                    (int)0 AS Shadow_sssQueryAPI_NullFlag,
                    (int?)null AS Shadow_SydneyLLMFirstTokenLatency,
                    (int)0 AS Shadow_SydneyLLMFirstTokenLatency_NullFlag,
                    (int?)null AS Shadow_SydneyLLMFirstTokenPreFirstTokenResponseModel,
                    (int)0 AS Shadow_SydneyLLMFirstTokenPreFirstTokenResponseModel_NullFlag,
                    (int?)null AS Shadow_SydneyLLMFirstTokenPreFirstTokenResponse,
                    (int)0 AS Shadow_SydneyLLMFirstTokenPreFirstTokenResponse_NullFlag,
                    (int?)null AS Shadow_LLMCriticalPathFirstTokenResponse,
                    (int)0 AS Shadow_LLMCriticalPathFirstTokenResponse_NullFlag,
                    (int?)null AS Shadow_SydneyLLMCriticalPathPreFirstTokenResponseModel,
                    (int)0 AS Shadow_SydneyLLMCriticalPathPreFirstTokenResponseModel_NullFlag,
                    (int?)null AS Shadow_LLMInputToken,
                    (int)0 AS Shadow_LLMInputToken_NullFlag,
                    (int?)null AS Shadow_LLMInputTokenInvokingFunction,
                    (int)0 AS Shadow_LLMInputTokenInvokingFunction_NullFlag,
                    (int?)null AS Shadow_LLMInputTokenResponding,
                    (int)0 AS Shadow_LLMInputTokenResponding_NullFlag,
                    (int?)null AS Shadow_LLMInputTokenInvokingFunction_Responding,
                    (int)0 AS Shadow_LLMInputTokenInvokingFunction_Responding_NullFlag,
                    false AS Shadow_IsValidPair 
            FROM data;
#ENDIF

// Append Flight to end
#IF(@StripAllocationIds)
    // map flights back to flights with allocation ids using FlightAllocationMap
    data = SELECT 
        data.*.Except(Flight),
        @FlightAllocationMap.ContainsKey(Flight) ? @FlightAllocationMap[Flight] : Flight AS Flight
    FROM data;
#ELSE
    data = SELECT 
        data.*.Except(Flight),
        Flight
    FROM data;
#ENDIF

#IF(!string.IsNullOrEmpty(@TrafficFiltersCosmicPartition))
    data = SELECT * FROM data WHERE @TrafficFiltersCosmicPartition.ToUpperInvariant().Split(',').Any(x => CosmicPartition != null && x == CosmicPartition.ToUpperInvariant());
#ENDIF

#IF(!string.IsNullOrEmpty(@TrafficFiltersDeployRing))
    data = SELECT * FROM data WHERE @TrafficFiltersDeployRing.ToUpperInvariant().Split(',').Any(x => x == "SDFV2" ? DeployRing != null && DeployRing.ToUpperInvariant() == "SDF" : (x == "WW" || x == "DONMT") ? DeployRing.ToUpperInvariant() == "PROD" : x == DeployRing.ToUpperInvariant());
#ENDIF

#IF(@ExtraOptions.Contains("JoinVIPUsersAndTenants"))
    // Join VIP identity views (docs: https://ideasehost.microsoft.com/en-us/pages/vip-users-and-vip-tenants).
    // VIPUsers_v1  : (OMSTenantId, UserId, IsVIP), requires HistoryDate
    // VIPTenants_v1: (OMSTenantId, IsVIP),          requires HistoryDate
    // VIP tables are keyed on lower-case AAD ids (Verify pass normalizes with Trim().ToLowerInvariant()),
    // so we lower the left-side keys once before joining.
    // Wiki lists a single External Path for both views (partitions ROW+EUDB are resolved through the
    // /shares/IDEAs.Prod.Data mount); no region-specific abfss form is documented for these views.
    #DECLARE VIPUsersViewPath string = @"/shares/IDEAs.Prod.Data/Publish.Profiles.User.Commercial.VIP.VIPUsers/Views/v1/VIPUsers.view";
    #DECLARE VIPTenantsViewPath string = @"/shares/IDEAs.Prod.Data/Publish.Profiles.Tenant.Commercial.VIP.VIPTenants/Views/v1/VIPTenants.view";
                                            
    vipUsers =
        SELECT UserId, IsVIP
        FROM
        (
            VIEW @VIPUsersViewPath
            PARAMS
            (
                HistoryDate = DateTime.Parse(@StartDateTime)
            )
        );

    vipTenants =
        SELECT OMSTenantId, IsVIP
        FROM
        (
            VIEW @VIPTenantsViewPath
            PARAMS
            (
                HistoryDate = DateTime.Parse(@StartDateTime)
            )
        );

    // Pre-compute lowered join keys once (guarded against null) so downstream LEFT OUTER JOINs match VIP ids.
    // The helper columns _VIPUserIdLower / _VIPTenantIdLower are dropped by the explicit final SELECT below.
    data =
        SELECT data.*,
               string.IsNullOrEmpty(ObjectId) ? null : ObjectId.ToLower() AS _VIPUserIdLower,
               string.IsNullOrEmpty(TenantId)   ? null : TenantId.ToLower()   AS _VIPTenantIdLower
        FROM data;

    data =
        SELECT data.*,
               vipUsers.IsVIP   AS IsVIPUser,
               vipTenants.IsVIP AS IsVIPTenant
        FROM data
            LEFT OUTER JOIN vipUsers   ON data._VIPUserIdLower   == vipUsers.UserId
            LEFT OUTER JOIN vipTenants ON data._VIPTenantIdLower == vipTenants.OMSTenantId;
#ELSE
    // Preserve the static SCHEMA when the option is not set: emit null flags for both columns.
    data =
        SELECT data.*,
               (bool?)null AS IsVIPUser,
               (bool?)null AS IsVIPTenant
        FROM data;
#ENDIF

// Final select to ensure correct column order
data = SELECT 
    TIMESTAMP  AS TIMESTAMP ,
    DeployRing  AS DeployRing ,
