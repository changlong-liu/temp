    TurnType:string,
    OptionVariantsSet:string,
    RequestPerfSegments:string,
    FluxLoopCount:int?,
    ToolTriggerCount:int?,
    ChatFirstTokenRenderedUnaccounted:int?,
    SydneyFirstTokenResponseModelToFirstTokenResponse:int?,
    SydneyFirstTokenResponseToLastTokenResponse:int?,
    SydneyLLMFirstTokenLatency:int?,
    SydneyLLMFirstTokenPreFirstTokenResponseModel:int?,
    SydneyLLMFirstTokenPreFirstTokenResponse:int?,
    SydneyLLMFirstTokenPostFirstTokenResponse:int?,
