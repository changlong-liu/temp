	(int?) null AS LLMCachedContextTokensIterGrt3,
	(double?) null AS LLMCacheHitRateIter1,
	(double?) null AS LLMCacheHitRateIter2,
	(double?) null AS LLMCacheHitRateIterGrt3,
    (string) null AS LLMLatency,
    (int?) null AS SearchPostFirstTokenReponse,
    (int?) null AS SSS_Transcripts_Iter1,
    (int?) null AS SSS_Transcripts_Iter2,
    (int?) null AS SSS_Moments_Iter1,
    (int?) null AS SSS_Moments_Iter2,
    (int?) null AS SSS_Moments_RunAsync_Iter1,
    (int?) null AS SSS_Moments_RunAsync_Iter2,
    (int?) null AS SSS_Moments_RunAsync_MomentsContentProvider_Iter1,
    (int?) null AS SSS_Moments_RunAsync_MomentsContentProvider_Iter2,
    (int?) null AS SSS_Moments_RunAsync_MomentsProvider_Iter1,
    (int?) null AS SSS_Moments_RunAsync_MomentsProvider_Iter2,
    (int?) null AS SSS_Moments_RunAsync_MomentsProvider_MomentsService_Iter1,
    (int?) null AS SSS_Moments_RunAsync_MomentsProvider_MomentsService_Iter2,
    UPLTLatency != null && UPLTLatency.Count != 0 && UPLTLatency.ContainsField("Uplt") ? UPLTLatency.GetField<int?>("Uplt") : (int?) null AS UserPerceivedLoadTime,
    UPLTLatency != null && UPLTLatency.Count != 0 && UPLTLatency.ContainsField("InputPaint") ? UPLTLatency.GetField<int?>("InputPaint") : (int?) null AS InputPaint,
    UPLTLatency != null && UPLTLatency.Count != 0 && UPLTLatency.ContainsField("MetaOsLoad") ? UPLTLatency.GetField<int?>("MetaOsLoad") : (int?) null AS MetaOsLoad,
    UPLTLatency != null && UPLTLatency.Count != 0 && UPLTLatency.ContainsField("SessionsPaint") ? UPLTLatency.GetField<int?>("SessionsPaint") : (int?) null AS SessionsPaint,
    UPLTLatency != null && UPLTLatency.Count != 0 && UPLTLatency.ContainsField("ZqPaint") ? UPLTLatency.GetField<int?>("ZqPaint") : (int?) null AS ZqPaint,
    LuClassification,
    ChatMode,
    RealtimeConnectionResult != null && RealtimeConnectionResult.Count != 0 && RealtimeConnectionResult.ContainsField("ConnectionDurationInMs") ? RealtimeConnectionResult.GetField<int?>("ConnectionDurationInMs") : (int?) null AS RealTimeConnection_DurationInMs,
    RealtimeConnectionResult != null && RealtimeConnectionResult.Count != 0 && RealtimeConnectionResult.ContainsField("ConnectionSetupLatencyInMs") ? RealtimeConnectionResult.GetField<int?>("ConnectionSetupLatencyInMs") : (int?) null AS RealTimeConnection_SetupLatencyInMs,
    RealtimeConnectionResult != null && RealtimeConnectionResult.Count != 0 && RealtimeConnectionResult.ContainsField("Status") ? RealtimeConnectionResult.GetField<string>("Status") : (string) null AS RealTimeConnection_Status,
    // TODO: figure out if we can serialize CUD STRUCTs to JSON without explicitly defining the schema...
    ExtensionExecutionFlow != null && ExtensionExecutionFlow.Count != 0 ? String.Join(",", ExtensionExecutionFlow.Select(x => x.Count != 0 && x.ContainsField("ExtensionName") ? x.GetField<string>("ExtensionName") : (string)null).Where(s => s != (string)null).ToArray()) : (string)null AS ExtensionExecutionFlow_ExtensionNames,
    ExtensionExecutionFlow != null && ExtensionExecutionFlow.Count != 0 ? String.Join(",", ExtensionExecutionFlow.Select(x => x.Count != 0 && x.ContainsField("ExtensionOutCome") ? x.GetField<string>("ExtensionOutCome") : (string)null).Where(s => s != (string)null).ToArray()) : (string)null AS ExtensionExecutionFlow_ExtensionOutcomes,
    ExtensionExecutionFlow != null && ExtensionExecutionFlow.Count != 0 ? String.Join(",", ExtensionExecutionFlow.Select(x => x.Count != 0 && x.ContainsField("TimeStamp") ? x.GetField<string>("TimeStamp") : (string)null).Where(s => s != (string)null).ToArray()) : (string)null AS ExtensionExecutionFlow_Timestamps,
    ClientInformation != null && ClientInformation.Count != 0 && ClientInformation.ContainsField("DeviceOS") ? ClientInformation.GetField<string>("DeviceOS") : (string)null AS ClientInformation_DeviceOS,
    ClientInformation != null && ClientInformation.Count != 0 && ClientInformation.ContainsField("DeviceType") ? ClientInformation.GetField<string>("DeviceType") : (string)null AS ClientInformation_DeviceType,
    UserIdPUID,
    DWD_DIM_Mapping_Endpoint.Get_DIM_EndpointLevel1(AppName, Product, AppFlavor, ClientPlatform, Scenario, "") AS EndpointL1,
    DWD_DIM_Mapping_Endpoint.Get_DIM_EndpointLevel2(AppName, Product, AppFlavor, ClientPlatform, Scenario, "") AS EndpointL2,
    MyReaderHelper.FromCustomInstructionUpsertResultStructToString(CustomInstructionUpsertResult) AS CustomInstructionUpsertResult,
    MyReaderHelper.FromPersonalizationSettingsStructArrayToString(PersonalizationSettings) AS PersonalizationSettings,
    MyReaderHelper.FromSkdsMetricsStructArrayToString(SkdsMetrics) AS SkdsMetrics,
    MyReaderHelper.FromSSSRequestStructArrayToString(SSSRequests) AS SSSRequests,
    MyReaderHelper.GetSydneyLatency(SydneyLatency) AS SydneyLatency,
    MyReaderHelper.GetMeteringCheckResponse(MeteringCheckResponse) AS MeteringCheckResponse,
    MyReaderHelper.GetClientLatency(ClientLatency) AS ClientLatency,
    MyReaderHelper.FromChatPlusPagesStructArrayToString(ChatPlusPages) AS ChatPlusPages,
    MyReaderHelper.FromClientInformationStructToString(ClientInformation) AS ClientInformation,
    MyReaderHelper.FromLLMRequestsStructArrayToString(LLMRequests) AS LLMRequests,
    MyReaderHelper.FromBingRequestsToString(BingRequests) AS BingRequests,
    MyReaderHelper.FromProductInformationStructToString(ProductInformation) AS ProductInformation,
    DeclaritiveCopilotExtendedData AS AgentExtendedData,
    MyReaderHelper.FromToolExecutionDetailsToString(ToolExecutionDetails) AS ToolExecutionDetails,
    MyReaderHelper.FromRaiPoliciesConfigurationStructToString(RaiPoliciesConfiguration) AS RaiPoliciesConfiguration,
    SafetyRouterTriggered,
    // If server sessions are requested and the scorecard is not passive, use ComputedServerSessionId; otherwise use ClientSessionId.
    // Both session modifiers populate the computed ID, while the CUD view selects SStream vs cutoff-split Parquet.
    @FilterPassiveUsers && @ConsumptionMode.ToUpperInvariant().Contains("INCLUDESERVERSESSIONID") ? ComputedServerSessionId : ClientSessionId AS ScorecardSessionId,
    FromCode,
    FileExtensions,
    MyReaderHelper.FromIntentSegmentationArrayToString(IntentSegmentation) AS IntentSegmentation,
    MyReaderHelper.FromR9LatencyStructToString(R9Latency) AS R9Latency,
    IsAgentRuntime,
    AgentRuntime,
    PluginInvocations,
    Tone,
    MyReaderHelper.FromRealtimeTurnResultStructToString(RealtimeTurnResult) AS RealtimeTurnResult,
    MyReaderHelper.FromFeedbackThumbsClicksStructToString(FeedbackThumbsClicks) AS FeedbackThumbsClicks,
    MyReaderHelper.FromClientPreferencesStructToString(ClientPreferences) AS ClientPreferences,
    MyReaderHelper.FromRealtimeTurnPlaybackInterruptionStructToString(RealtimeTurnPlaybackInterruption) AS RealtimeTurnPlaybackInterruption,
    MyReaderHelper.FromOfficeCopilotStructToString(OfficeCopilot) AS OfficeCopilot,
    MyReaderHelper.FromRAIClassifiersTriggeredStructToString(RAIClassifiersTriggered) AS RAIClassifiersTriggered,
    MyReaderHelper.FromAgentExtendedDataArrayToString(AgentExtendedData) AS AgentExtendedDataArray,
    MyReaderHelper.FromArrayToString(Apis) AS Apis,
    IsDegradedResponse,
    MyReaderHelper.FromDataverseRequestsToString(DataverseRequests) AS DataverseRequests,
    MyReaderHelper.FromArrayToString(SpawnedTaskIds) AS SpawnedTaskIds,
    MyReaderHelper.FromVisualInsightsDataStructToString(VisualInsightsData) AS VisualInsightsData,
    DatasetCategory,
    MyReaderHelper.FromBackgroundTaskDataStructToString(BackgroundTaskData) AS BackgroundTaskData,
    BackgroundTaskData IS NOT NULL ? BackgroundTaskData.TaskId : NULL AS TaskId,
    MyReaderHelper.FromLLMGroundingEntitiesToString(LLMGroundingEntities) AS LLMGroundingEntities,
    ReflectionMetricsStringMap,
    MyReaderHelper.FromImageSourceBreakdownStructToString(ImageSourceBreakdown) AS ImageSourceBreakdown,
    MyReaderHelper.FromEditableBlockGeneratedStructArrayToString(EditableBlockGenerated) AS EditableBlockGenerated,
    MyReaderHelper.FromMessageStreamingMetricsExecutionEventStructToString(MessageStreamingMetricsExecutionEvent) AS MessageStreamingMetricsExecutionEvent,
    MyReaderHelper.FromSkillsInfoStructArrayToString(SkillsInfo) AS SkillsInfo,
    ShoppingBerryForwardedProductCount,
    MyReaderHelper.FromCuaPluginInfoStructArrayToString(CuaPluginInfo) AS CuaPluginInfo,
    LLMRequests AS LLMRequestsArray

    WHERE
        (RequestTime.HasValue AND IsDevMode != true)
        AND (IsTestTraffic != true OR (IsTestTraffic == true AND IsEchoTraffic == true))
#IF(@IsEchoExperiment == false)
        AND (IsEchoTraffic != true)
#ENDIF
    FROM data;

data = SELECT *
    #IF(@FilterPassiveUsers)
    WHERE 
        #IF(@ExtraOptions.Contains("IncludeAsyncTask"))
        (TurnType == "Active" || TurnType == "FromHistory" || TurnType == "AsyncTask")
        #ELSEIF(@IncludeFromHistoryTurns)
        (TurnType == "Active" || TurnType == "FromHistory")
        #ELSE
        (TurnType == "Active")
        #ENDIF
        && !string.IsNullOrEmpty(CorrelationId)
        && !string.IsNullOrEmpty(ObjectId)
        && !string.IsNullOrEmpty(BotConversationId)
        && !string.IsNullOrEmpty(Scenario)
        && !string.IsNullOrEmpty(Product)
        && !string.IsNullOrEmpty(AppName)
    #ENDIF
    FROM data;

#IF(@IncludeFromHistoryTurns)
    history_data = SELECT 
        TurnLevelCorrelationId,
        !string.IsNullOrEmpty(TurnLevelResponseActionsString) ? TurnLevelResponseActionsString : "" AS TurnLevelResponseActionsString,
        !string.IsNullOrEmpty(TurnLevelSystemActionsString) ? TurnLevelSystemActionsString : "" AS TurnLevelSystemActionsString,
        (string)null AS CopilotFeedbackData_FeedbackActionList
        FROM data
        WHERE (TurnType == "FromHistory")
        AND !string.IsNullOrEmpty(TurnLevelCorrelationId);
#ENDIF

// Filter out sidepane scenarios if we're not joining to catalyst
#IF(@TreatmentAssignmentDataSource != "ideas" && !@IncludeCatalystTraffic)
    data = SELECT * FROM data
    WHERE !Scenario.ToLower().Contains("sidepane");
#ENDIF

#IF(@CopilotProductFilter != "")
    data = SELECT * FROM data
    WHERE CopilotProduct.ToLower() == @CopilotProductFilter.ToLower();
#ENDIF

#IF(@IncludeFromHistoryTurns)
    active_data = SELECT * FROM data
        WHERE (TurnType == "Active" || TurnType == "AsyncTask");
    
    history_data = SELECT
        TurnLevelCorrelationId,
        string.Join(";" , LIST(TurnLevelResponseActionsString)) AS FromHistory_TurnLevelResponseActionsString,
        string.Join(";" , LIST(TurnLevelSystemActionsString)) AS FromHistory_TurnLevelSystemActionsString,
        (int)COUNT() AS FromHistory_TurnCount
        FROM history_data
        GROUP BY TurnLevelCorrelationId;
    
    data = SELECT
        data.*.Except(TurnLevelResponseActionsString,TurnLevelSystemActionsString),
        #IF(@ExtraOptions.Contains("MergeResponseActionList"))
        MyReaderHelper.MergeActionLists(data.TurnLevelResponseActionsString, history_data.FromHistory_TurnLevelResponseActionsString) AS TurnLevelResponseActionsString,
        #ELSE
        TurnLevelResponseActionsString,
        #ENDIF
        #IF(@ExtraOptions.Contains("MergeSystemActionList"))
        MyReaderHelper.MergeActionLists(data.TurnLevelSystemActionsString, history_data.FromHistory_TurnLevelSystemActionsString) AS TurnLevelSystemActionsString,
        #ELSE
        TurnLevelSystemActionsString,
        #ENDIF
        history_data.FromHistory_TurnLevelResponseActionsString,
        history_data.FromHistory_TurnLevelSystemActionsString,
        (string)null AS FromHistory_FeedbackActionList,
        history_data.FromHistory_TurnCount
        FROM active_data AS data
        LEFT JOIN history_data ON history_data.TurnLevelCorrelationId == data.TurnLevelCorrelationId;
#ELSE
    data = SELECT *,
            (string)null AS FromHistory_TurnLevelResponseActionsString,
            (string)null AS FromHistory_TurnLevelSystemActionsString,
            (string)null AS FromHistory_FeedbackActionList,
            (int?)null AS FromHistory_TurnCount
           FROM data;
#ENDIF

#IF((@TreatmentAssignmentDataSource == "ideas"  || @Variant3SFlightOverride)) 
    // potentially map oid to useridpuid for both IDEAs and Variant3SFlightOverride
     #IF (!@FilterPassiveUsers)
        // Map Oid to UserIdPUID for Passive Users
        #DECLARE IDEAsCommercialUserProfile_path string = "/shares/IDEAs.Prod.Data/Publish.Profiles.User.Commercial.IDEAsCommercialUserProfile/Views/v3/IDEAsCommercialUserProfile.view";
    
         #IF (@Region.ToLower() == "eu")
            #SET IDEAsCommercialUserProfile_path = "abfss://shares@ideasneuprodsharetorus.dfs.core.windows.net/Publish.Profiles.User.Commercial.IDEAsCommercialUserProfile/link/Views/v3/IDEAsCommercialUserProfile.view";
         #ENDIF
 
        ideasUsers =
            SELECT
                UserObjectId,
                OrgIdPUIDHex
            FROM
            (
                VIEW @IDEAsCommercialUserProfile_path
                PARAMS
                (
                    HistoryDate = DateTime.Parse(@StartDateTime)
                )
            );

        data = 
            SELECT
                data.*,
                ideasUsers.OrgIdPUIDHex.ToLower() AS UserIdPuid_Lower
            FROM data
            INNER JOIN ideasUsers ON ideasUsers.UserObjectId == data.ObjectId;
    #ELSE 

    data = 
        SELECT *,
        data.UserIdPUID.ToLower() AS UserIdPuid_Lower
        FROM data
        WHERE !string.IsNullOrEmpty(data.UserIdPUID);
    #ENDIF
#ENDIF

#IF(@TreatmentAssignmentDataSource == "3sflight" && @Variant3SFlightOverride)

    #DECLARE flightVariantConfigViewPath string = "/shares/exchange.storage.prod/local/Projects/DataInsight/Views/VariantConfig/FlightVariantConfigView.view";
    #IF (@Region.ToLower() == "eu")
        #SET flightVariantConfigViewPath = "abfss://filesystem@substrateadlsg2neuprod.dfs.core.windows.net/local/Projects/DataInsight/Views/VariantConfig/FlightVariantConfigView.view";
    #ENDIF
    
    // commercial 

    commercialTreatmentAssignment =
        SELECT 
            Office365Category,
            UserId AS ExperimentalUnitId,
            Flights,
            OMSTenantId,
            (DateTime?)null AS StreamDate
        FROM
        (
            VIEW @flightVariantConfigViewPath
            PARAMS
            (
                StartTime = DateTime.Parse(@StartDateTime).ToString("yyyy-MM-dd"),
                EndTime = DateTime.Parse(@EndDateTime).ToString("yyyy-MM-dd"),
                Office365Instance = "worldwide",
                FlightList = @Flights.ToUpper(),
                Category = "Commercial",
                AppId = "Search",
                Region = @Region.ToUpper()
            )
        );

    // Filter out empty user Ids and users with > 1 flight
    commercialTreatmentAssignment =
        SELECT 
            *.Except(Flights),
            Flights.GroupBy(x => x.FlightName).Select(x => new System.Collections.Generic.KeyValuePair<string, DateTime>(x.Key, x.Select(f => f.MinTime).Min())).ToList() AS Flights
        FROM commercialTreatmentAssignment;

    commercialTreatmentAssignment =
        SELECT 
            Office365Category,
            ExperimentalUnitId,
            Flights[0].Key AS Flight,
            OMSTenantId,
            ((DateTime?)Flights[0].Value) AS Timestamp,
            StreamDate
        FROM commercialTreatmentAssignment
        WHERE(NOT String.IsNullOrEmpty(ExperimentalUnitId)) AND Flights.Count == 1;

    commercialTreatmentAssignment =
        SELECT 
            *.Except(StreamDate),
            IF(StreamDate == null && Timestamp != null, (DateTime?)Timestamp, (DateTime?)StreamDate) AS StreamDate
    FROM commercialTreatmentAssignment;
        
    commercialTreatmentAssignment = SELECT *,
                    ExperimentalUnitId.ToLower() AS ExperimentalUnitId_Lower
                    FROM commercialTreatmentAssignment;

    commercialData =
        SELECT
            data.*,
            commercialTreatmentAssignment.Flight AS VariantFlights,
            commercialTreatmentAssignment.Timestamp.Value.AddSeconds(-1) AS FlightFirstSeen
        FROM commercialTreatmentAssignment
        INNER HASH JOIN data ON (commercialTreatmentAssignment.ExperimentalUnitId_Lower == data.UserIdPuid_Lower AND commercialTreatmentAssignment.OMSTenantId == data.TenantId)
        WHERE commercialTreatmentAssignment.Timestamp.HasValue && data.DatasetCategory != "consumer"
        HAVING TIMESTAMP >= FlightFirstSeen;

    // consumer

       consumerTreatmentAssignment =
        SELECT 
            Office365Category,
            UserId AS ExperimentalUnitId,
            Flights,
            OMSTenantId,
            (DateTime?)null AS StreamDate
        FROM
        (
            VIEW @flightVariantConfigViewPath
            PARAMS
            (
                StartTime = DateTime.Parse(@StartDateTime).ToString("yyyy-MM-dd"),
                EndTime = DateTime.Parse(@EndDateTime).ToString("yyyy-MM-dd"),
                Office365Instance = "worldwide",
                FlightList = @Flights.ToUpper(),
                Category = "Consumer",
                AppId = "Search",
                Region = @Region.ToUpper()
            )
        );

    // Filter out empty user Ids and users with > 1 flight
    consumerTreatmentAssignment =
        SELECT 
            *.Except(Flights),
            Flights.GroupBy(x => x.FlightName).Select(x => new System.Collections.Generic.KeyValuePair<string, DateTime>(x.Key, x.Select(f => f.MinTime).Min())).ToList() AS Flights
        FROM consumerTreatmentAssignment;

    consumerTreatmentAssignment =
        SELECT 
            Office365Category,
            ExperimentalUnitId,
            Flights[0].Key AS Flight,
            OMSTenantId,
            ((DateTime?)Flights[0].Value) AS Timestamp,
            StreamDate
        FROM consumerTreatmentAssignment
        WHERE(NOT String.IsNullOrEmpty(ExperimentalUnitId)) AND Flights.Count == 1;

    consumerTreatmentAssignment = SELECT 
            *.Except(StreamDate),
            IF(StreamDate == null && Timestamp != null, (DateTime?)Timestamp, (DateTime?)StreamDate) AS StreamDate
    FROM consumerTreatmentAssignment;
        
    consumerTreatmentAssignment = SELECT *,
                    ExperimentalUnitId.ToLower() AS ExperimentalUnitId_Lower
                    FROM consumerTreatmentAssignment;

    consumerData =
        SELECT
            data.*,
            consumerTreatmentAssignment.Flight AS VariantFlights,
            consumerTreatmentAssignment.Timestamp.Value.AddSeconds(-1) AS FlightFirstSeen
        FROM consumerTreatmentAssignment
        INNER JOIN data ON (consumerTreatmentAssignment.ExperimentalUnitId_Lower == data.UserIdPuid_Lower)
        WHERE consumerTreatmentAssignment.Timestamp.HasValue && data.DatasetCategory != "commercial"
        HAVING TIMESTAMP >= FlightFirstSeen;

    // union (UNION ALL: commercial/consumer branches are disjoint, and UNION dedup fails on the MAP<string,string> ReflectionMetricsStringMap column)
    data = SELECT *.Except(sssFlights, VariantFlights,FlightFirstSeen, UserIdPuid_Lower), VariantFlights AS sssFlights FROM commercialData
              UNION ALL
            SELECT *.Except(sssFlights, VariantFlights,FlightFirstSeen, UserIdPuid_Lower), VariantFlights AS sssFlights FROM consumerData;

#ENDIF

#IF(@TreatmentAssignmentDataSource == "ideas" )

    #IF(EXISTS("/shares/IDEAs.Prod.Data/Publish/Acquisitions/User/Commercial/Experimentation/UserFlights/OrgIdPuidFlightMapping/Views/v1/OrgIdPuidFlightMapping.view"))
        #DECLARE OrgIdPuidFlightMappingView string = "/shares/IDEAs.Prod.Data/Publish/Acquisitions/User/Commercial/Experimentation/UserFlights/OrgIdPuidFlightMapping/Views/v1/OrgIdPuidFlightMapping.view";
    #ELSE
       #DECLARE OrgIdPuidFlightMappingView string = "/shares/IDEAs.Prod.Data/Publish.Acquisitions.User.Commercial.Experimentation.UserFlights.OrgIdPuidFlightMapping/Views/v1/OrgIdPuidFlightMapping.view"; 
    #ENDIF
    
    #IF (@Region.ToLower() == "eu")
        #IF(EXISTS("abfss://assets@ideasneuproddata.dfs.core.windows.net/local/Publish/Acquisitions/User/Commercial/Experimentation/UserFlights/OrgIdPuidFlightMapping/Views/v1/OrgIdPuidFlightMapping.view"))
            #SET OrgIdPuidFlightMappingView = "abfss://assets@ideasneuproddata.dfs.core.windows.net/local/Publish/Acquisitions/User/Commercial/Experimentation/UserFlights/OrgIdPuidFlightMapping/Views/v1/OrgIdPuidFlightMapping.view";
        #ELSEIF(EXISTS("abfss://assets@ideasneuproddata.dfs.core.windows.net/local/Publish.Acquisitions.User.Commercial.Experimentation.UserFlights.OrgIdPuidFlightMapping/Views/v1/OrgIdPuidFlightMapping.view"))
            #SET OrgIdPuidFlightMappingView = "abfss://assets@ideasneuproddata.dfs.core.windows.net/local/Publish.Acquisitions.User.Commercial.Experimentation.UserFlights.OrgIdPuidFlightMapping/Views/v1/OrgIdPuidFlightMapping.view";
        #ELSE
            #SET OrgIdPuidFlightMappingView = "abfss://shares@ideasneuprodsharetorus.dfs.core.windows.net/Publish.Acquisitions.User.Commercial.Experimentation.UserFlights.OrgIdPuidFlightMapping/link/Views/v1/OrgIdPuidFlightMapping.view";
        #ENDIF
    #ENDIF

    treatmentAssignment = 
        SELECT OrgIdPUID.ToLower() AS OrgIdPuid_Lower,
        FlightId.ToUpper() AS FlightId
        FROM 
        (
            VIEW @OrgIdPuidFlightMappingView
            PARAMS
            (
                StartTime =  DateTime.Parse(@StartDateTime),
                EndTime = DateTime.Parse(@EndDateTime).AddMinutes(1), // Add a minute to the end time to keep date in IDEAs
                TelemetrySource = @IdeasTelemetrySource
            )
        )
        WHERE !string.IsNullOrEmpty(OrgIdPUID) AND !string.IsNullOrEmpty(FlightId);

    data = SELECT 
        data.*.Except(UserIdPuid_Lower), 
        treatmentAssignment.FlightId AS VariantFlights
    FROM treatmentAssignment
    INNER JOIN data ON treatmentAssignment.OrgIdPuid_Lower == data.UserIdPuid_Lower;

    data = SELECT *.Except(VariantFlights), VariantFlights AS IdeasFlights FROM data;

#ENDIF


// output each full flight stream as flight
data = SELECT 
    #IF(@TreatmentAssignmentDataSource == "ideas")
        *.Except(IdeasFlights),
    #ELSE
        *,
    #ENDIF
    #IF(@TreatmentAssignmentDataSource == "3sflight") 
        sssFlights AS Flight
    #ELSEIF(@TreatmentAssignmentDataSource == "clientflight")
        ClientFlights AS Flight
    #ELSEIF(@TreatmentAssignmentDataSource == "ideas")
        IdeasFlights AS Flight
    #ELSE
        SydFlights AS Flight
    #ENDIF
FROM data;

// deal with default 3S flight stream in CUD not having allocation ids
#IF( @Variant3SFlightOverride != true && @TreatmentAssignmentDataSource == "3sflight")
    // intersect stripped flight parameter with 3S flights in data
    data = SELECT 
    *.Except(Flight),
    @Flights.ToUpper().Split('|').Intersect(
        !string.IsNullOrEmpty(sssFlights) ? sssFlights.ToUpper().Split(',') : new string[0]
    ).Count() == 1 ? @Flights.ToUpper().Split('|').Intersect(sssFlights.ToUpper().Split(',')).First() : "" AS Flight
    FROM data;

#ENDIF

// ManagementGroup specific filtering
#IF(@ManagementGroup == "m365chatclient" || @MetaOSFilter)
    // ToDo: get rid of this and add as parameter for ScenarioListFilter in metaos override
    data = SELECT * FROM data WHERE AppName.ToLower() == "m365chatclient";
#ELSEIF(@ManagementGroup == "unionocmclient")
    data = SELECT * FROM data WHERE Scenario.StartsWith("unionocm", StringComparison.OrdinalIgnoreCase);
#ELSEIF(@ManagementGroup == "outlookmobile")
    data = SELECT * FROM data WHERE Scenario.StartsWith("outlookmobile", StringComparison.OrdinalIgnoreCase);
#ELSEIF(@ManagementGroup == "teamsmobile")
    data = SELECT * FROM data WHERE Scenario.StartsWith("teams", StringComparison.OrdinalIgnoreCase) AND (!string.IsNullOrEmpty(ClientPlatform) && ClientPlatform.ToLower() IN ("ios", "android"));
#ENDIF

// ScenarioFilter: pipe-separated scenario prefixes
#IF(!string.IsNullOrEmpty(@ScenarioFilter))
    data = SELECT * FROM data
    WHERE @ScenarioFilter.Split('|').Any(prefix => Scenario.StartsWith(prefix, StringComparison.OrdinalIgnoreCase));
#ENDIF

// MobileFilter: restrict to mobile clients
#IF(@MobileFilter == "true")
    data = SELECT * FROM data
    WHERE !string.IsNullOrEmpty(ClientPlatform) && ClientPlatform.ToLower() IN ("ios", "android");
#ENDIF

// If a user is on the flight on any turn, include all their turns
#IF (@PropagateFlightToAllTurns)

    // Get userid, min timestamp, and max flight, group by user
    OidFlightInfo=
    SELECT
        ObjectId,
        MAX(Flight) AS Flight,
        MIN(TIMESTAMP) AS MinTimestampForFlightAssigned
    FROM
        data
    WHERE !string.IsNullOrEmpty(Flight)
    GROUP BY
        ObjectId;

    data =
        SELECT
            data.*.Except(Flight),
            OidFlightInfo.Flight AS Flight
        FROM
            data
        LEFT JOIN
            OidFlightInfo
        ON
            data.ObjectId == OidFlightInfo.ObjectId
        #IF (@DateTimeFilter)
        WHERE DateTime.Compare(MinTimestampForFlightAssigned.GetValueOrDefault(), TIMESTAMP) <= 0
        #ENDIF
    ;
#ENDIF

// SHADOW EXPERIMENT LOGIC - Dependent on IsEchoTraffic = true AND presence of ShadowOverrideFlights
#IF(@IsEchoExperiment)

    data = SELECT *.Except(ChatFirstTokenRenderedUnaccounted, SydneyFirstTokenResponseModelToFirstTokenResponse,
                           SydneyFirstTokenResponseToLastTokenResponse, 
                           SydneyLLMFirstTokenPostFirstTokenResponse, SydneyLLMFirstVisibleToken, SydneyLLMFirstVisibleTokenPreFirstTokenResponseModel,
                           SydneyLLMFirstVisibleTokenPreFirstTokenResponse, SydneyLLMFirstVisibleTokenPostFirstTokenResponse,    
                           SydneyLLMCriticalPathPostFirstTokenResponse, SydneyLLMRespondingTokenStream, SydneyLLMRespondingTokenStreamPreFirstTokenResponseModel,
                           SydneyLLMRespondingTokenStreamPreFirstTokenResponse, SydneyLLMRespondingTokenStreamPostFirstTokenResponse,
                           SydneyLLMToolInvocationTokenStream, SydneyLLMToolInvocationTokenStreamPreFirstTokenResponseModel,
                           SydneyLLMToolInvocationTokenStreamPreFirstTokenResponse, SydneyLLMToolInvocationTokenStreamPostFirstTokenResponse,
                           
                           SearchPostFirstTokenReponse, SSS_Transcripts_Iter1, SSS_Transcripts_Iter2, SSS_Moments_Iter1, SSS_Moments_Iter2,
                           SSS_Moments_RunAsync_Iter1, SSS_Moments_RunAsync_Iter2, SSS_Moments_RunAsync_MomentsContentProvider_Iter1,
                           SSS_Moments_RunAsync_MomentsContentProvider_Iter2, SSS_Moments_RunAsync_MomentsProvider_Iter1,
                           SSS_Moments_RunAsync_MomentsProvider_Iter2, SSS_Moments_RunAsync_MomentsProvider_MomentsService_Iter1,
                           SSS_Moments_RunAsync_MomentsProvider_MomentsService_Iter2, UserPerceivedLoadTime, InputPaint, MetaOsLoad, SessionsPaint, ZqPaint)
            FROM data;

    data = SELECT *.Except(Flight),
        @Flights.ToUpper().Split('|').Intersect(
                !string.IsNullOrEmpty(ShadowOverrideFlights) ? ShadowOverrideFlights.ToUpper().Split(',') : new string[0]
            ).Count() == 1 ? @Flights.ToUpper().Split('|').Intersect(ShadowOverrideFlights.ToUpper().Split(',')).First() : "" AS Flight    
    FROM data;

    // Complex SCOPE types cannot participate in SELECT DISTINCT, so remove the typed array and serialize the map for echo processing.
    data =
        SELECT *.Except(ReflectionMetricsStringMap, LLMRequestsArray),
               MyReaderHelper.SerializeReflectionMetrics(ReflectionMetricsStringMap) AS ReflectionMetricsStringMapJson
        FROM data;

    EchoTraffic1 = SELECT DISTINCT *, CorrelationId.Substring(0, CorrelationId.IndexOf(":") >= 0 ? CorrelationId.IndexOf(":") : CorrelationId.Length) AS EchoCorrelationId
            FROM data WHERE !string.IsNullOrEmpty(Flight) AND Flight.ToUpper().Contains("DOUBLEFORKCONTROL");

    EchoTraffic2 = SELECT DISTINCT *, CorrelationId.Substring(0, CorrelationId.IndexOf(":") >= 0 ? CorrelationId.IndexOf(":") : CorrelationId.Length) AS EchoCorrelationId
            FROM data WHERE !string.IsNullOrEmpty(Flight) AND Flight.ToUpper().Contains("DOUBLEFORKTREATMENT");

    EchoTraffic12 = SELECT EchoTraffic1.*.Except(EchoCorrelationId,IsEchoTraffic),
            EchoTraffic1.IsEchoTraffic, 
            // PAIRED COLUMNS
            (string.IsNullOrEmpty(EchoTraffic1.NoApologyDetectedState) ? (double?)null : 0) AS Shadow_E2ENRR,
            (string.IsNullOrEmpty(EchoTraffic1.AvailabilityState) ? (double?)null : 0) AS Shadow_Availability,             
            0.0 AS Shadow_ChatFCFRExcludesSameValueBetweenProdAndEcho,             
            IF(EchoTraffic1.SydneyFCFR_R9 != NULL, 0, EchoTraffic1.SydneyFCFR_R9) AS Shadow_SydneyFCFR,
            IF(EchoTraffic1.SydneyFCFR_R9 == NULL || EchoTraffic2.SydneyFCFR_R9 == NULL, 1, 0) AS Shadow_SydneyFCFR_NullFlag,                         
            IF(EchoTraffic1.ChatFCFR_R9 != NULL, 0, EchoTraffic1.ChatFCFR_R9) AS Shadow_ChatFCFR,
            IF(EchoTraffic1.ChatFCFR_R9 == NULL || EchoTraffic2.ChatFCFR_R9 == NULL, 1, 0) AS Shadow_ChatFCFR_NullFlag,             
            IF(EchoTraffic1.LLMReason != NULL, 0, EchoTraffic1.LLMReason) AS Shadow_LLMReason,   
            IF(EchoTraffic1.LLMReason == NULL || EchoTraffic2.LLMReason == NULL, 1, 0) AS Shadow_LLMReason_NullFlag,            
            IF(EchoTraffic1.LLMReasonResponse != NULL, 0, EchoTraffic1.LLMReasonResponse) AS Shadow_LLMReasonResponse,             
            IF(EchoTraffic1.LLMReasonResponse == NULL || EchoTraffic2.LLMReasonResponse == NULL, 1, 0) AS Shadow_LLMReasonResponse_NullFlag,
            IF(EchoTraffic1.LLMReasonUserQuery != NULL, 0, EchoTraffic1.LLMReasonUserQuery) AS Shadow_LLMReasonUserQuery,               
            IF(EchoTraffic1.LLMReasonUserQuery == NULL || EchoTraffic2.LLMReasonUserQuery == NULL, 1, 0) AS Shadow_LLMReasonUserQuery_NullFlag,
            IF(EchoTraffic1.LLMResponse_FirstToken != NULL, 0, EchoTraffic1.LLMResponse_FirstToken) AS Shadow_LLMResponse_FirstToken,             
            IF(EchoTraffic1.LLMResponse_FirstToken == NULL || EchoTraffic2.LLMResponse_FirstToken == NULL, 1, 0) AS Shadow_LLMResponse_FirstToken_NullFlag,
            IF(EchoTraffic1.ChatLCFR_R9 != NULL, 0, EchoTraffic1.ChatLCFR_R9) AS Shadow_ChatLCFR,  
            IF(EchoTraffic1.ChatLCFR_R9 == NULL || EchoTraffic2.ChatLCFR_R9 == NULL, 1, 0) AS Shadow_ChatLCFR_NullFlag,
            IF(EchoTraffic1.sssQueryAPI != NULL, 0, EchoTraffic1.sssQueryAPI) AS Shadow_sssQueryAPI,
            IF(EchoTraffic1.sssQueryAPI == NULL || EchoTraffic2.sssQueryAPI == NULL, 1, 0) AS Shadow_sssQueryAPI_NullFlag,
            IF(EchoTraffic1.SydneyLLMFirstTokenLatency != NULL, 0, EchoTraffic1.SydneyLLMFirstTokenLatency) AS Shadow_SydneyLLMFirstTokenLatency,
            IF(EchoTraffic1.SydneyLLMFirstTokenLatency == NULL || EchoTraffic2.SydneyLLMFirstTokenLatency == NULL, 1, 0) AS Shadow_SydneyLLMFirstTokenLatency_NullFlag,
            IF(EchoTraffic1.SydneyLLMFirstTokenPreFirstTokenResponseModel != NULL, 0, EchoTraffic1.SydneyLLMFirstTokenPreFirstTokenResponseModel) AS Shadow_SydneyLLMFirstTokenPreFirstTokenResponseModel,
            IF(EchoTraffic1.SydneyLLMFirstTokenPreFirstTokenResponseModel == NULL || EchoTraffic2.SydneyLLMFirstTokenPreFirstTokenResponseModel == NULL, 1, 0) AS Shadow_SydneyLLMFirstTokenPreFirstTokenResponseModel_NullFlag,
            IF(EchoTraffic1.SydneyLLMFirstTokenPreFirstTokenResponse != NULL, 0, EchoTraffic1.SydneyLLMFirstTokenPreFirstTokenResponse) AS Shadow_SydneyLLMFirstTokenPreFirstTokenResponse,
            IF(EchoTraffic1.SydneyLLMFirstTokenPreFirstTokenResponse == NULL || EchoTraffic2.SydneyLLMFirstTokenPreFirstTokenResponse == NULL, 1, 0) AS Shadow_SydneyLLMFirstTokenPreFirstTokenResponse_NullFlag,
            IF(EchoTraffic1.SydneyLLMCriticalPathPreFirstTokenResponse != NULL, 0, EchoTraffic1.SydneyLLMCriticalPathPreFirstTokenResponse) AS Shadow_LLMCriticalPathFirstTokenResponse,
            IF(EchoTraffic1.SydneyLLMCriticalPathPreFirstTokenResponse == NULL || EchoTraffic2.SydneyLLMCriticalPathPreFirstTokenResponse == NULL, 1, 0) AS Shadow_LLMCriticalPathFirstTokenResponse_NullFlag,
            IF(EchoTraffic1.SydneyLLMCriticalPathPreFirstTokenResponseModel != NULL, 0, EchoTraffic1.SydneyLLMCriticalPathPreFirstTokenResponseModel) AS Shadow_SydneyLLMCriticalPathPreFirstTokenResponseModel,
            IF(EchoTraffic1.SydneyLLMCriticalPathPreFirstTokenResponseModel == NULL || EchoTraffic2.SydneyLLMCriticalPathPreFirstTokenResponseModel == NULL, 1, 0) AS Shadow_SydneyLLMCriticalPathPreFirstTokenResponseModel_NullFlag,
            IF(EchoTraffic1.LLMInputToken != NULL, 0, EchoTraffic1.LLMInputToken) AS Shadow_LLMInputToken,
            IF(EchoTraffic1.LLMInputToken == NULL || EchoTraffic2.LLMInputToken == NULL, 1, 0) AS Shadow_LLMInputToken_NullFlag,
            IF(EchoTraffic1.LLMInputTokenInvokingFunction != NULL, 0, EchoTraffic1.LLMInputTokenInvokingFunction) AS Shadow_LLMInputTokenInvokingFunction,
            IF(EchoTraffic1.LLMInputTokenInvokingFunction == NULL || EchoTraffic2.LLMInputTokenInvokingFunction == NULL, 1, 0) AS Shadow_LLMInputTokenInvokingFunction_NullFlag,
            IF(EchoTraffic1.LLMInputTokenResponding != NULL, 0, EchoTraffic1.LLMInputTokenResponding) AS Shadow_LLMInputTokenResponding,
            IF(EchoTraffic1.LLMInputTokenResponding == NULL || EchoTraffic2.LLMInputTokenResponding == NULL, 1, 0) AS Shadow_LLMInputTokenResponding_NullFlag,
            IF(EchoTraffic1.LLMInputTokenInvokingFunction_Responding != NULL, 0, EchoTraffic1.LLMInputTokenInvokingFunction_Responding) AS Shadow_LLMInputTokenInvokingFunction_Responding,
            IF(EchoTraffic1.LLMInputTokenInvokingFunction_Responding == NULL || EchoTraffic2.LLMInputTokenInvokingFunction_Responding == NULL, 1, 0) AS Shadow_LLMInputTokenInvokingFunction_Responding_NullFlag,
            true AS Shadow_IsValidPair      
       FROM EchoTraffic1 INNER JOIN EchoTraffic2
        ON EchoTraffic1.EchoCorrelationId == EchoTraffic2.EchoCorrelationId;

    EchoTraffic21 = SELECT EchoTraffic2.*.Except(EchoCorrelationId,IsEchoTraffic),
            EchoTraffic2.IsEchoTraffic,
            // PAIRED COLUMNS
            (string.IsNullOrEmpty(EchoTraffic1.NoApologyDetectedState) || string.IsNullOrEmpty(EchoTraffic2.NoApologyDetectedState)) ? (double?)null :  (EchoTraffic2.NoApologyDetectedState.ToLower() == "pass" ? 1 : 0) - (EchoTraffic1.NoApologyDetectedState.ToLower() == "pass" ? 1 : 0) AS Shadow_E2ENRR,
            (string.IsNullOrEmpty(EchoTraffic1.AvailabilityState) || string.IsNullOrEmpty(EchoTraffic2.AvailabilityState)) ? (double?)null :  (EchoTraffic2.AvailabilityState.ToLower() == "pass" ? 1 : 0) - (EchoTraffic1.AvailabilityState.ToLower() == "pass" ? 1 : 0) AS Shadow_Availability,
            (EchoTraffic1.SydneyFCFR_R9 == null || EchoTraffic2.SydneyFCFR_R9 == null || EchoTraffic1.SydneyFCFR_R9 == EchoTraffic2.SydneyFCFR_R9) ? (double?)null :  EchoTraffic2.SydneyFCFR_R9 - EchoTraffic1.SydneyFCFR_R9  AS Shadow_ChatFCFRExcludesSameValueBetweenProdAndEcho,
            IF(EchoTraffic2.SydneyFCFR_R9 != NULL, EchoTraffic2.SydneyFCFR_R9 - EchoTraffic1.SydneyFCFR_R9, NULL) AS Shadow_SydneyFCFR,
            IF(EchoTraffic1.SydneyFCFR_R9 == NULL || EchoTraffic2.SydneyFCFR_R9 == NULL, 1, 0) AS Shadow_SydneyFCFR_NullFlag,            
            IF(EchoTraffic2.ChatFCFR_R9 != NULL, EchoTraffic2.ChatFCFR_R9 - EchoTraffic1.ChatFCFR_R9, NULL) AS Shadow_ChatFCFR,
            IF(EchoTraffic1.ChatFCFR_R9 == NULL || EchoTraffic2.ChatFCFR_R9 == NULL, 1, 0) AS Shadow_ChatFCFR_NullFlag,
            IF(EchoTraffic2.LLMReason != NULL, EchoTraffic2.LLMReason - EchoTraffic1.LLMReason, NULL) AS Shadow_LLMReason,
            IF(EchoTraffic1.LLMReason == NULL || EchoTraffic2.LLMReason == NULL, 1, 0) AS Shadow_LLMReason_NullFlag,
            IF(EchoTraffic2.LLMReasonResponse != NULL, EchoTraffic2.LLMReasonResponse - EchoTraffic1.LLMReasonResponse, NULL) AS Shadow_LLMReasonResponse,
            IF(EchoTraffic1.LLMReasonResponse == NULL || EchoTraffic2.LLMReasonResponse == NULL, 1, 0) AS Shadow_LLMReasonResponse_NullFlag,
            IF(EchoTraffic2.LLMReasonUserQuery != NULL, EchoTraffic2.LLMReasonUserQuery - EchoTraffic1.LLMReasonUserQuery, NULL) AS Shadow_LLMReasonUserQuery,  
            IF(EchoTraffic1.LLMReasonUserQuery == NULL || EchoTraffic2.LLMReasonUserQuery == NULL, 1, 0) AS Shadow_LLMReasonUserQuery_NullFlag,
            IF(EchoTraffic2.LLMResponse_FirstToken != NULL, EchoTraffic2.LLMResponse_FirstToken - EchoTraffic1.LLMResponse_FirstToken, NULL) AS Shadow_LLMResponse_FirstToken,
            IF(EchoTraffic1.LLMResponse_FirstToken == NULL || EchoTraffic2.LLMResponse_FirstToken == NULL, 1, 0) AS Shadow_LLMResponse_FirstToken_NullFlag,
            IF(EchoTraffic2.ChatLCFR_R9 != NULL, EchoTraffic2.ChatLCFR_R9 - EchoTraffic1.ChatLCFR_R9, NULL) AS Shadow_ChatLCFR,
            IF(EchoTraffic1.ChatLCFR_R9 == NULL || EchoTraffic2.ChatLCFR_R9 == NULL, 1, 0) AS Shadow_ChatLCFR_NullFlag,
            IF(EchoTraffic2.sssQueryAPI != NULL, EchoTraffic2.sssQueryAPI - EchoTraffic1.sssQueryAPI, NULL) AS Shadow_sssQueryAPI,
            IF(EchoTraffic1.sssQueryAPI == NULL || EchoTraffic2.sssQueryAPI == NULL, 1, 0) AS Shadow_sssQueryAPI_NullFlag,
            IF(EchoTraffic2.SydneyLLMFirstTokenLatency != NULL, EchoTraffic2.SydneyLLMFirstTokenLatency - EchoTraffic1.SydneyLLMFirstTokenLatency, NULL) AS Shadow_SydneyLLMFirstTokenLatency,
            IF(EchoTraffic1.SydneyLLMFirstTokenLatency == NULL || EchoTraffic2.SydneyLLMFirstTokenLatency == NULL, 1, 0) AS Shadow_SydneyLLMFirstTokenLatency_NullFlag,
            IF(EchoTraffic2.SydneyLLMFirstTokenPreFirstTokenResponseModel != NULL, EchoTraffic2.SydneyLLMFirstTokenPreFirstTokenResponseModel - EchoTraffic1.SydneyLLMFirstTokenPreFirstTokenResponseModel, NULL) AS Shadow_SydneyLLMFirstTokenPreFirstTokenResponseModel,
            IF(EchoTraffic1.SydneyLLMFirstTokenPreFirstTokenResponseModel == NULL || EchoTraffic2.SydneyLLMFirstTokenPreFirstTokenResponseModel == NULL, 1, 0) AS Shadow_SydneyLLMFirstTokenPreFirstTokenResponseModel_NullFlag,
            IF(EchoTraffic2.SydneyLLMFirstTokenPreFirstTokenResponse != NULL, EchoTraffic2.SydneyLLMFirstTokenPreFirstTokenResponse - EchoTraffic1.SydneyLLMFirstTokenPreFirstTokenResponse, NULL) AS Shadow_SydneyLLMFirstTokenPreFirstTokenResponse,
            IF(EchoTraffic1.SydneyLLMFirstTokenPreFirstTokenResponse == NULL || EchoTraffic2.SydneyLLMFirstTokenPreFirstTokenResponse == NULL, 1, 0) AS Shadow_SydneyLLMFirstTokenPreFirstTokenResponse_NullFlag,
            IF(EchoTraffic2.SydneyLLMCriticalPathPreFirstTokenResponse != NULL, EchoTraffic2.SydneyLLMCriticalPathPreFirstTokenResponse - EchoTraffic1.SydneyLLMCriticalPathPreFirstTokenResponse, NULL) AS Shadow_LLMCriticalPathFirstTokenResponse,
            IF(EchoTraffic1.SydneyLLMCriticalPathPreFirstTokenResponse == NULL || EchoTraffic2.SydneyLLMCriticalPathPreFirstTokenResponse == NULL, 1, 0) AS Shadow_LLMCriticalPathFirstTokenResponse_NullFlag,
            IF(EchoTraffic2.SydneyLLMCriticalPathPreFirstTokenResponseModel != NULL, EchoTraffic2.SydneyLLMCriticalPathPreFirstTokenResponseModel - EchoTraffic1.SydneyLLMCriticalPathPreFirstTokenResponseModel, NULL) AS Shadow_SydneyLLMCriticalPathPreFirstTokenResponseModel,
            IF(EchoTraffic1.SydneyLLMCriticalPathPreFirstTokenResponseModel == NULL || EchoTraffic2.SydneyLLMCriticalPathPreFirstTokenResponseModel == NULL, 1, 0) AS Shadow_SydneyLLMCriticalPathPreFirstTokenResponseModel_NullFlag,
            IF(EchoTraffic2.LLMInputToken != NULL, EchoTraffic2.LLMInputToken - EchoTraffic1.LLMInputToken, NULL) AS Shadow_LLMInputToken,
            IF(EchoTraffic1.LLMInputToken == NULL || EchoTraffic2.LLMInputToken == NULL, 1, 0) AS Shadow_LLMInputToken_NullFlag,
            IF(EchoTraffic2.LLMInputTokenInvokingFunction != NULL, EchoTraffic2.LLMInputTokenInvokingFunction - EchoTraffic1.LLMInputTokenInvokingFunction, NULL) AS Shadow_LLMInputTokenInvokingFunction,
            IF(EchoTraffic1.LLMInputTokenInvokingFunction == NULL || EchoTraffic2.LLMInputTokenInvokingFunction == NULL, 1, 0) AS Shadow_LLMInputTokenInvokingFunction_NullFlag,
            IF(EchoTraffic2.LLMInputTokenResponding != NULL, EchoTraffic2.LLMInputTokenResponding - EchoTraffic1.LLMInputTokenResponding, NULL) AS Shadow_LLMInputTokenResponding,
            IF(EchoTraffic1.LLMInputTokenResponding == NULL || EchoTraffic2.LLMInputTokenResponding == NULL, 1, 0) AS Shadow_LLMInputTokenResponding_NullFlag,
            IF(EchoTraffic2.LLMInputTokenInvokingFunction_Responding != NULL, EchoTraffic2.LLMInputTokenInvokingFunction_Responding - EchoTraffic1.LLMInputTokenInvokingFunction_Responding, NULL) AS Shadow_LLMInputTokenInvokingFunction_Responding,
            IF(EchoTraffic1.LLMInputTokenInvokingFunction_Responding == NULL || EchoTraffic2.LLMInputTokenInvokingFunction_Responding == NULL, 1, 0) AS Shadow_LLMInputTokenInvokingFunction_Responding_NullFlag,
            true AS Shadow_IsValidPair      
       FROM EchoTraffic2 INNER JOIN EchoTraffic1
        ON EchoTraffic1.EchoCorrelationId == EchoTraffic2.EchoCorrelationId;

    data = SELECT * FROM EchoTraffic12 UNION ALL SELECT * FROM EchoTraffic21;

    // Restore the Scope map after the echo DISTINCT and join operations are complete.
    data =
        SELECT *.Except(ReflectionMetricsStringMapJson),
               string.IsNullOrEmpty(ReflectionMetricsStringMapJson)
                   ? (Microsoft.SCOPE.Types.ScopeMap<string, string>)null
                   : Newtonsoft.Json.JsonConvert.DeserializeObject<Microsoft.SCOPE.Types.ScopeMap<string, string>>(ReflectionMetricsStringMapJson)
                   AS ReflectionMetricsStringMap,
                (ARRAY<STRUCT<Timestamp: DateTime?, Id:string, LLMModel: string, HttpStatus:string, Latency: double?, TokensCount: STRUCT<CallTag:string, InputTokenType:string, InputTokensCount:long?, OutputTokensCount:long?, CachedTokensCount:long?, ReasoningTokensCount:long?>, LLMModelName: string, ModelClassification: string, SwitcherModelOutput: string, ResolvedModelName: string, LowValueContentMetrics: STRUCT<lowValueContentCharLength:long?, toolsCharLength:long?, totalCharLength:long?, ImagePlaceholderRule:STRUCT<occurrenceCount:long?, totalCharLengthDetected:long?>, DuplicateText:STRUCT<occurrenceCount:long?, totalCharLengthDetected:long?>, SharingHistoryNoise:STRUCT<occurrenceCount:long?, totalCharLengthDetected:long?>, LargeOpaqueUid:STRUCT<occurrenceCount:long?, totalCharLengthDetected:long?>, AllZeroGuid:STRUCT<occurrenceCount:long?, totalCharLengthDetected:long?>, ExcessivePunctuation:STRUCT<occurrenceCount:long?, totalCharLengthDetected:long?>, ExcessiveWhitespace:STRUCT<occurrenceCount:long?, totalCharLengthDetected:long?>>, CacheabilityMetrics: STRUCT<OverallCharSize:long?, StaticPromptCharSize:long?, ToolDefinitionSize:long?, ToolGuidanceSize:long?, InnerMonologueSize:long?>, HttpStatusCode: int?, LlmScenarioId: string, LlmApiType: string, PromptSections: ARRAY<STRUCT<Role:string, Name:string, LengthInChars:int?, SectionKind:string>> >>) MyReaderHelper.FromLLMRequestsStringToStructArray(LLMRequests) AS LLMRequestsArray
        FROM data;
 
    // Set UserId and ConversationId == CorrelationId in order to have correct p-value compute in xcard
    data = SELECT *.Except(ObjectId, BotConversationId),
                  CorrelationId AS ObjectId,
                  CorrelationId AS BotConversationId
                  FROM data;

    // Set correct schema
    data = SELECT 
    TIMESTAMP, 
    DeployRing,
    Region,
    // TraceId,
    CorrelationId,
    TurnLevelCorrelationId,
    TurnId,
    // MessageId AS MessageId,
    Origin, 
    BotRequestId,
    BotConversationId,
    TotalNumUserMessages, 
    // Source,
    Market,
    Locale,
    NumSuggestedResponses,
    // Offense,
    CosmicPartition,
    TenantId,
    ObjectId,
    ClientSessionId,
    ExperienceType,
    QueryAnnotationTypes,
    // ExperienceTypeServer,
    AppName, 
    Product,
    Scenario,
    // UsedReferences,
    BotUsedReferences,
    IsEchoTraffic,
    SourceBranch,
	ClientPlatform,
	ClientRegion,
	UsedEntityAnnotations,
    IsDisengaged,
    ChatFSR,
    ChatFSR_R9,
    ChatFCFR,
    ChatFCFR_R9,
    ChatLCFR,
    ChatLCFR_R9,
    LLMReason,
    LLMReasonResponse,
    LLMReasonUserQuery,
    LLMResponse_FirstToken,
    sssQueryAPI,
    sssQueryAPI_R9,
    sss_EmailsSearchLatency_Iter1,
    sss_EmailsSearchLatency_Iter2,
    sss_EmailsSearchLatency_AllIter,
    sss_FilesSearchLatency_Iter1,
    sss_FilesSearchLatency_Iter2,
    sss_FilesSearchLatency_AllIter,
    sss_ChatSearchLatency_Iter1,
    sss_ChatSearchLatency_Iter2,
    sss_ChatSearchLatency_AllIter,
    sss_MeetingsSearchLatency_Iter1,
    sss_MeetingsSearchLatency_Iter2,
    sss_MeetingsSearchLatency_AllIter,
    sss_PeopleSearchLatency_Iter1,
    sss_PeopleSearchLatency_Iter2,
    sss_PeopleSearchLatency_AllIter,
    sss_Personal_FilesSearchLatency_Iter1,
    sss_Personal_FilesSearchLatency_Iter2,
    sss_Personal_FilesSearchLatency_AllIter,
    // sss_TeamsSearchLatency_Iter1,
    // sss_TeamsSearchLatency_Iter2,
    // sss_TeamsSearchLatency_AllIter,
    // sss_CalendarSearchLatency_Iter1,
    // sss_CalendarSearchLatency_Iter2,
    // sss_CalendarSearchLatency_AllIter,
    SSS_EmailContent_Iter1,
    SSS_EmailContent_Iter2,
    SSS_EmailContent_AllIter,
    SSS_ExternalContent_Iter1,
    SSS_ExternalContent_Iter2,
    SSS_ExternalContent_AllIter,
    SSS_FileContent_Iter1,
    SSS_FileContent_Iter2,
    SSS_FileContent_AllIter,
    SSS_EventContent_Iter1,
    SSS_EventContent_Iter2,
    SSS_EventContent_AllIter,
    SSS_GraphConnector_Iter1,
    SSS_GraphConnector_Iter2,
    SSS_GraphConnector_AllIter,
    sss_SlowestSearchProviderLatency_Iter1,
    sss_SlowestSearchProviderLatency_Iter2,
    sss_SlowestSearchProviderLatency_AllIter,
    sss_SlowestSearchProviderName_Iter1,
    sss_SlowestSearchProviderName_Iter2,
	// ChatFTR,
	SydAmlReasoningTotal,
	SydAmlReasoningTotal_UserQuery,
	SydAmlRespondingFirstToken,
	SydAmlReasoningTotal_ResponseReady,
    E2ENRRState,
	NoApologyDetectedState,
	SydneyFCFR,
    SydneyFCFR_R9,
    AvailabilityState,
    AppFlavor,
    CitationCount,
    UtteranceLength,
    OrchestratorIterationCount,
    SubstrateSearchReducedResultsMessages,
    ToolExecutionFlow,
    // SkillOrderInvocation,
    WebEnabled,
    EchoExperiment,
    // SSSTransactionIdsLoggedBySydney AS SubstrateSearchTransactionIdsLoggedBySydney,
    SubstrateSearchRestrictedSearchMode,
    // SubstrateSearchRequestInfo,
    sssEmptyResultRequests,
    sssEmptyResultSuccessfulRequests,
    sssTotalRequests,
    sssTotalSuccessfulRequests,
    sssTotalIterations,
    sssTotalResultsCount,
    isSearchTriggered,
    NudgeTriggered, 
    TurnLevelResponseActionsString, 
    TurnLevelSystemActionsString,
    // ConversationLevelResponseActionsString,
    // ConversationLevelSystemActionsString,
    LLMAPITokensCountList,
	QuerySubmitProperties,	
    ServerSessionId,
    ComputedServerSessionId,
	SecondsToNextTurn,
	SessionDurationInSeconds,
	StartTimeOfNextSession,
	SessionTurnSequenceNumber,
	SessionTotalTurnCount,
    CopilotProduct,
    CopilotExtensionIds,
    CopilotExtensionState,
    LanguageMismatchType,
    IsUpiaUserMessageTriggered,
    IsXpiaToolOutputTriggered,
    IsCopyrightViolationTriggered,
    IsUserMessageBlockListTriggered,
    IsBotResponseBlockListTriggered,
    SearchStrategyClassification,
    ClientAppVersion,
    IsWorkSearchEnabled,
    CIQEntityTypesWithMetadata,
    IsBotOffensiveClassifierTriggered,
    CounterfactualLogging,
    ReportLengthControl,
    PreProcessedExecutionControls,
    FileSizeCategory,
    FileHasImage,
    RealtimeTurnResult,
    FeedbackThumbsClicks,
    ClientPreferences,
    RealtimeTurnPlaybackInterruption,
    OfficeCopilot,
    RAIClassifiersTriggered,
    AgentExtendedDataArray,
    Apis,
    IsDegradedResponse,
    DataverseRequests,
    SpawnedTaskIds,
    VisualInsightsData,
    DatasetCategory,
    BackgroundTaskData,
    TaskId,
    LLMGroundingEntities,
    ReflectionMetricsStringMap,
    ImageSourceBreakdown,
    EditableBlockGenerated,
    MessageStreamingMetricsExecutionEvent,
    SkillsInfo,
    ShoppingBerryForwardedProductCount,
    CuaPluginInfo,
    LLMRequestsArray,

    // Feedback Data
    CopilotFeedbackData_FeedbackActionList,
    
    // Score data
    citedcg_avg_cited_label, 
    citedcg_sum_cited_label, 
    citedcg_num_bad_cites, 
    citedcg_num_good_cites, 
    citedcg_num_enterprise_cites, 
    citedcg_gcc, 
    citedcg_one_centric, 
    citedcg_max_label, 
    citedcg_all_bad_cites, 
    citedcg_has_good_cite, 
    citedcg_all_bad_cites_v2, 
    citedcg_has_good_cite_v2, 
    chatsat_overall_sat,
    chatsat_overall_dsat,
    chatsat_intent_primary,
    chatsat_intent_secondary,
    chatsat_intent_confidence,
    chatsat_sentiment_score,
    chatsat_sentiment_confidence,
    chatsat_signal_inferred_score,
    chatsat_signal_inferred_confidence,
    chatsat_signal_inferred_sat,
    chatsat_signal_inferred_dsat,
    chatsat_signal_insights,
    chatsat_signal_detected_scenario,
    chatsat_signal_inferred_score_vnext,
    chatsat_signal_inferred_confidence_vnext,
    chatsat_signal_inferred_sat_vnext,
    chatsat_signal_inferred_dsat_vnext,
    chatsat_signal_insights_vnext,
    chatsat_signal_detected_scenario_vnext,
    chatsat_tc_relevance_score,
    chatsat_tc_relevance_confidence,
    chatsat_tc_contextual_score,
    chatsat_tc_contextual_confidence,
    chatsat_tc_completeness_score,
    chatsat_tc_completeness_confidence,
    chatsat_response_quality_score,
    chatsat_response_quality_confidence,
    chatsat_session_inferred_score,
    chatsat_session_inferred_success,
    chatsat_session_inferred_failure,
    chatsat_session_insights,
    chatsat_session_data_source,
    SSR_OfficeRegion,
    ChatSATS_OfficeRegion,
    ChatSAT_OfficeRegion,
    UtteranceGroup,
    UtteranceScenario,
    UtteranceIntent,
    IDEAs_IsSatisfied,
    IDEAs_IsDissatisfied,     

    ShadowTriggerFlights,
    ShadowOverrideFlights,
    FluxVersion,
    OrchestratorName,
    DeclaritiveCopilotExtendedData,
    MessageAuthor,
    MessageType,
    FromHistory,
    TurnType,
    OptionVariantsSet,
    RequestPerfSegments,
    (int?)null AS FluxLoopCount,
    (int?)null AS ToolTriggerCount,
    (int?)null AS ChatFirstTokenRenderedUnaccounted,
    (int?)null AS SydneyFirstTokenResponseModelToFirstTokenResponse,
    (int?)null AS SydneyFirstTokenResponseToLastTokenResponse,
    SydneyLLMFirstTokenLatency,
    SydneyLLMFirstTokenPreFirstTokenResponseModel,
    SydneyLLMFirstTokenPreFirstTokenResponse,
    (int?)null AS SydneyLLMFirstTokenPostFirstTokenResponse,
    (int?)null AS SydneyLLMFirstVisibleToken,
    (int?)null AS SydneyLLMFirstVisibleTokenPreFirstTokenResponseModel,
    (int?)null AS SydneyLLMFirstVisibleTokenPreFirstTokenResponse,
    (int?)null AS SydneyLLMFirstVisibleTokenPostFirstTokenResponse,
    SydneyLLMCriticalPathPreFirstTokenResponseModel,
    SydneyLLMCriticalPathPreFirstTokenResponseModel_R9,
    SydneyLLMCriticalPathPreFirstTokenResponse,
    (int?)null AS SydneyLLMCriticalPathPostFirstTokenResponse,
    (int?)null AS SydneyLLMRespondingTokenStream,
    (int?)null AS SydneyLLMRespondingTokenStreamPreFirstTokenResponseModel,
    (int?)null AS SydneyLLMRespondingTokenStreamPreFirstTokenResponse,
    (int?)null AS SydneyLLMRespondingTokenStreamPostFirstTokenResponse,
    (int?)null AS SydneyLLMToolInvocationTokenStream,
    (int?)null AS SydneyLLMToolInvocationTokenStreamPreFirstTokenResponseModel,
